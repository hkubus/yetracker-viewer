# yetracker-viewer configuration. For development: `cp .env.example .env` in the repo root.
# The API loads the repo-root .env itself; the web scripts load it with `node --env-file-if-exists`. Variables set in
# the real environment win over this file. Unset or blank values mean the default (shown on the commented lines).
# Booleans accept true/false, 1/0, yes/no, on/off. An invalid value stops the process at startup, naming the variable.
# Relative paths resolve from the repo root. MB = 1,048,576 bytes. Keep comments on their own lines.

# --- API: server ----------------------------------------------------------------------------------------------------

# Bind address and port (defaults 127.0.0.1:3000). HOST/PORT are generic fallbacks that the web server reads too, so
# prefer the API_*/WEB_* names.
API_HOST=127.0.0.1
API_PORT=3000

# Browser origins allowed to call the API cross-origin: comma-separated exact origins (scheme://host[:port], no path),
# or * for any. An explicitly empty value allows none. Not needed when the site reaches the API same-origin (/api).
# Default: http://localhost:4321,http://127.0.0.1:4321.
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Open client connections (1–65536). Default: min(1024, (open-file limit - 128) / 3), at least 1: a streamed file
# holds two descriptors (socket + file), plus one spare per connection and 128 for the process itself (at startup the
# API raises its soft open-file limit to the hard limit and logs both). At the limit a new connection replaces the one
# idle the longest (no request in flight) or else one whose client has read nothing for 10 s or more; it is refused
# only when every connection is busy (logged at most every 10 s, with a count). A client that reads nothing for 60 s
# loses its connection. Per-IP limits belong in the reverse proxy.
# MAX_CONNECTIONS=1024

# Slots for expensive song queries (1–64): text searches (`q` on /songs and /eras/:id/songs) and song pages with
# limit > 100. Such a request waits up to 10 s for a slot, then answers 503; filter-only requests and smaller pages
# never wait (default 4).
# SEARCH_CONCURRENCY=4

# Log filter in tracing's EnvFilter syntax, e.g. warn or yetracker_api=debug,info (default: info). Logs go to stdout.
# RUST_LOG=info

# --- API: storage ---------------------------------------------------------------------------------------------------

# SQLite database, covers/, transcodes/ and (unless SONGS_DIR is set) songs/. Use an absolute path in production
# (default: storage in the repo root).
STORAGE_DIR=./storage

# Downloaded song media (default: <STORAGE_DIR>/songs). A directory outside STORAGE_DIR is never created by the API (it
# may be an unmounted volume): while it is missing, songs are unplayable and downloads are skipped.
# SONGS_DIR=/srv/yetracker/songs

# --- API: catalog sync ----------------------------------------------------------------------------------------------

# Run a sync (import, covers, downloads, duration backfill, cleanup) right after boot, in the background: the API
# serves the stored catalog meanwhile (default true). With false the first sync starts SYNC_INTERVAL_MINUTES after
# boot (never, when that is 0).
SYNC_ON_START=true

# Minutes from the end of one sync to the start of the next (0–525600; 0 disables periodic syncs; default 30).
SYNC_INTERVAL_MINUTES=30

# Import this saved sheet HTML instead of fetching yetracker.net (offline development, tests, CI). The file must exist
# at startup. A trimmed real sheet ships as apps/api-rs/tests/fixtures/sheet.html.
# CATALOG_SHEET_FILE=apps/api-rs/tests/fixtures/sheet.html

# Accept an import the sanity guards refuse as a broken sheet — fewer than 80% of the stored songs, fewer than 80% of
# the stored downloadable links, or song rows naming a stored era that has no era row any more — and rewrite the
# catalog even when it is unchanged. Meant for one sync: unset it again afterwards (default false).
# IMPORT_FORCE=false

# --- API: downloads -------------------------------------------------------------------------------------------------

# Master switch for background downloads of song media AND era covers (default true). Media already on disk is still
# linked to its songs while it is off; songs waiting for a download stay "pending".
DOWNLOADS_ENABLED=true

# Download YouTube links with yt-dlp (default true). When false, YouTube songs without a file report downloadState
# "unsupported". Instagram and X links are not affected.
YOUTUBE_DOWNLOAD=true

# Download attempts per sync (0–1000000; 0 = unlimited; default 200). Together with DOWNLOAD_TIME_BUDGET_MINUTES it
# keeps a big backlog (the catalog links about 6,000 downloadable files, many GB) from holding up the next import: the
# mirror fills up over successive syncs. This example caps it for development; delete the line in production.
MAX_DOWNLOADS_PER_CYCLE=10

# How long one sync keeps starting downloads (0–1440 minutes; 0 = no limit; default 20). Downloads still running then
# get 5 more minutes; after that they are stopped and retried by a later sync.
# DOWNLOAD_TIME_BUDGET_MINUTES=20

# Parallel song downloads (1–32).
# DOWNLOAD_CONCURRENCY=3

# Largest accepted download (1–1048576 MB); bigger files are aborted and retried later.
# MAX_DOWNLOAD_MB=1024

# Free space the songs filesystem must keep, checked before each download (0–1048576 MB; 0 disables the check). A
# download that fills the disk anyway doesn't count as an attempt and ends that sync's downloads.
# MIN_FREE_DISK_MB=1024

# --- API: media processing ------------------------------------------------------------------------------------------

# Simultaneous ffmpeg transcodes for /songs/:id/stream?quality= (1–100; default: the number of CPUs, at least 2).
# MAX_CONCURRENT_TRANSCODES=

# Size budget of the transcode cache in <STORAGE_DIR>/transcodes (0–1048576 MB); least recently used transcodes are
# deleted first; 0 keeps none.
# TRANSCODE_CACHE_MAX_MB=2048

# Parallel ffprobe runs of the duration backfill (1–64).
# BACKFILL_CONCURRENCY=8

# --- Web (apps/web) -------------------------------------------------------------------------------------------------
# Read at runtime (nothing is baked into the build). `node server.mjs` / `pnpm start:web` validates everything before
# it starts and exits listing every problem; `pnpm dev` uses the development fallbacks below.

# Bind address and port (defaults 127.0.0.1:4321; fall back to HOST/PORT). Blank values count as unset, for `pnpm dev`
# too; an invalid port stops the server and every astro command.
WEB_HOST=127.0.0.1
WEB_PORT=4321

# API base URL used by browsers: an absolute http(s) URL, or a same-origin path such as /api that the reverse proxy
# forwards to the API with the prefix stripped. Required in production; development fallback http://localhost:3000.
PUBLIC_API_URL=http://localhost:3000

# Absolute API URL used for server-side rendering. May be omitted when PUBLIC_API_URL is absolute (it is reused).
# Required in production otherwise; development fallback http://127.0.0.1:3000.
API_INTERNAL_URL=http://127.0.0.1:3000

# Public origin of the site (https://example.com, no path). Optional, but set it in production: only then do pages get
# canonical and og:url links. Without it robots.txt, sitemap.xml and Open Graph image URLs use the request's origin
# (Host, or the trusted proxy headers) and are sent with Cache-Control: private. `node server.mjs` logs a warning when
# it is unset or points at this machine (localhost, 127.x). Its scheme does not turn on HSTS (see TRUST_PROXY).
# SITE_URL=https://example.com

# Trust X-Forwarded-Proto and X-Forwarded-Host from the reverse proxy (default false). Enable it only behind a proxy
# that sets or overwrites them. HSTS and upgrade-insecure-requests are sent for requests that arrived over HTTPS: a
# TLS connection to `node server.mjs`, or X-Forwarded-Proto: https from a trusted proxy. While SITE_URL is unset the
# forwarded scheme and host also make up the public origin.
# TRUST_PROXY=false

# Serve HTTPS directly from `node server.mjs` (set both or neither). Normally TLS ends at the reverse proxy.
# SERVER_CERT_PATH=/etc/yetracker/tls/fullchain.pem
# SERVER_KEY_PATH=/etc/yetracker/tls/privkey.pem
