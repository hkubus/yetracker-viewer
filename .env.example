STORAGE_DIR=./storage
# Optional separate location for downloaded song media. Relative paths resolve from the workspace root.
# SONGS_DIR=/srv/yetracker/songs

# API bind address and port. Use 0.0.0.0 when running in a container.
API_HOST=127.0.0.1
API_PORT=3000

# Exact browser origins allowed to call the API, separated by commas.
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Disable this after initial catalog/media setup to avoid network work at startup.
SYNC_ON_START=true

# Bound CPU-intensive on-demand ffmpeg work.
MAX_CONCURRENT_TRANSCODES=2

# Web server bind address and port.
WEB_HOST=127.0.0.1
WEB_PORT=4321

# Browser-visible API URL. This may be a relative reverse-proxy path such as /api.
PUBLIC_API_URL=http://localhost:3000

# Absolute URL used by the web SSR process to reach the API.
API_INTERNAL_URL=http://127.0.0.1:3000
