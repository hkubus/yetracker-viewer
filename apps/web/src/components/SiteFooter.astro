---
/** Site-wide footer: where the catalog comes from, and what this site is (and is not). */
---

<footer class="site-footer">
  <p>
    Catalog data from the community-maintained Ye Tracker spreadsheet
    (<a href="https://yetracker.net">yetracker.net</a>).
  </p>
  <p>Unofficial fan-made viewer, not affiliated with Ye or his labels.</p>
</footer>

<style>
  .site-footer {
    display: flex;
    box-sizing: border-box;
    width: 100%;
    max-width: var(--page-max-width);
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    margin: var(--space-7) auto 0;
    padding: var(--space-5) calc(var(--page-gutter) + env(safe-area-inset-right, 0px)) var(--space-6)
      calc(var(--page-gutter) + env(safe-area-inset-left, 0px));
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-normal);
    text-align: center;
  }
  .site-footer p {
    max-width: 40rem;
    margin: 0;
    text-wrap: balance;
  }
  /* Wide screens: one line, source on the left, disclaimer on the right. */
  @media (min-width: 56rem) {
    .site-footer {
      flex-direction: row;
      justify-content: space-between;
      gap: var(--space-5);
      text-align: start;
    }
    .site-footer p:last-child {
      text-align: end;
    }
  }
  .site-footer a {
    border-radius: var(--radius-xs);
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-decoration-color: var(--color-border-control);
    text-underline-offset: 0.2em;
    transition:
      color var(--duration-fast) var(--ease-standard),
      text-decoration-color var(--duration-fast) var(--ease-standard);
  }
  @media (hover: hover) {
    .site-footer a:hover {
      color: var(--color-text);
      text-decoration-color: currentColor;
    }
  }
  .site-footer a:active {
    color: var(--color-text);
  }
</style>
