---
import type { Category } from '@yetracker/types';

const category = Astro.props.category as Category;
const songsCount = typeof category.songsCount === 'number' ? category.songsCount : 0;
---

<a class="category-card" href={`/categories/${category.id}`}>
  <div class="category-card__copy">
    <p class="category-card__eyebrow">Yetracker sheet</p>
    <h3>{category.name}</h3>
    <p class="category-card__description">{category.description}</p>
  </div>
  <p class="category-card__count">
    {songsCount.toLocaleString()} {songsCount === 1 ? 'song' : 'songs'}
    <span aria-hidden="true">→</span>
  </p>
</a>

<style>
  .category-card {
    display: flex;
    min-height: 10rem;
    box-sizing: border-box;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem;
    border: 2px solid #363636;
    border-radius: 0.85rem;
    color: #ededed;
    background: linear-gradient(145deg, #262626, #1b1b1b);
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      transform 160ms ease;
  }

  .category-card:hover {
    border-color: #8e8e8e;
    background: linear-gradient(145deg, #303030, #1c1c1c);
    transform: translateY(-0.2rem);
  }

  .category-card:focus-visible {
    border-color: #fff;
    background: linear-gradient(145deg, #303030, #1c1c1c);
    outline: 3px solid #fff;
    outline-offset: 3px;
    transform: translateY(-0.2rem);
  }

  .category-card__eyebrow {
    margin: 0 0 0.35rem;
    color: #9f9f9f;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    font-size: 1.35rem;
  }

  .category-card__description {
    margin: 0.6rem 0 0;
    color: #b9b9b9;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .category-card__count {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    color: #d6d6d6;
    font-size: 0.85rem;
  }

  .category-card__count span {
    color: #fff;
    font-size: 1.2rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .category-card,
    .category-card:hover,
    .category-card:focus-visible {
      transform: none;
      transition: none;
    }
  }
</style>
