---
/**
 * Search across the whole catalog, with an era range and a "playable only" switch. The behaviour lives in
 * `src/scripts/global-search.ts`; this renders the controls pre-filled from the URL (`?q=&eraFrom=&eraTo=&playable=`)
 * and the empty results region the script fills in. On phones the filters fold behind a "Filters" button (open
 * from the start when the URL sets one); without scripting they are always shown.
 */
import { activeFilterCount, parseSearchState, searchMode } from '../utils/globalSearchState';
import { MAX_QUERY_LENGTH } from '../utils/search';
import { countLabel } from '../utils/songRow';
import CoverImage from './CoverImage.astro';
import AlertIcon from './icons/AlertIcon.astro';
import CheckIcon from './icons/CheckIcon.astro';
import ChevronDownIcon from './icons/ChevronDownIcon.astro';
import CloseIcon from './icons/CloseIcon.astro';
import FilterIcon from './icons/FilterIcon.astro';
import PauseIcon from './icons/PauseIcon.astro';
import PlayIcon from './icons/PlayIcon.astro';
import SearchIcon from './icons/SearchIcon.astro';

interface SearchEra {
  id: number;
  name: string;
  dominantColor: string;
  hasCover?: boolean | null;
  coverVersion?: string | null;
}

interface Props {
  /** Main eras in catalog order; the era range is disabled when there are fewer than two. */
  eras: SearchEra[];
  /** Browser-facing API base URL. */
  apiBaseUrl: string;
  /** Songs per era page, to link results to the page that contains them. */
  eraPageSize: number;
}

const { eras, apiBaseUrl, eraPageSize } = Astro.props;
const eraIds = eras.map((era) => era.id);
const state = parseSearchState(Astro.url.searchParams, eraIds);
const lastIndex = Math.max(eras.length - 1, 0);
const showRange = eras.length > 1;
const activeFilters = activeFilterCount(state, eras.length);
// The URL asks for a search (a shared link, a reload): its results area is laid out from the first paint.
const searchPending = eras.length > 0 && searchMode(state, eras.length) === 'search';
const clearable = state.q !== '' || activeFilters > 0;
const fromName = eras[state.from]?.name ?? '';
const toName = eras[state.to]?.name ?? '';
const rangeStatus =
  state.from === 0 && state.to === lastIndex ? 'All eras' : countLabel(state.to - state.from + 1, 'era');
const rangeStyle = showRange
  ? `--range-start: ${(state.from / lastIndex) * 100}%; --range-end: ${(state.to / lastIndex) * 100}%`
  : undefined;
const eraData = eras.map(({ id, name, dominantColor, hasCover, coverVersion }) => ({
  id,
  name,
  dominantColor,
  hasCover: hasCover ?? null,
  coverVersion: coverVersion ?? null,
}));
---

<section
  class="global-search home-section"
  aria-labelledby="global-search-heading"
  data-global-song-search
  data-api-base-url={apiBaseUrl}
  data-era-page-size={eraPageSize}
  data-eras={JSON.stringify(eraData)}
  data-filters-open={activeFilters > 0 ? '' : undefined}
  data-search-pending={searchPending ? '' : undefined}
>
  <form class="global-search__form" role="search" action="/" method="get" autocomplete="off" data-global-search-form>
    <div class="home-section__head global-search__head">
      <h2 class="home-section__title" id="global-search-heading">
        <label for="global-song-search">Find a track</label>
      </h2>
      <button
        type="button"
        class="global-search__toggle"
        aria-expanded={activeFilters > 0 ? 'true' : 'false'}
        aria-controls="global-search-filters"
        data-filters-toggle
      >
        <FilterIcon />
        <span>Filters</span>
        <span class="global-search__badge" data-filters-badge hidden={activeFilters === 0}>
          <span data-filters-count>{activeFilters}</span><span class="sr-only"> active</span>
        </span>
        <ChevronDownIcon class="global-search__chevron" />
      </button>
    </div>

    <div class="global-search__field">
      <SearchIcon />
      <input
        id="global-song-search"
        name="q"
        type="search"
        value={state.q}
        maxlength={MAX_QUERY_LENGTH}
        placeholder="Search songs, artists, notes…"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
        aria-describedby="global-search-hint"
        data-global-search-input
      />
    </div>
    <p class="sr-only" id="global-search-hint">
      Results update as you type. Press Enter to go to the results, and the up and down arrow keys to move between them.
    </p>

    <div
      class="global-search__filters"
      id="global-search-filters"
      role="group"
      aria-label="Search filters"
      data-global-search-filters
    >
      {
        showRange ? (
          <div class="global-search__timeline" role="group" aria-labelledby="global-search-range-label">
            <div class="global-search__timeline-heading">
              <span class="global-search__range-label" id="global-search-range-label">
                Era range
              </span>
              <span class="global-search__range-status" data-era-range-status>
                {rangeStatus}
              </span>
            </div>
            <div class="global-search__range" style={rangeStyle} data-era-range>
              <div class="global-search__range-track" aria-hidden="true">
                <span />
              </div>
              <input
                type="range"
                min="0"
                max={lastIndex}
                step="1"
                value={state.from}
                aria-label="Earliest era"
                aria-valuetext={fromName}
                data-era-range-start
              />
              <input
                type="range"
                min="0"
                max={lastIndex}
                step="1"
                value={state.to}
                aria-label="Latest era"
                aria-valuetext={toName}
                data-era-range-end
              />
            </div>
            <div class="global-search__range-names" aria-hidden="true" data-era-range-names>
              <span data-era-start-name>{fromName}</span>
              <span data-era-end-name>{toName}</span>
            </div>
          </div>
        ) : null
      }

      <div class="global-search__switches">
        <label class="global-search__playable">
          <input type="checkbox" name="playable" value="true" checked={state.playable} data-playable-filter />
          <span class="global-search__checkmark" aria-hidden="true">
            <CheckIcon />
          </span>
          <span>Playable only</span>
        </label>
        <button type="button" class="global-search__clear" disabled={!clearable} data-search-clear>
          <CloseIcon />
          <span>Clear<span class="sr-only"> search and filters</span></span>
        </button>
      </div>
    </div>
  </form>

  <section
    class="global-search__results"
    id="global-search-results"
    tabindex="-1"
    aria-labelledby="global-search-results-heading"
    data-global-search-results
    hidden
  >
    <div class="global-search__results-head">
      <h3 class="sr-only" id="global-search-results-heading">Search results</h3>
      <p class="global-search__count" data-global-search-count>{searchPending ? 'Searching…' : null}</p>
    </div>
    <div class="global-search__skeleton" aria-hidden="true" data-global-search-skeleton hidden>
      <span></span><span></span><span></span>
    </div>
    <ul class="global-search__list" role="list" data-global-search-list data-play-scope></ul>
    <div class="global-search__message" data-global-search-message hidden>
      <span class="global-search__message-icon" aria-hidden="true">
        <SearchIcon class="global-search__icon-search" />
        <AlertIcon class="global-search__icon-alert" />
      </span>
      <p class="global-search__message-text" data-global-search-message-text></p>
      <p class="global-search__message-hint" data-global-search-message-hint hidden></p>
      <div class="global-search__message-actions">
        <button type="button" class="global-search__button" data-global-search-retry hidden>Try again</button>
        <button type="button" class="global-search__button" data-global-search-reset-filters hidden>
          Reset filters
        </button>
      </div>
    </div>
    <div class="global-search__more" data-global-search-more hidden>
      <button type="button" class="global-search__button" data-global-search-more-button>Show more</button>
      <p class="global-search__more-progress" data-global-search-more-progress></p>
    </div>
  </section>
  <p class="sr-only" role="status" data-global-search-status></p>
  <template data-global-search-play-icon><PlayIcon class="play-icon" /><PauseIcon class="pause-icon" /></template>
  {/* Cloned for each result's era cover: the copies keep CoverImage's styles (see the client-update notes there). */}
  <template data-global-search-cover>
    <CoverImage eraId={0} eraName="" hasCover={true} size={96} apiBaseUrl={apiBaseUrl} />
  </template>
  <noscript>
    <p class="global-search__noscript">Search needs JavaScript. The eras below work without it.</p>
  </noscript>
</section>

<script>
  import '../scripts/global-search';
</script>

<style>
  @property --range-start-color {
    syntax: '<color>';
    inherits: true;
    initial-value: #cfcfcf;
  }
  @property --range-end-color {
    syntax: '<color>';
    inherits: true;
    initial-value: #cfcfcf;
  }
  .global-search {
    color: var(--color-text);
  }
  .global-search__head {
    justify-content: space-between;
    align-items: center;
  }

  /* The phone-only "Filters" disclosure button (wider screens always show the filters). */
  .global-search__toggle {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    background: var(--color-surface);
    font: inherit;
    font-size: var(--font-size-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }
  .global-search__toggle :global(svg) {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
  }
  .global-search__toggle :global(.global-search__chevron) {
    width: 1rem;
    height: 1rem;
    color: var(--color-text-secondary);
    transition: transform var(--duration-base) var(--ease-standard);
  }
  .global-search__toggle[aria-expanded='true'] {
    border-color: var(--color-border-control);
    background: var(--color-surface-raised);
  }
  .global-search__toggle[aria-expanded='true'] :global(.global-search__chevron) {
    transform: rotate(180deg);
  }
  .global-search__toggle:active {
    background: var(--color-surface-hover);
  }
  @media (hover: hover) {
    .global-search__toggle:hover {
      border-color: var(--color-border-control);
      background: var(--color-surface-hover);
    }
  }
  .global-search__badge {
    display: inline-grid;
    min-width: 1.25rem;
    height: 1.25rem;
    box-sizing: border-box;
    place-items: center;
    padding: 0 0.3rem;
    border-radius: var(--radius-pill);
    color: var(--color-on-accent);
    background: var(--color-accent);
    font-size: var(--font-size-2xs);
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .global-search__badge[hidden] {
    display: none;
  }

  /* The hero: a large field with an always-visible outline (≥ 3:1). */
  .global-search__field {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 3.25rem;
    box-sizing: border-box;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border-control);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }
  @media (hover: hover) {
    .global-search__field:hover {
      border-color: var(--color-text-muted);
    }
  }
  /* The input's own outline is replaced by this equally visible one around the whole field. */
  .global-search__field:focus-within {
    border-color: var(--color-text-secondary);
    background: var(--color-surface-raised);
    outline: 2px solid var(--focus-ring-color);
    outline-offset: 2px;
  }
  .global-search__field :global(svg) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-text-muted);
  }
  .global-search__field input {
    flex: 1;
    min-width: 0;
    box-sizing: border-box;
    padding: var(--space-3) 0;
    border: 0;
    outline: none;
    color: var(--color-text);
    background: transparent;
    font: inherit;
    font-size: var(--font-size-md);
    /* The placeholder is cut short on 320px screens; an ellipsis shows it goes on. */
    text-overflow: ellipsis;
  }
  .global-search__field input::placeholder {
    color: var(--color-text-muted);
    opacity: 1;
  }

  /* Filters: inline under the field on wide screens, a panel behind the "Filters" button on phones. */
  .global-search__filters {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-1) 0;
  }
  .global-search__switches {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  @media (scripting: enabled) and (max-width: 39.99rem) {
    .global-search__toggle {
      display: inline-flex;
    }
    .global-search:not([data-filters-open]) .global-search__filters {
      display: none;
    }
  }
  @media (max-width: 39.99rem) {
    .global-search__filters {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-3) var(--space-4) var(--space-3);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-surface);
    }
  }
  @media (pointer: coarse) {
    .global-search__toggle {
      min-height: var(--tap-size);
    }
  }

  .global-search__timeline {
    --thumb: 1.5rem;
    min-width: 0;
  }
  @media (pointer: coarse) {
    /* A full-size touch target around the same small knob. */
    .global-search__timeline {
      --thumb: var(--tap-size);
    }
  }
  .global-search__timeline-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .global-search__range-label {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }
  .global-search__range-status {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-variant-numeric: tabular-nums;
  }
  .global-search__range {
    --range-start: 0%;
    --range-end: 100%;
    position: relative;
    height: var(--thumb);
    cursor: pointer;
    touch-action: pan-y;
    transition:
      --range-start-color var(--duration-base) ease-out,
      --range-end-color var(--duration-base) ease-out;
  }
  /* The track spans the thumb centres, so percentages line up with the thumbs. */
  .global-search__range-track {
    position: absolute;
    top: calc(50% - 2px);
    right: calc(var(--thumb) / 2);
    left: calc(var(--thumb) / 2);
    height: 4px;
    border-radius: var(--radius-pill);
    background: var(--color-border-control);
  }
  .global-search__range-track span {
    position: absolute;
    top: 0;
    right: calc(100% - var(--range-end));
    bottom: 0;
    left: var(--range-start);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--range-start-color), var(--range-end-color));
    background: linear-gradient(90deg in oklab, var(--range-start-color), var(--range-end-color));
  }
  /* Two overlapping native range inputs: only their thumbs take pointer events; clicks on the track are handled by
     the script (the nearest thumb jumps there). */
  .global-search__range input {
    --thumb-color: var(--range-end-color);
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    appearance: none;
    pointer-events: none;
  }
  .global-search__range input[data-era-range-start] {
    --thumb-color: var(--range-start-color);
  }
  /* When both thumbs sit on the same era, the one that can still move is on top. */
  .global-search__range[data-front='start'] input[data-era-range-start] {
    z-index: 2;
  }
  /* Replaced by the ring on the thumb below. */
  .global-search__range input:focus-visible {
    outline: none;
  }
  .global-search__range input::-webkit-slider-runnable-track {
    height: var(--thumb);
    border: 0;
    background: transparent;
  }
  .global-search__range input::-moz-range-track {
    height: var(--thumb);
    border: 0;
    background: transparent;
  }
  /* The thumb is the whole target (24 px, 44 px on touch screens); the knob drawn in it stays 19 px, and the focus
     ring around it fits inside the smaller target. */
  .global-search__range input::-webkit-slider-thumb {
    width: var(--thumb);
    height: var(--thumb);
    border: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle closest-side,
      var(--thumb-color) 0 5.5px,
      var(--color-surface) 6px 7px,
      #e4e4e4 7.5px 9.5px,
      transparent 10px
    );
    appearance: none;
    cursor: grab;
    pointer-events: auto;
  }
  .global-search__range input::-moz-range-thumb {
    box-sizing: border-box;
    width: var(--thumb);
    height: var(--thumb);
    border: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle closest-side,
      var(--thumb-color) 0 5.5px,
      var(--color-surface) 6px 7px,
      #e4e4e4 7.5px 9.5px,
      transparent 10px
    );
    cursor: grab;
    pointer-events: auto;
  }
  .global-search__range input:active::-webkit-slider-thumb {
    cursor: grabbing;
  }
  .global-search__range input:active::-moz-range-thumb {
    cursor: grabbing;
  }
  .global-search__range input:focus-visible::-webkit-slider-thumb {
    background: radial-gradient(
      circle closest-side,
      var(--thumb-color) 0 5.5px,
      var(--color-surface) 6px 7px,
      #e4e4e4 7.5px 9.5px,
      #000000 10px,
      #ffffff 10.5px 11.5px,
      transparent 12px
    );
  }
  .global-search__range input:focus-visible::-moz-range-thumb {
    background: radial-gradient(
      circle closest-side,
      var(--thumb-color) 0 5.5px,
      var(--color-surface) 6px 7px,
      #e4e4e4 7.5px 9.5px,
      #000000 10px,
      #ffffff 10.5px 11.5px,
      transparent 12px
    );
  }
  .global-search__range-names {
    position: relative;
    height: 1.1rem;
    margin-inline: calc(var(--thumb) / 2);
    color: var(--color-text);
    font-size: var(--font-size-xs);
    font-weight: 600;
    line-height: 1.1rem;
  }
  .global-search__range-names[data-stacked] {
    height: 2.2rem;
  }
  .global-search__range-names span {
    position: absolute;
    top: 0;
    left: 0;
    max-width: min(48%, 16rem);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .global-search__range-names span:last-child {
    left: auto;
    right: 0;
  }
  /* Once the script positions the labels, they use their full width (and stack when they would collide). */
  .global-search__range-names[data-measured] span {
    max-width: 100%;
  }
  .global-search__range-names[data-stacked] span:last-child {
    top: 1.1rem;
  }

  /* "Playable only": a checkbox drawn as a chip. */
  .global-search__playable {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    box-sizing: border-box;
    min-height: 2.25rem;
    padding: 0 var(--space-3) 0 var(--space-2);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    background: var(--color-surface);
    font-size: var(--font-size-sm);
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }
  @media (hover: hover) {
    .global-search__playable:hover {
      border-color: var(--color-border-control);
      background: var(--color-surface-hover);
    }
  }
  .global-search__playable:has(> input:checked) {
    border-color: var(--color-text-secondary);
    background: var(--color-surface-raised);
  }
  .global-search__playable > input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .global-search__checkmark {
    display: grid;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    box-sizing: border-box;
    place-items: center;
    border: 1.5px solid var(--color-border-control);
    border-radius: var(--radius-pill);
    color: var(--color-on-accent);
    background: transparent;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }
  .global-search__checkmark :global(svg) {
    width: 0.8rem;
    height: 0.8rem;
    opacity: 0;
  }
  .global-search__playable > input:checked + .global-search__checkmark {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }
  .global-search__playable > input:checked + .global-search__checkmark :global(svg) {
    opacity: 1;
  }
  .global-search__playable:has(> input:focus-visible) {
    outline: 2px solid var(--focus-ring-color);
    outline-offset: 2px;
  }
  @supports not selector(:has(*)) {
    .global-search__playable > input:focus-visible + .global-search__checkmark {
      outline: 2px solid var(--focus-ring-color);
      outline-offset: 2px;
    }
  }

  .global-search__clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    background: transparent;
    font: inherit;
    font-size: var(--font-size-sm);
    font-weight: 600;
    cursor: pointer;
  }
  .global-search__clear :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  @media (hover: hover) {
    .global-search__clear:hover:not(:disabled) {
      color: var(--color-text);
      background: var(--color-surface-hover);
    }
  }
  .global-search__clear:active:not(:disabled) {
    background: var(--color-surface-raised);
  }
  .global-search__clear:disabled {
    cursor: default;
    opacity: 0.5;
  }
  @media (pointer: coarse) {
    .global-search__playable,
    .global-search__clear {
      min-height: var(--tap-size);
    }
  }

