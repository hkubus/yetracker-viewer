---
/**
 * Search across the whole catalog, with an era range and a "playable only" switch. The behaviour lives in
 * `src/scripts/global-search.ts`; this renders the controls pre-filled from the URL (`?q=&eraFrom=&eraTo=&playable=`)
 * and the empty results region the script fills in.
 */
import { hasActiveFilters, parseSearchState } from '../utils/globalSearchState';
import { MAX_QUERY_LENGTH } from '../utils/search';
import { countLabel } from '../utils/songRow';
import CheckIcon from './icons/CheckIcon.astro';
import CloseIcon from './icons/CloseIcon.astro';
import PauseIcon from './icons/PauseIcon.astro';
import PlayIcon from './icons/PlayIcon.astro';
import SearchIcon from './icons/SearchIcon.astro';

interface SearchEra {
  id: number;
  name: string;
  dominantColor: string;
  hasCover?: boolean | null;
  coverVersion?: string | null;
}

interface Props {
  /** Main eras in catalog order; the era range is disabled when there are fewer than two. */
  eras: SearchEra[];
  /** Number of songs in the catalog, or null when unknown. */
  songsCount: number | null;
  /** Browser-facing API base URL. */
  apiBaseUrl: string;
  /** Songs per era page, to link results to the page that contains them. */
  eraPageSize: number;
}

const { eras, songsCount, apiBaseUrl, eraPageSize } = Astro.props;
const eraIds = eras.map((era) => era.id);
const state = parseSearchState(Astro.url.searchParams, eraIds);
const lastIndex = Math.max(eras.length - 1, 0);
const showRange = eras.length > 1;
const idleCount = songsCount === null ? '' : countLabel(songsCount, 'song');
const clearable = state.q !== '' || hasActiveFilters(state, eras.length);
const fromName = eras[state.from]?.name ?? '';
const toName = eras[state.to]?.name ?? '';
const rangeStatus =
  state.from === 0 && state.to === lastIndex ? 'All eras' : countLabel(state.to - state.from + 1, 'era');
const rangeStyle = showRange
  ? `--range-start: ${(state.from / lastIndex) * 100}%; --range-end: ${(state.to / lastIndex) * 100}%`
  : undefined;
const eraData = eras.map(({ id, name, dominantColor, hasCover, coverVersion }) => ({
  id,
  name,
  dominantColor,
  hasCover: hasCover ?? null,
  coverVersion: coverVersion ?? null,
}));
---

<section
  class="global-search"
  aria-labelledby="global-search-heading"
  data-global-song-search
  data-api-base-url={apiBaseUrl}
  data-era-page-size={eraPageSize}
  data-idle-count={idleCount}
  data-eras={JSON.stringify(eraData)}
>
  <form class="global-search__form" role="search" action="/" method="get" autocomplete="off" data-global-search-form>
    <div class="global-search__header">
      <h2 class="global-search__heading" id="global-search-heading">
        <label for="global-song-search">Find a track</label>
      </h2>
      <p class="global-search__count" data-global-search-count>{idleCount}</p>
    </div>

    <div class="global-search__field">
      <SearchIcon />
      <input
        id="global-song-search"
        name="q"
        type="search"
        value={state.q}
        maxlength={MAX_QUERY_LENGTH}
        placeholder="Search songs, artists, notes…"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
        aria-describedby="global-search-hint"
        data-global-search-input
      />
    </div>
    <p class="sr-only" id="global-search-hint">
      Results update as you type. Press Enter to go to the results, and the up and down arrow keys to move between them.
    </p>

    <div class="global-search__filters" role="group" aria-label="Search filters">
      {
        showRange ? (
          <div class="global-search__timeline" role="group" aria-labelledby="global-search-range-label">
            <div class="global-search__timeline-heading">
              <span class="global-search__range-label" id="global-search-range-label">
                Era range
              </span>
              <span class="global-search__range-status" data-era-range-status>
                {rangeStatus}
              </span>
            </div>
            <div class="global-search__range" style={rangeStyle} data-era-range>
              <div class="global-search__range-track" aria-hidden="true">
                <span />
              </div>
              <input
                type="range"
                min="0"
                max={lastIndex}
                step="1"
                value={state.from}
                aria-label="Earliest era"
                aria-valuetext={fromName}
                data-era-range-start
              />
              <input
                type="range"
                min="0"
                max={lastIndex}
                step="1"
                value={state.to}
                aria-label="Latest era"
                aria-valuetext={toName}
                data-era-range-end
              />
            </div>
            <div class="global-search__range-names" aria-hidden="true" data-era-range-names>
              <span data-era-start-name>{fromName}</span>
              <span data-era-end-name>{toName}</span>
            </div>
          </div>
        ) : null
      }

      <label class="global-search__playable">
        <input type="checkbox" name="playable" value="true" checked={state.playable} data-playable-filter />
        <span class="global-search__checkmark" aria-hidden="true">
          <CheckIcon />
        </span>
        <span>Playable only</span>
      </label>
      <button type="button" class="global-search__clear" disabled={!clearable} data-search-clear>
        <CloseIcon />
        <span>Clear<span class="sr-only"> search and filters</span></span>
      </button>
    </div>
  </form>

  <section
    class="global-search__results"
    id="global-search-results"
    tabindex="-1"
    aria-labelledby="global-search-results-heading"
    data-global-search-results
    hidden
  >
    <h3 class="sr-only" id="global-search-results-heading">Search results</h3>
    <ul class="global-search__list" data-global-search-list data-play-scope></ul>
    <div class="global-search__message" data-global-search-message hidden>
      <p data-global-search-message-text></p>
      <button type="button" class="global-search__button" data-global-search-retry hidden>Try again</button>
    </div>
    <div class="global-search__more" data-global-search-more hidden>
      <button type="button" class="global-search__button" data-global-search-more-button>Show more</button>
      <p class="global-search__more-progress" data-global-search-more-progress></p>
    </div>
  </section>
  <p class="sr-only" role="status" data-global-search-status></p>
  <template data-global-search-play-icon><PlayIcon class="play-icon" /><PauseIcon class="pause-icon" /></template>
  <noscript>
    <p class="global-search__noscript">Search needs JavaScript. The eras below work without it.</p>
  </noscript>
</section>

<script>
  import '../scripts/global-search';
</script>

<style>
  @property --range-start-color {
    syntax: '<color>';
    inherits: true;
    initial-value: #cfcfcf;
  }
  @property --range-end-color {
    syntax: '<color>';
    inherits: true;
    initial-value: #cfcfcf;
  }
  .global-search {
    margin: clamp(0.75rem, 1.5vw, 1.5rem);
    margin-bottom: 0;
    padding: clamp(1rem, 1.6vw, 1.35rem);
    border: 1px solid #414141;
    border-radius: 1rem;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 4%) inset,
      0 14px 35px rgb(0 0 0 / 16%);
    color: #f3f3f3;
    background: #202020;
  }
  .global-search__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.8rem;
  }
  .global-search__heading {
    margin: 0;
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    letter-spacing: -0.025em;
  }
  .global-search__count {
    margin: 0;
    color: #a8a8a8;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  .global-search__field {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 3.2rem;
    box-sizing: border-box;
    padding: 0 0.95rem;
    border: 1px solid #5c5c5c;
    border-radius: 0.75rem;
    background: #161616;
  }
  /* The input's own outline is replaced by this equally visible one around the whole field. */
  .global-search__field:focus-within {
    border-color: #d7d7d7;
    outline: 2px solid var(--focus-ring-color, #fff);
    outline-offset: 2px;
  }
  .global-search__field :global(svg) {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    color: #a0a0a0;
  }
  .global-search__field input {
    flex: 1;
    min-width: 0;
    box-sizing: border-box;
    padding: 0.78rem 0;
    border: 0;
    outline: none;
    color: #fff;
    background: transparent;
    font: inherit;
    font-size: 1rem;
  }
  .global-search__field input::placeholder {
    color: #8f8f8f;
    opacity: 1;
  }

  .global-search__filters {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.8rem;
    margin-top: 0.65rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid #3e3e3e;
    border-radius: 0.75rem;
    background: #181818;
  }
  .global-search__timeline {
    --thumb: 1.5rem;
    min-width: 0;
  }
  .global-search__timeline-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.1rem;
  }
  .global-search__range-label {
    color: #a8a8a8;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .global-search__range-status {
    color: #c8c8c8;
    font-size: 0.72rem;
    font-weight: 600;
  }
  .global-search__range {
    --range-start: 0%;
    --range-end: 100%;
    position: relative;
    height: var(--thumb);
    cursor: pointer;
    touch-action: pan-y;
    transition:
      --range-start-color 180ms ease-out,
      --range-end-color 180ms ease-out;
  }
  /* The track spans the thumb centres, so percentages line up with the thumbs. */
  .global-search__range-track {
    position: absolute;
    top: calc(50% - 2px);
    right: calc(var(--thumb) / 2);
    left: calc(var(--thumb) / 2);
    height: 4px;
    border-radius: 999px;
    background: #4c4c4c;
  }
  .global-search__range-track span {
    position: absolute;
    top: 0;
    right: calc(100% - var(--range-end));
    bottom: 0;
    left: var(--range-start);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--range-start-color), var(--range-end-color));
    background: linear-gradient(90deg in oklab, var(--range-start-color), var(--range-end-color));
  }
  /* Two overlapping native range inputs: only their thumbs take pointer events; clicks on the track are handled by
     the script (the nearest thumb jumps there). */
  .global-search__range input {
    --thumb-color: var(--range-end-color);
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    appearance: none;
    pointer-events: none;
  }
  .global-search__range input[data-era-range-start] {
    --thumb-color: var(--range-start-color);
  }
  /* When both thumbs sit on the same era, the one that can still move is on top. */
  .global-search__range[data-front='start'] input[data-era-range-start] {
    z-index: 2;
  }
  /* Replaced by the ring on the thumb below. */
  .global-search__range input:focus-visible {
    outline: none;
  }
  .global-search__range input::-webkit-slider-runnable-track {
    height: var(--thumb);
    border: 0;
    background: transparent;
  }
  .global-search__range input::-moz-range-track {
    height: var(--thumb);
    border: 0;
    background: transparent;
  }
  /* A 24px target with an ~19px visible knob. */
  .global-search__range input::-webkit-slider-thumb {
    width: var(--thumb);
    height: var(--thumb);
    border: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle closest-side,
      var(--thumb-color) 50%,
      #202020 54% 71%,
      #e4e4e4 74% 79%,
      transparent 82%
    );
    appearance: none;
    cursor: grab;
    pointer-events: auto;
  }
  .global-search__range input::-moz-range-thumb {
    box-sizing: border-box;
    width: var(--thumb);
    height: var(--thumb);
    border: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle closest-side,
      var(--thumb-color) 50%,
      #202020 54% 71%,
      #e4e4e4 74% 79%,
      transparent 82%
    );
    cursor: grab;
    pointer-events: auto;
  }
  .global-search__range input:active::-webkit-slider-thumb {
    cursor: grabbing;
  }
  .global-search__range input:active::-moz-range-thumb {
    cursor: grabbing;
  }
  .global-search__range input:focus-visible::-webkit-slider-thumb {
    box-shadow:
      0 0 0 2px #fff,
      0 0 0 4px #000;
  }
  .global-search__range input:focus-visible::-moz-range-thumb {
    box-shadow:
      0 0 0 2px #fff,
      0 0 0 4px #000;
  }
  .global-search__range-names {
    position: relative;
    height: 1.1rem;
    margin-inline: calc(var(--thumb) / 2);
    color: #dadada;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.1rem;
  }
  .global-search__range-names[data-stacked] {
    height: 2.2rem;
  }
  .global-search__range-names span {
    position: absolute;
    top: 0;
    left: 0;
    max-width: min(48%, 16rem);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .global-search__range-names span:last-child {
    left: auto;
    right: 0;
  }
  /* Once the script positions the labels, they use their full width (and stack when they would collide). */
  .global-search__range-names[data-measured] span {
    max-width: 100%;
  }
  .global-search__range-names[data-stacked] span:last-child {
    top: 1.1rem;
  }

  .global-search__playable {
    position: relative;
    display: flex;
    justify-self: start;
    align-items: center;
    gap: 0.55rem;
    box-sizing: border-box;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid #4c4c4c;
    border-radius: 0.65rem;
    color: #e2e2e2;
    background: #202020;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
  }
  .global-search__playable:hover {
    border-color: #707070;
  }
  .global-search__playable > input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .global-search__checkmark {
    display: grid;
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    box-sizing: border-box;
    place-items: center;
    border: 1px solid #8c8c8c;
    border-radius: 0.3rem;
    color: #151515;
    background: #151515;
  }
  .global-search__checkmark :global(svg) {
    width: 0.85rem;
    height: 0.85rem;
    opacity: 0;
  }
  .global-search__playable > input:checked + .global-search__checkmark {
    border-color: #e6e6e6;
    background: #e6e6e6;
  }
  .global-search__playable > input:checked + .global-search__checkmark :global(svg) {
    opacity: 1;
  }
  .global-search__playable:has(> input:focus-visible) {
    outline: 2px solid var(--focus-ring-color, #fff);
    outline-offset: 2px;
  }
  @supports not selector(:has(*)) {
    .global-search__playable > input:focus-visible + .global-search__checkmark {
      outline: 2px solid var(--focus-ring-color, #fff);
      outline-offset: 2px;
    }
  }

  .global-search__clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    min-height: 2.75rem;
    padding: 0 0.7rem;
    border: 1px solid transparent;
    border-radius: 0.6rem;
    color: #b8b8b8;
    background: transparent;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }
  .global-search__clear :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }
  .global-search__clear:hover:not(:disabled) {
    color: #fff;
    background: #2b2b2b;
  }
  .global-search__clear:focus-visible {
    outline: 2px solid var(--focus-ring-color, #fff);
    outline-offset: 2px;
  }
  .global-search__clear:disabled {
    cursor: default;
    opacity: 0.45;
  }

  .global-search__results {
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid #444;
  }
  .global-search__results:focus-visible {
    outline: 2px solid var(--focus-ring-color, #fff);
    outline-offset: 4px;
    border-radius: 0.5rem;
  }
  .global-search__results[hidden],
  .global-search__message[hidden],
  .global-search__more[hidden],
  .global-search__button[hidden] {
    display: none;
  }
  .global-search__results[aria-busy='true'] .global-search__list {
    opacity: 0.6;
    transition: opacity 120ms 150ms;
  }
  .global-search__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .global-search__list:empty {
    display: none;
  }
  /* Result rows are created by the script, so their rules are global (scoped under the list). */
  .global-search__list :global(.global-search__result) {
    position: relative;
    display: grid;
    grid-template-areas:
      'title play'
      'era play'
      'details details'
      'notes notes';
    grid-template-columns: minmax(0, 1fr) auto;
    align-content: start;
    gap: 0.15rem 0.6rem;
    box-sizing: border-box;
    min-width: 0;
    padding: 0.65rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--result-accent) 45%, var(--result-surface));
    border-left: 3px solid var(--result-accent);
    border-radius: 0.55rem;
    color: var(--result-text);
    background: var(--result-background);
    transition:
      border-color 120ms ease,
      background-color 120ms ease;
  }
  .global-search__list :global(.global-search__result:hover),
  .global-search__list :global(.global-search__result:focus-within),
  .global-search__list :global(.global-search__result[data-playing='true']) {
    border-color: var(--result-accent);
    background: var(--result-surface);
  }
  .global-search__list :global(.global-search__result-title) {
    grid-area: title;
    min-width: 0;
    color: inherit;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  /* The title link covers the whole card; the play button sits above it. */
  .global-search__list :global(a.global-search__result-title::after) {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 0.55rem;
  }
  .global-search__list :global(a.global-search__result-title:focus-visible) {
    outline: none;
  }
  .global-search__list :global(a.global-search__result-title:focus-visible::after) {
    outline: 2px solid var(--focus-ring-color, #fff);
    outline-offset: 2px;
  }
  .global-search__list :global(.global-search__result-era) {
    grid-area: era;
    min-width: 0;
    color: var(--result-accent-text);
    font-size: 0.8rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .global-search__list :global(.global-search__result-details) {
    grid-area: details;
    min-width: 0;
    color: var(--result-muted-text);
    font-size: 0.8rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .global-search__list :global(.global-search__result-notes) {
    display: -webkit-box;
    grid-area: notes;
    margin: 0.2rem 0 0;
    overflow: hidden;
    color: var(--result-muted-text);
    font-size: 0.82rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  .global-search__list :global(.global-search__result-play) {
    position: relative;
    z-index: 1;
    display: inline-grid;
    grid-area: play;
    align-self: center;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 999px;
    color: var(--result-on-accent);
    background: var(--result-accent);
    cursor: pointer;
  }
  .global-search__list :global(.global-search__result-play svg) {
    width: 1.05rem;
    height: 1.05rem;
  }
  /* The player sets aria-pressed="true" on the current song's button while it plays. */
  .global-search__list :global(.global-search__result-play .play-icon) {
    margin-left: 0.1rem;
  }
  .global-search__list :global(.global-search__result-play .pause-icon),
  .global-search__list :global(.global-search__result-play[aria-pressed='true'] .play-icon) {
    display: none;
  }
  .global-search__list :global(.global-search__result-play[aria-pressed='true'] .pause-icon) {
    display: block;
  }
  .global-search__list :global(.global-search__result-play:hover) {
    color: var(--result-background);
    background: var(--result-text);
  }
  .global-search__list :global(.global-search__result-play:focus-visible) {
    outline: 2px solid var(--focus-ring-color, #fff);
    outline-offset: 2px;
  }

  .global-search__message {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 0.75rem;
    margin-top: 0.35rem;
    color: #c8c8c8;
    text-align: center;
  }
  .global-search__message p {
    margin: 0;
  }
  .global-search__more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 0.9rem;
    margin-top: 0.8rem;
  }
  .global-search__more-progress {
    margin: 0;
    color: #a8a8a8;
    font-size: 0.8rem;
    text-align: center;
  }
  .global-search__button {
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid #6c6c6c;
    border-radius: 0.6rem;
    color: #f3f3f3;
    background: #2a2a2a;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }
  .global-search__button:hover {
    border-color: #8c8c8c;
