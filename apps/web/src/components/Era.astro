---
/**
 * An era card for the home page grid: the cover (or a placeholder tile) full-bleed on top, then the name as an
 * <h3> under the "Eras" heading, the subtitle and the song count, all one link to the era page. The frame stays
 * neutral; the era's colors (from `themeFor`, readable for any era color) tint the card and mark hover and focus.
 */
import type { Era } from '@yetracker/types';
import { themeStyle } from '../utils/color';
import { countLabel } from '../utils/songRow';
import CoverImage from './CoverImage.astro';

type EraCard = Pick<Era, 'id' | 'name' | 'dominantColor'> & {
  subtitle?: string | null;
  hasCover?: boolean | null;
  coverVersion?: string | null;
  songsCount?: number | null;
};

interface Props {
  era: EraCard;
  apiBaseUrl?: string;
  /** Load the cover eagerly with high priority (first cards, likely above the fold). */
  priority?: boolean;
}

const { era, apiBaseUrl, priority = false } = Astro.props;
const songsCount = typeof era.songsCount === 'number' && era.songsCount >= 0 ? era.songsCount : null;
---

<a class="era-card" href={`/eras/${era.id}`} style={themeStyle(era.dominantColor, '--era')} data-astro-prefetch>
  <CoverImage
    class="era-card__cover"
    eraId={era.id}
    eraName={era.name}
    hasCover={era.hasCover}
    coverVersion={era.coverVersion}
    dominantColor={era.dominantColor}
    priority={priority}
    apiBaseUrl={apiBaseUrl}
  />
  <span class="era-card__body">
    <h3 class="era-card__name">{era.name}</h3>
    {era.subtitle ? <p class="era-card__subtitle">{era.subtitle}</p> : null}
    {songsCount !== null ? <p class="era-card__count">{countLabel(songsCount, 'song')}</p> : null}
  </span>
</a>

<style>
  .era-card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    /* Clips the full-bleed cover to the card's corners (the focus outline is drawn outside and stays visible). */
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--era-text);
    /* A hint of the era's color on the neutral surface; the era's text colors stay readable on both. */
    background: color-mix(in oklab, var(--era-background) 60%, var(--color-surface));
    text-decoration: none;
    transition:
      transform var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      background-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }
  .era-card :global(.era-card__cover) {
    flex: none;
  }
  .era-card :global(.era-card__cover img) {
    transition: transform var(--duration-slow) var(--ease-standard);
  }
  .era-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
    padding: var(--space-3) var(--space-3) var(--space-3);
  }
  .era-card__name {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: var(--font-size-md);
    font-weight: 600;
    line-height: var(--line-height-snug);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .era-card__subtitle {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    overflow-wrap: anywhere;
    color: var(--era-muted-text);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-snug);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  /* Pushed to the bottom, so counts line up across a row of cards with names of different lengths. */
  .era-card__count {
    margin: auto 0 0;
    padding-top: var(--space-1);
    color: var(--era-muted-text);
    font-size: var(--font-size-xs);
    font-variant-numeric: tabular-nums;
  }
  .era-card:focus-visible {
    border-color: var(--era-accent);
    outline: 2px solid var(--focus-ring-color);
    outline-offset: 3px;
  }
  .era-card:active {
    background: var(--era-surface);
  }
  @media (hover: hover) and (pointer: fine) {
    .era-card:hover {
      border-color: color-mix(in srgb, var(--era-accent) 70%, transparent);
      background: var(--era-background);
      box-shadow: var(--shadow-md);
      transform: translateY(-3px);
    }
    .era-card:hover :global(.era-card__cover img) {
      transform: scale(1.04);
    }
    .era-card:active {
      transform: translateY(-1px);
    }
  }
  /* No lift or zoom: the hover still shows through the border, tint and shadow. */
  @media (prefers-reduced-motion: reduce) {
    .era-card:hover,
    .era-card:active,
    .era-card:hover :global(.era-card__cover img) {
      transform: none;
    }
  }
  @media (forced-colors: active) {
    .era-card {
      border-color: CanvasText;
    }
  }
</style>
