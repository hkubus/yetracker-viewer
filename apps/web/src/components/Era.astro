---
import type { Era } from '@yetracker/types';
import { apiUrl } from '../config';
import { colorValue } from '../utils/color';

const era = Astro.props.era as Era;
const apiBaseUrl = Astro.props.apiBaseUrl as string;
const priority = (Astro.props.priority as boolean | undefined) ?? false;
const dominantColor = colorValue(era.dominantColor);
const rawCoverVersion = (era.coverVersion ?? '').trim();
const coverUrl = rawCoverVersion
  ? `${apiUrl(apiBaseUrl, `/eras/${era.id}/cover`)}?v=${encodeURIComponent(rawCoverVersion)}`
  : apiUrl(apiBaseUrl, `/eras/${era.id}/cover`);
const songsCount = typeof era.songsCount === 'number' ? era.songsCount : 0;
---
<a href={`/eras/${era.id}`}>
<div style={`--dominantColor: ${dominantColor};`}>
    <img
        src={coverUrl}
        alt={`${era.name} cover`}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
    />
    <h2>{era.name}</h2>
    <p>{songsCount.toLocaleString()} {songsCount === 1 ? 'song' : 'songs'}</p>
</div>
</a>
<style>
    a {
        display: block;
        min-width: 0;
        height: 100%;
        text-decoration: none;
    }
    a:focus-visible {
        outline: 3px solid var(--dominantColor);
        outline-offset: 3px;
        border-radius: 0.7em;
    }
    div:hover {
        border-color: var(--dominantColor);
        background-color: color-mix(in srgb, var(--dominantColor) 35%, transparent);
        color: color-mix(in oklab, var(--dominantColor) 20%, white);
        transform: translateY(-0.25rem);
    }
    div {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        padding: 0.7em;
        border: 4px solid color-mix(in srgb, var(--dominantColor) 70%, transparent);
        border-radius: 0.7em;
        color: color-mix(in oklab, var(--dominantColor) 30%, white);
        background-color: color-mix(in srgb, var(--dominantColor) 25%, transparent);
        transition:
            transform 0.2s,
            border-color 0.2s,
            background-color 0.2s,
            color 0.2s;
    }
    h2 {
        margin: 8px 0 0;
        overflow-wrap: anywhere;
        font-size: 1.475em;
    }
    p {
        align-self: flex-end;
        margin: auto 0 0;
        font-size: 0.9em;
        font-weight: 300;
    }
    img {
        width: 100%;
        aspect-ratio: 1;
        border-radius: 0.7em;
        object-fit: cover;
    }
    @media (prefers-reduced-motion: reduce) {
        div,
        div:hover {
            transform: none;
            transition: none;
        }
    }
</style>
