---
const {
  currentPage,
  pageCount,
  totalItems,
  pageSize,
  basePath,
  paginationId = 'song-pagination',
} = Astro.props as {
  currentPage: number;
  pageCount: number;
  totalItems: number;
  pageSize: number;
  basePath: string;
  paginationId?: string;
};

const firstItem = totalItems === 0 ? 0 : (currentPage - 1) * pageSize + 1;
const lastItem = Math.min(currentPage * pageSize, totalItems);
const visiblePages = Array.from(
  new Set([1, pageCount, currentPage - 2, currentPage - 1, currentPage, currentPage + 1, currentPage + 2]),
)
  .filter((page) => page >= 1 && page <= pageCount)
  .sort((left, right) => left - right);
const href = (page: number) => {
  const separator = basePath.includes('?') ? '&' : '?';
  return page === 1 ? basePath : `${basePath}${separator}page=${page}`;
};
const isFirstPage = currentPage <= 1;
const isLastPage = currentPage >= pageCount;
---

<nav id={paginationId} class="pagination" aria-label="Song pages">
  <p class="pagination__summary">
    Showing {firstItem.toLocaleString()}–{lastItem.toLocaleString()} of {totalItems.toLocaleString()} songs
  </p>

  {
    pageCount > 1 && (
      <div class="pagination__links">
        <a
          class:list={['pagination__direction', { disabled: isFirstPage }]}
          href={isFirstPage ? undefined : href(Math.max(1, currentPage - 1))}
          aria-disabled={isFirstPage ? 'true' : undefined}
          tabindex={isFirstPage ? '-1' : undefined}
          rel="prev"
        >
          Previous
        </a>
        <p class="pagination__mobile">Page {currentPage} of {pageCount}</p>
        <div class="pagination__pages" data-page-count={pageCount}>
          {visiblePages.map((page, index) => (
            <>
              {index > 0 && page - visiblePages[index - 1] > 1 && <span aria-hidden="true">…</span>}
              <a href={href(page)} aria-current={page === currentPage ? 'page' : undefined}>
                {page}
              </a>
            </>
          ))}
        </div>
        <a
          class:list={['pagination__direction', { disabled: isLastPage }]}
          href={isLastPage ? undefined : href(Math.min(pageCount, currentPage + 1))}
          aria-disabled={isLastPage ? 'true' : undefined}
          tabindex={isLastPage ? '-1' : undefined}
          rel="next"
        >
          Next
        </a>
      </div>
    )
  }
</nav>

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 1rem 0;
    color: color-mix(in oklab, var(--dominantColor) 15%, white);
  }

  .pagination__summary {
    margin: 0;
    color: #b9b9b9;
    font-size: 0.9rem;
  }

  .pagination__links,
  .pagination__pages {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .pagination__mobile {
    display: none;
    margin: 0;
    color: #b9b9b9;
    font-size: 0.85rem;
  }

  a {
    display: inline-flex;
    min-width: 2.25rem;
    min-height: 2.25rem;
    box-sizing: border-box;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.65rem;
    border: 2px solid color-mix(in srgb, var(--dominantColor) 55%, #555);
    border-radius: 0.55rem;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 120ms ease,
      background-color 120ms ease;
  }

  a:hover,
  a[aria-current='page'] {
    border-color: var(--dominantColor);
    background: color-mix(in srgb, var(--dominantColor) 30%, transparent);
  }

  a:focus-visible {
    border-color: #fff;
    outline: 3px solid #fff;
    outline-offset: 2px;
    background: color-mix(in srgb, var(--dominantColor) 30%, transparent);
  }

  a[aria-current='page'] {
    font-weight: 700;
  }

  a.disabled {
    pointer-events: none;
    opacity: 0.4;
  }

  .pagination__direction {
    min-width: 5.5rem;
  }

  @media (max-width: 700px) {
    .pagination {
      align-items: stretch;
      flex-direction: column;
    }

    .pagination__links {
      justify-content: space-between;
    }

    /* Numbered pages do not fit a phone; prev/next plus a page indicator do. */
    .pagination__pages {
      display: none;
    }

    .pagination__mobile {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>
