---
/**
 * Page links for a paginated song list.
 *
 * - `full` (default): a summary ("Showing 101–200 of 956 songs") and the page links. Wide screens get
 *   previous/next plus numbered pages; phones get first/previous/"Page n of m"/next/last.
 * - `compact`: previous/next page icons only, for a toolbar that shows the count itself. Nothing is rendered for a
 *   single page.
 *
 * Colors come from the `--theme-*` variables of an ancestor (neutral tokens without one).
 */
import ChevronIcon from './icons/ChevronIcon.astro';

interface Props {
  currentPage: number;
  pageCount: number;
  totalItems: number;
  pageSize: number;
  /** The list's URL (with its query string) without `page`. */
  basePath: string;
  paginationId?: string;
  /** Which of the list's navs this is, so the two landmarks get distinct names. Default: from `paginationId`. */
  position?: 'top' | 'bottom';
  /** Fragment added to page links so the new page opens at the list (`''` for none). */
  fragment?: string;
  variant?: 'full' | 'compact';
}

const {
  currentPage,
  pageCount,
  totalItems,
  pageSize,
  basePath,
  paginationId = 'song-pagination',
  position = paginationId.endsWith('-top') ? 'top' : 'bottom',
  fragment = 'songs',
  variant = 'full',
} = Astro.props;

const wholeNumber = (value: number, fallback: number) => (Number.isFinite(value) ? Math.trunc(value) : fallback);
const total = Math.max(0, wholeNumber(totalItems, 0));
const size = Math.max(1, wholeNumber(pageSize, 1));
const pages = Math.max(1, wholeNumber(pageCount, 1));
const current = Math.min(Math.max(1, wholeNumber(currentPage, 1)), pages);
const first = Math.min((current - 1) * size + 1, total);
const last = Math.min(current * size, total);
const format = (value: number) => value.toLocaleString('en-US');
const noun = total === 1 ? 'song' : 'songs';
const summary =
  total === 0
    ? 'No songs'
    : first >= last
      ? `Showing ${format(last)} of ${format(total)} ${noun}`
      : `Showing ${format(first)}–${format(last)} of ${format(total)} ${noun}`;
const label = position === 'top' ? 'Song pages' : 'Song pages, end of list';

const numbered = Array.from(new Set([1, pages, current - 2, current - 1, current, current + 1, current + 2]))
  .filter((page) => page >= 1 && page <= pages)
  .sort((left, right) => left - right);

function pageHref(page: number): string {
  const url = new URL(basePath || '/', 'http://localhost');
  if (page > 1) url.searchParams.set('page', String(page));
  else url.searchParams.delete('page');
  return `${url.pathname}${url.search}${fragment ? `#${fragment}` : ''}`;
}

/** Step links; a step that goes nowhere is shown dimmed and hidden from assistive technology, not rendered as a link. */
const steps = {
  first: { page: 1, text: 'First page', enabled: current > 1 },
  previous: { page: current - 1, text: 'Previous', enabled: current > 1 },
  next: { page: current + 1, text: 'Next', enabled: current < pages },
  last: { page: pages, text: 'Last page', enabled: current < pages },
} as const;
---

{
  variant === 'compact' ? (
    pages > 1 && (
      <nav id={paginationId} class="pagination pagination--compact" aria-label={label}>
        <ul class="pagination__list">
          <li class="pagination__item" aria-hidden={steps.previous.enabled ? undefined : 'true'}>
            {steps.previous.enabled ? (
              <a
                class="pagination__link pagination__link--icon"
                href={pageHref(steps.previous.page)}
                rel="prev"
                title="Previous page"
                data-astro-prefetch
              >
                <ChevronIcon direction="left" class="pagination__icon" />
                <span class="sr-only">Previous page</span>
              </a>
            ) : (
              <span class="pagination__link pagination__link--icon is-disabled">
                <ChevronIcon direction="left" class="pagination__icon" />
              </span>
            )}
          </li>
          <li class="pagination__item" aria-hidden={steps.next.enabled ? undefined : 'true'}>
            {steps.next.enabled ? (
              <a
                class="pagination__link pagination__link--icon"
                href={pageHref(steps.next.page)}
                rel="next"
                title="Next page"
                data-astro-prefetch
              >
                <ChevronIcon class="pagination__icon" />
                <span class="sr-only">Next page</span>
              </a>
            ) : (
              <span class="pagination__link pagination__link--icon is-disabled">
                <ChevronIcon class="pagination__icon" />
              </span>
            )}
          </li>
        </ul>
      </nav>
    )
  ) : (
    <nav id={paginationId} class="pagination" aria-label={label}>
      <p class="pagination__summary">{summary}</p>
      {pages > 1 && (
        <ul class="pagination__list">
          <li class="pagination__item pagination__item--compact" aria-hidden={steps.first.enabled ? undefined : 'true'}>
            {steps.first.enabled ? (
              <a class="pagination__link pagination__link--icon" href={pageHref(steps.first.page)}>
                <ChevronIcon direction="left" double class="pagination__icon" />
                <span class="sr-only">{steps.first.text}</span>
              </a>
            ) : (
              <span class="pagination__link pagination__link--icon is-disabled">
                <ChevronIcon direction="left" double class="pagination__icon" />
              </span>
            )}
          </li>
          <li class="pagination__item" aria-hidden={steps.previous.enabled ? undefined : 'true'}>
            {steps.previous.enabled ? (
              <a
                class="pagination__link pagination__link--step"
                href={pageHref(steps.previous.page)}
                rel="prev"
                data-astro-prefetch
              >
                <ChevronIcon direction="left" class="pagination__icon" />
                <span class="pagination__step-text">{steps.previous.text}</span>
              </a>
            ) : (
              <span class="pagination__link pagination__link--step is-disabled">
                <ChevronIcon direction="left" class="pagination__icon" />
                <span class="pagination__step-text">{steps.previous.text}</span>
              </span>
            )}
          </li>
          {numbered.map((page, index) => (
            <>
              {index > 0 && page - (numbered[index - 1] ?? 0) > 1 && (
                <li class="pagination__item pagination__item--wide pagination__gap" aria-hidden="true">
                  …
                </li>
              )}
              <li class="pagination__item pagination__item--wide">
                <a
                  class="pagination__link pagination__link--page"
                  href={pageHref(page)}
                  aria-current={page === current ? 'page' : undefined}
                >
                  <span class="sr-only">Page </span>
                  {page}
                </a>
              </li>
            </>
          ))}
          <li class="pagination__item pagination__item--compact pagination__status">
            Page {current} of {pages}
          </li>
          <li class="pagination__item" aria-hidden={steps.next.enabled ? undefined : 'true'}>
            {steps.next.enabled ? (
              <a
                class="pagination__link pagination__link--step"
                href={pageHref(steps.next.page)}
                rel="next"
                data-astro-prefetch
              >
                <span class="pagination__step-text">{steps.next.text}</span>
                <ChevronIcon class="pagination__icon" />
              </a>
            ) : (
              <span class="pagination__link pagination__link--step is-disabled">
                <span class="pagination__step-text">{steps.next.text}</span>
                <ChevronIcon class="pagination__icon" />
              </span>
            )}
          </li>
          <li class="pagination__item pagination__item--compact" aria-hidden={steps.last.enabled ? undefined : 'true'}>
            {steps.last.enabled ? (
              <a class="pagination__link pagination__link--icon" href={pageHref(steps.last.page)}>
                <ChevronIcon double class="pagination__icon" />
                <span class="sr-only">{steps.last.text}</span>
              </a>
            ) : (
              <span class="pagination__link pagination__link--icon is-disabled">
                <ChevronIcon double class="pagination__icon" />
              </span>
            )}
          </li>
        </ul>
      )}
    </nav>
  )
}

<style>
  .pagination {
    --pagination-size: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
    margin: var(--space-5) 0 var(--space-4);
    color: var(--theme-text, var(--color-text));
  }
  .pagination--compact {
    display: block;
    margin: 0;
  }
  .pagination__summary {
    margin: 0;
    color: var(--theme-muted-text, var(--color-text-muted));
    font-size: var(--font-size-sm);
    font-variant-numeric: tabular-nums;
  }
  .pagination__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pagination__item {
    display: flex;
  }
  .pagination__item--compact {
    display: none;
  }
  .pagination__gap {
    min-width: 1.5rem;
    justify-content: center;
    color: var(--theme-muted-text, var(--color-text-muted));
  }
  .pagination__link {
    box-sizing: border-box;
    display: inline-flex;
    min-width: var(--pagination-size);
    min-height: var(--pagination-size);
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    padding: 0 var(--space-3);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    color: inherit;
    font-size: var(--font-size-sm);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }
  .pagination__link--step,
  .pagination__link--icon {
    border-color: var(--color-border-strong);
  }
  .pagination__link--icon {
    padding: 0;
  }
  .pagination__link--step {
    padding-inline: var(--space-3) var(--space-4);
  }
  .pagination__link--step:has(.pagination__step-text:first-child) {
    padding-inline: var(--space-4) var(--space-3);
  }
  .pagination :global(.pagination__icon) {
    width: 1.125rem;
    height: 1.125rem;
    flex: none;
  }
  @media (hover: hover) {
    a.pagination__link:hover {
      border-color: var(--color-border-strong);
      background: var(--color-surface);
    }
  }
  a.pagination__link:active {
    background: var(--color-surface-raised);
  }
  a.pagination__link[aria-current='page'] {
    border-color: var(--theme-accent, var(--color-accent));
    color: var(--theme-on-accent, var(--color-on-accent));
    background: var(--theme-accent, var(--color-accent));
    font-weight: 700;
  }
  a.pagination__link:focus-visible {
    outline: 2px solid var(--theme-focus-ring, var(--focus-ring-color));
    outline-offset: 2px;
  }
  /* Dimmed through the border only: the label keeps the muted text contrast. */
  .pagination__link.is-disabled {
    border-style: dashed;
    border-color: var(--color-border);
    color: var(--theme-muted-text, var(--color-text-muted));
  }

  @media (pointer: coarse) {
    .pagination {
      --pagination-size: var(--tap-size);
    }
  }

  /* Phones: first / previous / "Page n of m" / next / last under the summary. */
  @media (max-width: 40rem) {
    .pagination:not(.pagination--compact) {
      flex-direction: column;
      align-items: stretch;
      --pagination-size: var(--tap-size);
    }
    .pagination__summary {
      text-align: center;
    }
    .pagination:not(.pagination--compact) .pagination__list {
      flex-wrap: nowrap;
    }
    .pagination__item--wide {
      display: none;
    }
    .pagination__item--compact {
      display: flex;
    }
    /* Wraps ("Page 5" / "of 10") where the four 44px steps leave too little room, e.g. at 280px. */
    .pagination__status {
      flex: 1 1 auto;
      min-width: 0;
      justify-content: center;
      color: var(--theme-muted-text, var(--color-text-muted));
      font-size: var(--font-size-sm);
      font-variant-numeric: tabular-nums;
      line-height: var(--line-height-tight);
      text-align: center;
      text-wrap: balance;
    }
    .pagination__step-text {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      border: 0;
      white-space: nowrap;
    }
    .pagination__link--step,
    .pagination__link--step:has(.pagination__step-text:first-child) {
      padding: 0;
    }
  }
</style>
