---
const label = (Astro.props.label as string | undefined) ?? 'Back to all eras';
const href = (Astro.props.href as string | undefined) ?? '/';
---
<a class="back-button" href={href} aria-label={label} title={label}>
    <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="27"
        height="27"
        fill="none"
        stroke="currentColor"
        stroke-width="2.75"
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        <path d="M19 12H6M12 18l-6-6 6-6"></path>
    </svg>
    <span class="back-button__label">{label}</span>
</a>

<style>
    .back-button {
        position: fixed;
        z-index: 20;
        top: max(0.75rem, env(safe-area-inset-top));
        left: max(0.75rem, env(safe-area-inset-left));
        display: inline-flex;
        box-sizing: border-box;
        max-width: min(16rem, calc(100vw - 1.5rem));
        min-height: 3.25rem;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem 0.5rem 0.5rem;
        border: 3px solid
            color-mix(in srgb, var(--dominantColor) 55%, transparent);
        border-radius: 999px;
        backdrop-filter: blur(12px);
        box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 35%);
        color: color-mix(in oklab, var(--dominantColor) 12%, white);
        background: color-mix(in srgb, var(--dominantColor) 28%, #181818);
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition:
            border-color 120ms ease,
            background-color 120ms ease,
            transform 120ms ease;
    }
    .back-button svg {
        width: 1.7rem;
        height: 1.7rem;
        flex: none;
    }
    .back-button__label {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .back-button:hover {
        border-color: color-mix(in srgb, var(--dominantColor) 80%, white);
        background: color-mix(in srgb, var(--dominantColor) 30%, #181818);
        transform: scale(1.06);
    }
    .back-button:focus-visible {
        border-color: #fff;
        outline: 3px solid #fff;
        outline-offset: 3px;
        background: color-mix(in srgb, var(--dominantColor) 30%, #181818);
    }
    @media (max-width: 700px) {
        .back-button {
            position: static;
            max-width: 100%;
            margin-bottom: 0.75rem;
        }
        .back-button:hover {
            transform: none;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .back-button,
        .back-button:hover {
            transform: none;
            transition: none;
        }
    }
</style>
