---
/**
 * "Back to …" link at the top of a page, in normal document flow. It returns to the previous page with the
 * browser's history when that page is its own target (so the list is restored as the user left it), and is a
 * plain link otherwise (direct entry, arriving from another site). Colors come from the page's `--theme-*`
 * variables (`themeStyle()` in utils/color.ts) with neutral fallbacks.
 */
import ArrowLeftIcon from './icons/ArrowLeftIcon.astro';

interface Props {
  /** Visible text ("All eras"). */
  label?: string;
  /** Accessible name; it contains the visible text (WCAG 2.5.3). Default: "Back to <label>". */
  accessibleLabel?: string;
  href?: string;
  class?: string;
}

const { label = 'All eras', href = '/', class: className } = Astro.props;
const accessibleLabel = Astro.props.accessibleLabel ?? `Back to ${label.toLowerCase()}`;
---

<a
  class:list={['back-link', className]}
  href={href}
  aria-label={accessibleLabel === label ? undefined : accessibleLabel}
  data-back-link
>
  <ArrowLeftIcon class="back-link__icon" stroke-width="2.25" />
  <span class="back-link__label">{label}</span>
</a>

<script>
  import { initBackLinks } from '../utils/back-navigation';

  initBackLinks();
</script>

<style>
  /* A quiet ghost button: the page's content, not its chrome, carries the color. */
  .back-link {
    display: inline-flex;
    box-sizing: border-box;
    max-width: 100%;
    min-height: var(--tap-size);
    align-items: center;
    gap: var(--space-2);
    padding: 0 var(--space-4) 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--theme-text, var(--color-text));
    background: transparent;
    font-size: var(--font-size-sm);
    font-weight: 600;
    line-height: var(--line-height-tight);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }
  @media (hover: hover) {
    .back-link:hover {
      border-color: var(--color-border-strong);
      background: var(--color-surface);
    }
  }
  .back-link:active {
    background: var(--color-surface-raised);
  }
  .back-link:focus-visible {
    outline: 2px solid var(--theme-focus-ring, var(--focus-ring-color));
    outline-offset: 2px;
  }
  .back-link__icon {
    width: 1.125rem;
    height: 1.125rem;
    flex: none;
  }
  .back-link__label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
