---
/**
 * "Back to …" link at the top of a page, in normal document flow. It returns to the previous page with the
 * browser's history when that page is its own target (so the list is restored as the user left it), and is a
 * plain link otherwise (direct entry, arriving from another site). Colors come from the page's `--theme-*`
 * variables (`themeStyle()` in utils/color.ts) with neutral fallbacks.
 */
import ArrowLeftIcon from './icons/ArrowLeftIcon.astro';

interface Props {
  /** Visible text, also the accessible name. */
  label?: string;
  href?: string;
  class?: string;
}

const { label = 'Back to all eras', href = '/', class: className } = Astro.props;
---

<a class:list={['back-link', className]} href={href} data-back-link>
  <ArrowLeftIcon class="back-link__icon" stroke-width="2.5" />
  <span class="back-link__label">{label}</span>
</a>

<script>
  import { initBackLinks } from '../utils/back-navigation';

  initBackLinks();
</script>

<style>
  .back-link {
    display: inline-flex;
    box-sizing: border-box;
    max-width: 100%;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem 0.4rem 0.75rem;
    border: 2px solid var(--theme-accent, #8a8a8a);
    border-radius: 999px;
    color: var(--theme-text, #f3f3f3);
    background: var(--theme-surface, #262626);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color 120ms ease,
      border-color 120ms ease;
  }
  .back-link:hover {
    border-color: var(--theme-focus-ring, #ffffff);
    background: var(--theme-background, #1c1c1c);
  }
  .back-link:focus-visible {
    outline: 2px solid var(--theme-focus-ring, #ffffff);
    outline-offset: 2px;
  }
  .back-link__icon {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }
  .back-link__label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
