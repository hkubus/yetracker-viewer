---
import type { Song } from '@yetracker/types';
import { Icon } from 'astro-icon/components';
import { apiUrl } from '../config';
import { SONG_CATEGORIES } from '../songCategories';
import { DEFAULT_SONG_SORT, SONG_SORTS } from '../songSorts';
import { convertDuration } from '../utils/convertDuration';

type SongRow = Song & {
  url?: string;
  filename?: string;
  fileName?: string;
  downloaded?: number | string | null;
  playable?: boolean;
  duration?: number | null;
};

const songs = (Astro.props.songs ?? []) as SongRow[];
const eraId = Astro.props.eraId;
const eraName = (Astro.props.eraName as string | undefined) ?? '';
const scopeName = (Astro.props.scopeName as string | undefined) ?? 'era';
const apiBaseUrl = Astro.props.apiBaseUrl as string;
const coverVersion = Astro.props.coverVersion as string | undefined;
const sort = (Astro.props.sort as string | undefined) ?? DEFAULT_SONG_SORT;
const initialQuery = String(
  (Astro.props.initialQuery as string | undefined) ??
    (Astro.props.searchQuery as string | undefined) ??
    (Astro.props.q as string | undefined) ??
    '',
);
const initialCategory = String((Astro.props.initialCategory as string | undefined) ?? '');
const shortDate = new Intl.DateTimeFormat('en-US', {
  dateStyle: 'short',
});

const safeIdPart = String(eraId ?? 'list').replace(/[^a-zA-Z0-9_-]/g, '-');
const searchInputId = `song-search-${safeIdPart || 'list'}`;
const categorySelectId = `song-category-${safeIdPart || 'list'}`;
const sortSelectId = `song-sort-${safeIdPart || 'list'}`;
const hasServerFilter = initialQuery.trim().length > 0 || initialCategory.length > 0 || sort !== DEFAULT_SONG_SORT;
const clearHref = eraId != null ? `/eras/${encodeURIComponent(eraId)}` : '.';

function isPlayable(song: SongRow): boolean {
  if (typeof song.playable === 'boolean') return song.playable;
  if (typeof song.downloaded === 'number') return song.downloaded === 1;
  if (typeof song.downloaded === 'string') return song.downloaded === '1';
  const file = song.filename ?? song.fileName;
  if (typeof file === 'string' && file.trim().length > 0) return true;
  return false;
}

/** Explains *why* a row cannot be played instead of showing nothing at all. */
function unavailableLabel(song: SongRow): string {
  if (song.downloaded === 0) return 'Download failed for this track — open the source instead';
  if (song.url) return 'No local file yet — open the source instead';
  return 'No audio file and no source link for this track';
}

function formatSongDate(value: unknown): string {
  if (typeof value !== 'number') return '';
  if (!Number.isFinite(value) || value <= 0) return '';
  try {
    const date = new Date(value * 1000);
    if (Number.isNaN(date.getTime())) return '';
    return shortDate.format(date);
  } catch {
    return '';
  }
}

function formatLength(song: SongRow): string {
  const parts: string[] = [];
  if (song.availableLength) parts.push(song.availableLength);
  const d = song.duration ?? song.trackLength;
  if (typeof d === 'number' && Number.isFinite(d) && d > 0) {
    parts.push(convertDuration(d));
  }
  return parts.join(' - ');
}

/** `is-blank` lets the mobile card layout drop cells that have nothing to show. */
function blankClass(value: string): string {
  return value.trim().length === 0 ? ' is-blank' : '';
}

function rowId(song: SongRow, index: number): string {
  const id = Number(song.id);
  if (song.id != null && Number.isFinite(id)) return `song-${Math.trunc(id)}`;
  return `song-index-${index}`;
}

function eraIdAttr(song: SongRow): string | undefined {
  const raw = song.eraId ?? eraId;
  const n = Number(raw);
  if (Number.isFinite(n)) return String(Math.trunc(n));
  return undefined;
}

/** Everything the server-side query matches, so the instant filter agrees with it. */
function searchText(song: SongRow): string {
  return [song.name, song.notes, song.quality, song.availableLength, formatLength(song)]
    .filter((part): part is string => typeof part === 'string' && part.length > 0)
    .join(' ');
}
---

<section class="song-list" data-song-list data-play-scope>
    <div class="song-search">
        <label for={searchInputId}>Search songs in this {scopeName}</label>
        <form method="get" action="" data-song-search-form>
            <div class="song-search__controls">
                <div class="song-search__select-group">
                    <label class="song-search__control-label" for={categorySelectId}>Category</label>
                    <select id={categorySelectId} name="category" class="song-search__select" data-song-select>
                        <option value="" selected={initialCategory === ''}>All categories</option>
                        {
                            SONG_CATEGORIES.map((category) => (
                                <option value={category.id} selected={category.id === initialCategory}>
                                    {`${category.emoji} ${category.label}`}
                                </option>
                            ))
                        }
                    </select>
                </div>
                <div class="song-search__select-group">
                    <label class="song-search__control-label" for={sortSelectId}>Sort</label>
                    <select id={sortSelectId} name="sort" class="song-search__select" data-song-select>
                        {
                            SONG_SORTS.map((option) => (
                                <option value={option.id} selected={option.id === sort}>
                                    {option.label}
                                </option>
                            ))
                        }
                    </select>
                </div>
                <input
                    id={searchInputId}
                    name="q"
                    type="search"
                    placeholder={`Search songs in this ${scopeName}…`}
                    autocomplete="off"
                    value={initialQuery}
                    data-song-search
                />
                <button type="submit" class="song-search__submit">Search</button>
                {
                    hasServerFilter && (
                        <a class="song-search__clear" href={clearHref}>
                            Clear all filters
                        </a>
                    )
                }
                <p class="song-count" aria-live="polite" data-song-count>
                    {songs.length} {songs.length === 1 ? 'song' : 'songs'}
                </p>
            </div>
            <p class="song-search__hint">
                Searches titles, notes, quality and length on the server across the whole era. Typing also filters
                this page instantly; the sort applies to every page.
            </p>
        </form>
    </div>

    <div class="song-table-wrap">
    <table>
        <caption class="sr-only">Songs in {eraName || scopeName}</caption>
        <thead>
            <tr>
                <th scope="col"><span class="sr-only">Actions</span></th>
                <th scope="col">Title</th>
                <th scope="col">Notes</th>
                <th scope="col">Quality</th>
                <th scope="col">Available Length</th>
                <th scope="col">File Date</th>
                <th scope="col">Leak Date</th>
            </tr>
        </thead>
        <tbody>
        {
            songs.map((e, index) => {
                const playable = isPlayable(e);
                const idAttr = eraIdAttr(e);
                const numericId = Number(e.id);
                const hasId = e.id != null && Number.isFinite(numericId);
                const notes = typeof e.notes === 'string' ? e.notes.trim() : '';
                const quality = typeof e.quality === 'string' ? e.quality : '';
                const length = formatLength(e);
                const fileDate = formatSongDate(e.fileDate);
                const leakDate = formatSongDate(e.leakDate);
                return (
                    <tr
                        id={rowId(e, index)}
                        class="song-row"
                        data-play-row
                        data-song-name={e.name ?? ''}
                        data-search-text={searchText(e)}
                    >
                        <td class="song-actions-cell" data-label="Actions">
                            {playable ? (
                                <div class="song-actions">
                                    <button
                                        class="play-song"
                                        type="button"
                                        data-play-target
                                        data-id={hasId ? String(Math.trunc(numericId)) : undefined}
                                        data-title={e.name ?? 'Untitled'}
                                        data-eraId={idAttr}
                                        data-era-name={eraName}
                                        data-track-length={e.duration ?? e.trackLength ?? 0}
                                        data-cover-version={coverVersion}
                                        aria-label={`Play ${e.name ?? 'Untitled'}`}
                                        title="Play"
                                        disabled={!hasId}
                                    >
                                        <Icon name="play" />
                                    </button>
                                    {hasId ? (
                                        <a
                                            class="download-song"
                                            href={apiUrl(apiBaseUrl, `/songs/${Math.trunc(numericId)}/download`)}
                                            aria-label={`Download ${e.name ?? 'Untitled'}`}
                                            title="Download original file"
                                            download
                                        >
                                            <Icon name="download" />
                                        </a>
                                    ) : null}
                                </div>
                            ) : e.url ? (
                                <a
                                    class="source-link"
                                    href={e.url}
                                    target="_blank"
                                    rel="noreferrer"
                                    aria-label={`Open source for ${e.name ?? 'Untitled'}`}
                                    title={unavailableLabel(e)}
                                >
                                    <Icon name="link" />
                                </a>
                            ) : (
                                <span class="song-unavailable" title={unavailableLabel(e)} aria-hidden="true">
                                    —
                                </span>
                            )}
                        </td>
                        <th scope="row" class="title" data-label="Title">{e.name}</th>
                        <td class={`notes-cell${blankClass(notes)}`} data-label="Notes">
                            {notes ? (
                                <>
                                    <span class="notes-text" data-notes-text>{notes}</span>
                                    <button
                                        type="button"
                                        class="notes-toggle"
                                        data-notes-toggle
                                        aria-expanded="false"
                                        hidden
                                    >
                                        More
                                    </button>
                                </>
                            ) : null}
                        </td>
                        <td class={`quality${blankClass(quality)}`} data-label="Quality">{quality}</td>
                        <td class={`availableLength${blankClass(length)}`} data-label="Available Length">
                            {length}
                        </td>
                        <td class={`fileDate${blankClass(fileDate)}`} data-label="File Date">{fileDate}</td>
                        <td class={`leakDate${blankClass(leakDate)}`} data-label="Leak Date">{leakDate}</td>
                    </tr>
                );
            })
        }
        </tbody>
    </table>
    </div>
    <p class="song-empty" data-song-empty hidden>
        No songs on this page match your filter — press <strong>Search</strong> to look through the whole era.
    </p>
</section>

<script is:inline data-astro-rerun>
    (() => {
        const normalize = (value) => value.trim().replace(/\s+/g, " ").toLocaleLowerCase();

        document.querySelectorAll("[data-song-list]").forEach((songList) => {
            if (songList.dataset.searchBound === "true") return;

            const input = songList.querySelector("[data-song-search]");
            const count = songList.querySelector("[data-song-count]");
            const empty = songList.querySelector("[data-song-empty]");
            const form = songList.querySelector("[data-song-search-form]");
            const rows = [...songList.querySelectorAll(".song-row")];

            if (!(input instanceof HTMLInputElement) || !count || !empty) return;

            songList.dataset.searchBound = "true";
            const totalOnPage = rows.length;

            const updateResults = () => {
                const query = normalize(input.value);
                let visible = 0;

                rows.forEach((row) => {
                    const haystack = row.dataset.searchText ?? row.dataset.songName ?? "";
                    const matches = !query || haystack.includes(query);

                    row.hidden = !matches;
                    if (matches) visible += 1;
                });

                count.textContent = query
                    ? `${visible} of ${totalOnPage} on this page — use Search for the whole era`
                    : `${totalOnPage} ${totalOnPage === 1 ? "song" : "songs"}`;
                empty.hidden = visible !== 0;
                measureNotes();
            };

            // Long notes are clamped to two lines; the toggle is only offered
            // when the text really overflows, and only after JS has measured it.
            const measureNotes = () => {
                rows.forEach((row) => {
                    if (row.hidden) return;
                    const text = row.querySelector("[data-notes-text]");
                    const toggle = row.querySelector("[data-notes-toggle]");
                    if (!(text instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;
                    const expanded = text.dataset.expanded === "true";
                    text.dataset.clamped = "true";
                    if (expanded) {
                        toggle.hidden = false;
                        return;
                    }
                    const overflows = text.scrollHeight > text.clientHeight + 1;
                    toggle.hidden = !overflows;
                    if (!overflows) delete text.dataset.clamped;
                });
            };

            songList.addEventListener("click", (event) => {
                const target = event.target;
                if (!(target instanceof Element)) return;
                const toggle = target.closest("[data-notes-toggle]");
                if (!(toggle instanceof HTMLButtonElement)) return;
                const text = toggle.parentElement?.querySelector("[data-notes-text]");
                if (!(text instanceof HTMLElement)) return;

                const expanded = text.dataset.expanded === "true";
                if (expanded) {
                    delete text.dataset.expanded;
                    text.dataset.clamped = "true";
                } else {
                    text.dataset.expanded = "true";
                    delete text.dataset.clamped;
                }
                toggle.textContent = expanded ? "More" : "Less";
                toggle.setAttribute("aria-expanded", String(!expanded));
            });

            // Selecting a filter submits the form so the whole era is re-queried.
            songList.querySelectorAll("[data-song-select]").forEach((select) => {
                if (!(select instanceof HTMLSelectElement) || !(form instanceof HTMLFormElement)) return;
                select.addEventListener("change", () => form.requestSubmit());
            });

            if (form instanceof HTMLFormElement) {
                // GET submit preserves ?q= server-side search and resets to page 1.
                form.addEventListener("submit", () => {
                    try {
                        const url = new URL(form.action || window.location.href);
                        url.searchParams.delete("page");
                        form.action = url.pathname + url.search;
                    } catch {
                        // Fall back to default form submission.
                    }
                });
            }

            let resizeTimer;
            window.addEventListener("resize", () => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(measureNotes, 150);
            });

            updateResults();
            requestAnimationFrame(measureNotes);
        });
    })();
</script>

<style>
    .song-search {
        margin-inline: 1vh;
        margin-bottom: 0.8rem;
    }
    .song-search > label {
        display: block;
        margin-bottom: 0.35rem;
        color: color-mix(in srgb, var(--dominantColor) 30%, white);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    .song-search__controls {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
    }
    .song-search input,
    .song-search__select {
        box-sizing: border-box;
        min-width: 0;
        width: 100%;
        padding: 0.7rem 0.85rem;
        border: 2px solid
            color-mix(in srgb, var(--dominantColor) 50%, transparent);
        border-radius: 0.6rem;
        outline: none;
        background: color-mix(in srgb, var(--dominantColor) 12%, #111);
        color: white;
        font: inherit;
        transition:
            border-color 120ms ease,
            box-shadow 120ms ease;
    }
    .song-search input {
        flex: 1 1 12rem;
        width: auto;
    }
    .song-search__select-group {
        display: flex;
        flex: none;
        flex-direction: column;
        align-items: stretch;
        gap: 0.25rem;
    }
    .song-search__select {
        flex: none;
        width: auto;
        min-width: 9rem;
        max-width: 13rem;
        color-scheme: dark;
        cursor: pointer;
    }
    .song-search .song-search__control-label {
        flex: none;
        margin: 0;
        color: color-mix(in srgb, var(--dominantColor) 30%, white);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    .song-search input::placeholder {
        color: color-mix(in srgb, var(--dominantColor) 20%, #aaa);
    }
    .song-search input:focus-visible,
    .song-search__select:focus-visible {
        border-color: color-mix(
            in srgb,
            var(--dominantColor) 75%,
            white
        );
        box-shadow: 0 0 0 3px
            color-mix(in srgb, var(--dominantColor) 25%, transparent);
    }
    .song-search__submit {
        flex: none;
        padding: 0.7rem 1rem;
        border: 2px solid
            color-mix(in srgb, var(--dominantColor) 50%, transparent);
        border-radius: 0.6rem;
        background: color-mix(in srgb, var(--dominantColor) 25%, #222);
        color: white;
        cursor: pointer;
        font: inherit;
        font-size: 0.85rem;
        font-weight: 700;
    }
    .song-search__submit:hover,
    .song-search__submit:focus-visible {
        background: color-mix(in srgb, var(--dominantColor) 40%, #333);
    }
    .song-search__submit:focus-visible {
        border-color: color-mix(
            in srgb,
            var(--dominantColor) 75%,
            white
        );
        box-shadow: 0 0 0 3px
            color-mix(in srgb, var(--dominantColor) 25%, transparent);
        outline: none;
    }
    .song-search__clear {
        flex: none;
        color: #ccc;
        font-size: 0.85rem;
    }
    .song-search__hint {
        margin: 0.4rem 0 0;
        color: color-mix(in srgb, var(--dominantColor) 25%, #ccc);
        font-size: 0.78rem;
    }
    .song-count {
        flex: none;
        min-width: 7rem;
        margin: 0;
        color: color-mix(in srgb, var(--dominantColor) 25%, #ccc);
        font-size: 0.85rem;
        text-align: right;
        white-space: normal;
    }
    .song-empty {
        margin: 1rem 1vh 0.25rem;
        color: color-mix(in srgb, var(--dominantColor) 25%, #ccc);
        text-align: center;
    }
    .song-empty[hidden],
    .song-row[hidden] {
        display: none;
    }
    .song-row:target th,
    .song-row:target td {
        background-color: color-mix(
            in srgb,
            var(--dominantColor) 35%,
            #242424
        );
    }
    .song-row[data-playing='true'] th,
    .song-row[data-playing='true'] td {
        background-color: color-mix(
            in srgb,
            var(--dominantColor) 32%,
            #1f1f1f
        );
    }
    .song-row[data-playing='true'] .title::after {
        content: ' ♪';
        color: color-mix(in oklab, var(--dominantColor) 20%, white);
    }
    .song-list {
        min-width: 0;
        width: calc(100% + 2vh);
        margin-inline: -1vh;
    }
    .song-table-wrap {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
    }
    @media (max-width: 640px) {
        .song-search__controls {
            align-items: stretch;
            flex-direction: column;
            gap: 0.35rem;
        }
        /* In a column flex container the input's 12rem basis becomes a *height*. */
        .song-search input {
            flex: 0 0 auto;
        }
        .song-search__select-group {
            width: 100%;
        }
        .song-search__select {
            width: 100%;
            max-width: none;
        }
        .song-count {
            min-width: 0;
            text-align: left;
        }
    }
    .song-actions-cell {
        width: 4.5rem;
    }
    .song-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.2rem;
    }
    .play-song,
    .download-song,
    .source-link {
        color: color-mix(in oklab, var(--dominantColor) 10%, white);
        cursor: pointer;
        display: inline-grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        border-radius: 999px;
        transition:
            color 120ms ease,
            background-color 120ms ease;
        background-color: transparent;
        border: 0;
    }
    .play-song svg,
    .download-song svg,
    .source-link svg {
        width: 1.25em;
        height: 1.25em;
    }
    .download-song,
    .source-link {
        text-decoration: none;
    }
    .play-song:hover,
    .play-song:focus-visible,
    .download-song:hover,
    .download-song:focus-visible,
    .source-link:hover,
    .source-link:focus-visible {
        color: white;
        background-color: color-mix(
            in srgb,
            var(--dominantColor) 42%,
            transparent
        );
        outline: none;
    }
    .play-song:disabled {
        cursor: default;
        opacity: 0.35;
    }
    .song-unavailable {
        display: inline-block;
        width: 2rem;
        color: color-mix(in srgb, var(--dominantColor) 20%, #888);
        text-align: center;
    }
    .leakDate,
    .quality,
    .availableLength,
    .fileDate {
        text-align: center;
        font-size: 0.9rem;
    }
    th {
        background-color: color-mix(
            in srgb,
            var(--dominantColor) 25%,
            transparent
        );
    }
    th,
    td {
        border: 2px solid
            color-mix(in srgb, var(--dominantColor) 50%, transparent);
    }
    th {
        padding: 0.5vh;
    }
    td {
        padding: 0.75vh;
    }
    .notes-cell {
        line-height: 1.45;
    }
    .notes-text {
        overflow-wrap: anywhere;
    }
    /* The title is the anchor of the row, not a headline: left-aligned and the
       same weight class as the rest of the table. */
    th.title {
        text-align: left;
        font-size: 0.95rem;
        font-weight: 600;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }
    /* Only applied by script once it knows the text overflows. */
    .notes-text[data-clamped='true'] {
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        line-clamp: 3;
    }
    .notes-toggle {
        margin-top: 0.15rem;
        padding: 0.1rem 0.4rem;
        border: 0;
        border-radius: 0.4rem;
        background: transparent;
        color: color-mix(in oklab, var(--dominantColor) 25%, white);
        cursor: pointer;
        font: inherit;
        font-size: 0.72rem;
        font-weight: 700;
        text-decoration: underline;
    }
    .notes-toggle:hover,
    .notes-toggle:focus-visible {
        background: color-mix(in srgb, var(--dominantColor) 35%, transparent);
        color: white;
        outline: none;
    }
    .notes-toggle[hidden] {
        display: none;
    }
    table {
        width: 100%;
        min-width: 56rem;
        margin: 0;
        border-collapse: collapse;
        border-spacing: 0;
        /* Fixed columns keep the widths stable: with the auto layout the clamped
           notes contribute almost no intrinsic width and the title column takes
           everything left over (it used to render 680px wide against 240px). */
        table-layout: fixed;
    }
    thead th:nth-child(1) {
        width: 7.5%;
    }
    thead th:nth-child(2) {
        width: 26%;
    }
    thead th:nth-child(3) {
        width: 31%;
    }
    /* These two columns read left-aligned in the body, so their headers do too. */
    thead th:nth-child(2),
    thead th:nth-child(3) {
        text-align: left;
    }
    thead th:nth-child(4) {
        width: 11%;
    }
    thead th:nth-child(5) {
        width: 11%;
    }
    thead th:nth-child(6) {
        width: 6.75%;
    }
    thead th:nth-child(7) {
        width: 6.75%;
    }
    thead tr:first-child th {
        border-top: none;
    }
    tbody tr:last-child th,
    tbody tr:last-child td {
        border-bottom: none;
    }
    th:first-child,
    td:first-child {
        border-left: none;
    }
    th:last-child,
    td:last-child {
        border-right: none;
    }

    /* Phones get one card per song instead of a 900px-wide scroller. */
    @media (max-width: 640px) {
        .song-table-wrap {
            overflow-x: visible;
        }
        table {
            min-width: 0;
            border-collapse: separate;
        }
        thead {
            display: none;
        }
        tbody tr {
            display: flex;
            flex-direction: column;
            margin-bottom: 0.6rem;
            padding: 0.55rem 0.7rem;
            border: 2px solid
