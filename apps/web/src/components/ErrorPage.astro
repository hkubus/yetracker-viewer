---
/**
 * A complete error page (layout included) for 400, 404, 500 and 503 responses. The status code itself is set by
 * the page that renders this (`Astro.response.status`), before rendering starts.
 */
import Layout from '../layouts/Layout.astro';
import AlertIcon from './icons/AlertIcon.astro';
import ArrowLeftIcon from './icons/ArrowLeftIcon.astro';
import CloudOffIcon from './icons/CloudOffIcon.astro';
import LinkIcon from './icons/LinkIcon.astro';
import RefreshIcon from './icons/RefreshIcon.astro';
import SearchIcon from './icons/SearchIcon.astro';

type ErrorStatus = 400 | 404 | 500 | 503;

interface Props {
  status: ErrorStatus;
  /** Overrides the default heading of the status. */
  heading?: string;
  /** Overrides the default explanation of the status. */
  message?: string;
  /** Extra detail shown under the explanation (e.g. which parameter was rejected). */
  detail?: string;
  /** Target of the "Try again" action on 500/503 pages. Default: the current URL. */
  retryHref?: string;
  /** A more specific way out than the home page, e.g. the first page of an era. */
  secondaryAction?: { href: string; label: string };
}

const COPY: Record<ErrorStatus, { heading: string; message: string }> = {
  400: {
    heading: 'This link is not valid',
    message: 'Part of the address could not be understood, so there is nothing to show for it.',
  },
  404: {
    heading: 'Page not found',
    message: 'There is nothing at this address. The link may be mistyped, or point to something that is gone.',
  },
  500: {
    heading: 'Something went wrong',
    message: 'The page could not be displayed because of an error on the site. Trying again usually helps.',
  },
  503: {
    heading: 'The catalog is unavailable right now',
    message: 'The page could not load its data from the catalog service. It should be back in a moment.',
  },
};
const ICONS = { 400: LinkIcon, 404: SearchIcon, 500: AlertIcon, 503: CloudOffIcon } as const;

const { status, heading, message, detail, retryHref = '', secondaryAction } = Astro.props;
const copy = COPY[status];
const title = heading ?? copy.heading;
const canRetry = status >= 500;
const Icon = ICONS[status];
---

<Layout title={`${title} | Ye Tracker`} description={message ?? copy.message} noindex>
  <div class="error-page">
    <span class="error-page__icon" aria-hidden="true"><Icon size="1.75rem" /></span>
    <p class="error-page__code">Error {status}</p>
    <h1>{title}</h1>
    <p class="error-page__message">{message ?? copy.message}</p>
    {detail && <p class="error-page__detail">{detail}</p>}
    <p class="error-page__actions">
      {
        canRetry && (
          <a class="error-page__action error-page__action--primary" href={retryHref}>
            <RefreshIcon class="error-page__action-icon" />
            Try again
          </a>
        )
      }
      {
        secondaryAction && (
          <a
            class:list={['error-page__action', { 'error-page__action--primary': !canRetry }]}
            href={secondaryAction.href}
          >
            {secondaryAction.label}
          </a>
        )
      }
      <a class:list={['error-page__action', { 'error-page__action--primary': !canRetry && !secondaryAction }]} href="/">
        <ArrowLeftIcon class="error-page__action-icon" />
        Back to all eras
      </a>
    </p>
  </div>
</Layout>

<style>
  .error-page {
    display: flex;
    box-sizing: border-box;
    width: 100%;
    max-width: 36rem;
    /* Centered on the first screen, but never taller than a phone's: the actions stay within reach. */
    min-height: min(70vh, 36rem);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-inline: auto;
    padding: var(--space-7) var(--page-gutter) var(--space-6);
    color: var(--color-text);
    text-align: center;
  }
  .error-page__icon {
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    margin-bottom: var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    color: var(--color-text-secondary);
    background: var(--color-surface);
  }
  .error-page__code {
    margin: 0 0 var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  h1 {
    margin: 0;
    font-size: var(--font-size-2xl);
    font-weight: 700;
    line-height: var(--line-height-tight);
  }
  .error-page__message {
    margin: var(--space-3) 0 0;
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
    text-wrap: pretty;
  }
  .error-page__detail {
    box-sizing: border-box;
    width: 100%;
    margin: var(--space-4) 0 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    background: var(--color-surface);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
    text-wrap: pretty;
  }
  .error-page__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin: var(--space-5) 0 0;
  }
  .error-page__action {
    display: inline-flex;
    box-sizing: border-box;
    min-height: var(--tap-size);
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-text);
    background: var(--color-surface-raised);
    font-size: var(--font-size-md);
    font-weight: 600;
    line-height: var(--line-height-tight);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }
  .error-page__action--primary {
    border-color: var(--color-accent);
    color: var(--color-on-accent);
    background: var(--color-accent);
  }
  .error-page__action :global(.error-page__action-icon) {
    flex: none;
    width: 1.125em;
    height: 1.125em;
  }
  @media (hover: hover) {
    .error-page__action:hover {
      border-color: var(--color-border-control);
      background: var(--color-surface-hover);
    }
    .error-page__action--primary:hover {
      border-color: var(--color-text);
      background: var(--color-text);
    }
  }
  .error-page__action:active {
    transform: scale(0.98);
  }
  /* Phones: full-width buttons, stacked, the primary one first. */
  @media (max-width: 30rem) {
    .error-page__actions {
      width: 100%;
      flex-direction: column;
    }
    .error-page__action {
      width: 100%;
    }
  }
</style>
