---
/**
 * "Recently leaked": the newest playable songs, each with a play button for the player (see the play-button
 * attributes in `utils/songDisplay.ts`). The page fetches the songs and passes them in, so a failure can mark the
 * whole response uncacheable before rendering starts.
 */
import { themeStyle } from '../utils/color';
import { formatCatalogDate, isoDate } from '../utils/dates';
import {
  DEFAULT_ERA_PAGE_SIZE,
  type EraDisplayInfo,
  playButtonAttributes,
  positiveInteger,
  type SearchSongPayload,
  songHref,
  songTextLines,
} from '../utils/songDisplay';
import PauseIcon from './icons/PauseIcon.astro';
import PlayIcon from './icons/PlayIcon.astro';

interface Props {
  songs: SearchSongPayload[];
  /** The request failed: say so instead of silently dropping the section. */
  failed?: boolean;
  /** Era data by id, for payloads that lack their era's name, color or cover fields. */
  eras?: ReadonlyMap<number, EraDisplayInfo>;
  eraPageSize?: number;
}

const { songs, failed = false, eras, eraPageSize = DEFAULT_ERA_PAGE_SIZE } = Astro.props;

const items = songs.flatMap((song) => {
  const eraId = positiveInteger(song.eraId);
  const era = eraId === null ? undefined : eras?.get(eraId);
  const play = playButtonAttributes(song, era);
  // The strip promises tracks that play right now.
  if (!play || song.playable === false) return [];
  const { title, details } = songTextLines(song);
  const eraName = play['data-era-name'] || 'Unknown era';
  const leakDate = isoDate(song.leakDate, song.leakDatePrecision);
  return [
    {
      id: play['data-id'],
      title,
      details: details.join(' · '),
      fullName: [title, ...details].join(' · '),
      href: songHref(song, eraPageSize),
      eraName,
      leakDate,
      leakDateText: leakDate ? formatCatalogDate(song.leakDate, song.leakDatePrecision) : 'Leak date unknown',
      style: themeStyle(play['data-dominant-color'], '--leak'),
      play,
    },
  ];
});
---

{
  failed || items.length > 0 ? (
    <section class="recent" aria-labelledby="recent-heading">
      <div class="recent__head">
        <h2 id="recent-heading">Recently leaked</h2>
        {items.length > 0 ? <p>Newest tracks you can play right now.</p> : null}
      </div>
      {items.length > 0 ? (
        <ul class="recent__list" data-play-scope>
          {items.map((item) => (
            <li class="recent__item" data-play-row data-song-id={item.id} style={item.style}>
              <div class="recent__text">
                {item.href ? (
                  <a class="recent__title" href={item.href} title={item.fullName}>
                    {item.title}
                  </a>
                ) : (
                  <span class="recent__title" title={item.fullName}>
                    {item.title}
                  </span>
                )}
                {item.details ? (
                  <p class="recent__details" title={item.details}>
                    {item.details}
                  </p>
                ) : null}
                <p class="recent__meta">
                  <span class="recent__era" title={item.eraName}>
                    {item.eraName}
                  </span>
                  <span aria-hidden="true">·</span>
                  <time class="recent__date" datetime={item.leakDate}>
                    {item.leakDateText}
                  </time>
                </p>
              </div>
              <button class="recent__play" type="button" {...item.play} aria-label={`Play ${item.title}`}>
                <PlayIcon class="play-icon" />
                <PauseIcon class="pause-icon" />
              </button>
            </li>
          ))}
        </ul>
      ) : (
        <p class="recent__unavailable">Recently leaked tracks couldn’t be loaded right now.</p>
      )}
    </section>
  ) : null
}

<style>
  .recent {
    margin: clamp(0.75rem, 1.5vw, 1.5rem);
    margin-bottom: 0;
  }
  .recent__head {
    display: flex;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.6rem;
  }
  .recent__head h2 {
    margin: 0;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  .recent__head p,
  .recent__unavailable {
    margin: 0;
    color: #a3a3a3;
    font-size: 0.8rem;
  }
  .recent__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .recent__item {
    display: flex;
    box-sizing: border-box;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.55rem 0.6rem 0.55rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--leak-accent) 40%, var(--leak-surface));
    border-left: 4px solid var(--leak-accent);
    border-radius: 0.6rem;
    color: var(--leak-text);
    background: var(--leak-background);
  }
  .recent__item[data-playing='true'] {
    border-color: var(--leak-accent);
    background: var(--leak-surface);
  }
  .recent__text {
    min-width: 0;
  }
  .recent__title {
    display: -webkit-box;
    overflow: hidden;
    color: var(--leak-text);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  a.recent__title:hover {
    text-decoration: underline;
  }
  a.recent__title:focus-visible {
    outline: 2px solid var(--focus-ring-color, #fff);
    outline-offset: 2px;
    border-radius: 2px;
  }
  .recent__details,
  .recent__meta {
    margin: 0.15rem 0 0;
    overflow: hidden;
    font-size: 0.76rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .recent__details {
    color: var(--leak-muted-text);
  }
  .recent__meta {
    display: flex;
    gap: 0.35rem;
    color: var(--leak-muted-text);
  }
  .recent__era {
    min-width: 0;
    overflow: hidden;
    color: var(--leak-accent-text);
    text-overflow: ellipsis;
  }
  .recent__date {
    flex: none;
  }
  .recent__play {
    display: inline-grid;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 999px;
    color: var(--leak-on-accent);
    background: var(--leak-accent);
    cursor: pointer;
  }
  .recent__play :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }
  /* The player sets aria-pressed="true" on the current song's button while it plays. */
  .recent__play :global(.play-icon) {
    margin-left: 0.1rem;
  }
  .recent__play :global(.pause-icon),
  .recent__play[aria-pressed='true'] :global(.play-icon) {
    display: none;
  }
  .recent__play[aria-pressed='true'] :global(.pause-icon) {
    display: block;
  }
  .recent__play:hover {
    color: var(--leak-background);
    background: var(--leak-text);
  }
  .recent__play:focus-visible {
    outline: 2px solid var(--focus-ring-color, #fff);
    outline-offset: 2px;
  }
  @media (forced-colors: active) {
    .recent__play {
      border: 1px solid ButtonText;
    }
  }
</style>
