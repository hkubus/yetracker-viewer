---
const apiBaseUrl = Astro.props.apiBaseUrl as string;
---

<div
    class="player"
    hidden
    role="region"
    aria-label="Audio player"
    transition:name="audio-player"
    transition:persist
    transition:animate="none"
    data-api-base-url={apiBaseUrl}
>
    <audio id="audio" preload="metadata"></audio>
    <div class="data">
        <div class="info">
            <img alt="" width="48" height="48" data-player-cover />
            <div class="metadata">
                <p class="eyebrow">Now playing</p>
                <p class="title"></p>
            </div>
        </div>
        <div class="controls" aria-label="Playback controls">
            <label class="quality-control">
                <span>Quality</span>
                <select id="quality" aria-label="Playback quality">
                    <option value="">Original</option>
                    <option value="64">64 kbps</option>
                    <option value="128" selected>128 kbps</option>
                    <option value="192">192 kbps</option>
                    <option value="256">256 kbps</option>
                    <option value="320">320 kbps</option>
                </select>
            </label>
            <button id="play" type="button" aria-label="Play" title="Play">
                <svg
                    class="play-icon"
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                >
                    <path d="M7 5.5v13L18.5 12z"></path>
                </svg>
                <svg
                    class="pause-icon"
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                >
                    <rect x="6.5" y="5.5" width="4" height="13" rx="1.1"></rect>
                    <rect x="13.5" y="5.5" width="4" height="13" rx="1.1"></rect>
                </svg>
            </button>
        </div>
    </div>
    <p class="player-error" data-player-error hidden role="status"></p>
    <div class="progress">
        <p id="timestamp" aria-live="polite">0:00</p>
        <input type="range" id="progressBar" value="0" min="0" step="0.1" aria-label="Track progress" />
        <p id="duration">0:00</p>
    </div>
</div>
<script>
    import { convertDuration } from "../utils/convertDuration";
    type PlayerElement = HTMLElement & { dataset: DOMStringMap };

    const mainElement = document.querySelector(".player") as PlayerElement;

    if (!mainElement.dataset.playerBound) {
        mainElement.dataset.playerBound = "true";

        const HEX_PATTERN = /^#?[\da-f]{6}$/i;
        const FALLBACK_COLOR = "#666666";

        const player = mainElement.querySelector("#audio") as HTMLAudioElement;
        const progressBar = mainElement.querySelector("#progressBar") as HTMLInputElement;
        const durationEl = mainElement.querySelector("#duration") as HTMLParagraphElement;
        const timestampEl = mainElement.querySelector("#timestamp") as HTMLParagraphElement;
        const imgEl = mainElement.querySelector("img") as HTMLImageElement;
        const title = mainElement.querySelector(".title") as HTMLElement;
        const playButton = mainElement.querySelector("#play") as HTMLButtonElement;
        const qualitySelect = mainElement.querySelector("#quality") as HTMLSelectElement;
        const errorEl = mainElement.querySelector("[data-player-error]") as HTMLParagraphElement | null;
        const apiBaseUrl = mainElement.dataset.apiBaseUrl?.replace(/\/+$/, "") ?? "";
        let catalogDuration = 0;
        let currentSongId: number | null = null;
        let streamRevision = 0;
        let previousSrc = "";

        function sanitizeColor(value: unknown): string {
            const raw = String(value ?? "").trim().replace(/^#/, "");
            return HEX_PATTERN.test(raw) ? `#${raw}` : FALLBACK_COLOR;
        }

        function showError(message: string) {
            if (!errorEl) return;
            errorEl.textContent = message;
            errorEl.hidden = false;
        }

        function hideError() {
            if (!errorEl) return;
            errorEl.textContent = "";
            errorEl.hidden = true;
        }

        function getStreamUrl(id: number) {
            const baseUrl = `${apiBaseUrl}/songs/${id}/stream`;
            return qualitySelect.value
                ? `${baseUrl}?quality=${qualitySelect.value}`
                : baseUrl;
        }

        function startPlayback() {
            const attempt = player.play();
            if (attempt && typeof attempt.catch === "function") {
                attempt.catch((error: unknown) => {
                    showError(
                        error instanceof DOMException && error.name === "NotAllowedError"
                            ? "Playback was blocked by the browser. Press play to try again."
                            : "Playback failed. The audio may be unavailable.",
                    );
                });
            }
        }

        function describeTime(value: number): string {
            if (!Number.isFinite(value) || value < 0) return "unknown position";
            return `${convertDuration(value)} elapsed`;
        }

        function updateDuration() {
            const duration = Number.isFinite(player.duration) ? player.duration : catalogDuration;
            progressBar.max = String(duration || 0);
            progressBar.setAttribute("aria-valuetext", describeTime(Number(progressBar.value)));
            durationEl.innerText = duration > 0 ? convertDuration(duration) : "—";
        }

        function getCoverUrl(eraId: number, coverVersion: string) {
            if (!Number.isFinite(eraId)) return "";
            const base = `${apiBaseUrl}/eras/${Math.trunc(eraId)}/cover`;
            const version = (coverVersion ?? "").trim();
            // No Date.now() cache-busting: reuse the catalog cover version,
            // or omit ?v entirely to use the canonical cover.
            return version ? `${base}?v=${encodeURIComponent(version)}` : base;
        }

        function playSong({
            id,
            name,
            eraId,
            trackLength,
            accentColor,
            coverVersion,
        }: {
            id: number;
            name: string;
            eraId: number;
            trackLength: number;
            accentColor: string;
            coverVersion: string;
        }) {
            if (!Number.isFinite(id)) {
                showError("Cannot play this song: missing song id.");
                return;
            }
            currentSongId = Math.trunc(id);
            previousSrc = "";
            streamRevision += 1;
            const revision = streamRevision;
            qualitySelect.disabled = false;
            hideError();
            mainElement.hidden = false;
            mainElement.style.setProperty("--dominantColor", sanitizeColor(accentColor));
            const coverUrl = getCoverUrl(eraId, coverVersion);
            if (coverUrl) {
                imgEl.src = coverUrl;
            } else {
                imgEl.removeAttribute("src");
            }
            imgEl.alt = name ? `Cover art for ${name}` : "";
            title.textContent = name;
            catalogDuration = Number.isFinite(trackLength) && trackLength > 0 ? trackLength : 0;
            progressBar.value = "0";
            progressBar.setAttribute("aria-valuetext", describeTime(0));
            timestampEl.innerText = "0:00";
            updateDuration();
            player.src = getStreamUrl(currentSongId);
            player.load();
            startPlayback();

            if (!(trackLength > 0)) {
                void fetch(`${apiBaseUrl}/songs/${currentSongId}/duration`)
                    .then((response) => (response.ok ? response.json() : null))
                    .then((data: { duration?: number } | null) => {
                        if (revision !== streamRevision) return;
                        if (player.src.includes(`/songs/${currentSongId}/`) && data?.duration) {
                            const d = Number(data.duration);
                            if (Number.isFinite(d) && d > 0) {
                                catalogDuration = d;
                                updateDuration();
                            }
                        }
                    })
                    .catch(() => undefined);
            }
        }

        player.addEventListener("error", () => {
            // Initial load failure (not a quality switch — that has its own handler).
            if (!player.currentSrc || player.currentSrc === previousSrc) return;
            if (currentSongId === null) return;
            qualitySelect.disabled = false;
            showError("Audio failed to load. The file may be missing or unavailable.");
        });

        qualitySelect.addEventListener("change", () => {
            if (currentSongId === null) return;

            const revision = ++streamRevision;
            const resumeAt = player.currentTime;
            const shouldResume = !player.paused;
            const fallbackSrc = player.currentSrc || previousSrc;
            qualitySelect.disabled = true;
            hideError();

            const restorePlayback = () => {
                if (revision !== streamRevision) return;

                player.removeEventListener("error", handleStreamError);
                qualitySelect.disabled = false;
                if (Number.isFinite(resumeAt) && resumeAt > 0) {
                    try {
                        player.currentTime = resumeAt;
                    } catch {
                        // Some streamed formats only become seekable after buffering.
                    }
                }
                if (shouldResume) startPlayback();
            };

            const handleStreamError = () => {
                player.removeEventListener("loadedmetadata", restorePlayback);
                if (revision !== streamRevision) return;
                // Restore the previous working stream instead of leaving a broken src.
                if (fallbackSrc && player.src !== fallbackSrc) {
                    player.src = fallbackSrc;
                    player.load();
                    if (shouldResume) startPlayback();
                }
                qualitySelect.disabled = false;
                showError("Quality switch failed. Restored the previous stream.");
            };

            player.addEventListener("loadedmetadata", restorePlayback, { once: true });
            player.addEventListener("error", handleStreamError, { once: true });
            previousSrc = fallbackSrc;
            player.src = getStreamUrl(currentSongId);
            player.load();
        });

        function setPlayButton(isPlaying: boolean) {
            playButton.dataset.playing = String(isPlaying);
            playButton.ariaLabel = isPlaying ? "Pause" : "Play";
            playButton.title = playButton.ariaLabel;
        }

        playButton.onclick = () => {
            if (player.paused) startPlayback();
            else player.pause();
        };

        document.addEventListener("keydown", (event) => {
            if (mainElement.hidden) return;
            if (
                !["Space", "ArrowLeft", "ArrowRight"].includes(event.code) ||
                (event.code === "Space" && event.repeat) ||
                !player.currentSrc
            ) {
                return;
            }

            const target = event.target;
            if (target instanceof HTMLElement) {
                if (target.isContentEditable) return;
                // Don't hijack Space/Arrows when focus is on interactive elements,
                // otherwise Space would double-toggle (keydown + button click).
                if (
                    target.closest(
                        "button, a, input, textarea, select, details, [role='button'], [role='textbox'], .play-song",
                    )
                ) {
                    return;
                }
            }

            event.preventDefault();
            if (event.code === "Space") {
                if (player.paused) startPlayback();
                else player.pause();
                return;
            }

            const progressDuration = Number(progressBar.max);
            const duration =
                progressDuration > 0
                    ? progressDuration
                    : Number.isFinite(player.duration)
                      ? player.duration
                      : Number.POSITIVE_INFINITY;
            const offset = event.code === "ArrowRight" ? 5 : -5;
            player.currentTime = Math.min(duration, Math.max(0, player.currentTime + offset));
        });

        document.addEventListener("click", (event) => {
            if (!(event.target instanceof Element)) return;
            const button = event.target.closest<HTMLButtonElement>(".play-song");
            if (!button) return;

            const { id, title: name, eraid, trackLength, coverVersion } = button.dataset;
            const songId = Number(id);
            if (!id || !Number.isFinite(songId)) return;
            if (!name) return;

            const eraId = eraid != null && eraid !== "" ? Number(eraid) : NaN;
            const length = Number(trackLength);
            const rawAccent = window.getComputedStyle(button).getPropertyValue("--dominantColor");
            playSong({
                id: songId,
                name,
                eraId,
                trackLength: Number.isFinite(length) ? length : 0,
                accentColor: rawAccent,
                coverVersion: (coverVersion ?? "").trim(),
            });
        });

        player.addEventListener("play", () => {
            hideError();
            setPlayButton(true);
        });
        player.addEventListener("pause", () => setPlayButton(false));
        player.addEventListener("loadedmetadata", () => {
            updateDuration();
        });
        player.addEventListener("timeupdate", () => {
            progressBar.value = String(player.currentTime);
            progressBar.setAttribute("aria-valuetext", describeTime(player.currentTime));
            timestampEl.innerText = convertDuration(player.currentTime);
        });
        progressBar.addEventListener("input", () => {
            const next = Number(progressBar.value);
            if (Number.isFinite(next)) player.currentTime = next;
            progressBar.setAttribute("aria-valuetext", describeTime(next));
        });
    }
</script>
<style>
    .player[hidden] {
        display: none;
    }
    .player {
        --player-text: color-mix(in oklab, var(--dominantColor) 16%, white);
        position: fixed;
        z-index: 10;
        left: 50%;
        bottom: max(0.75rem, env(safe-area-inset-bottom));
        box-sizing: border-box;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0.75rem;
        width: min(52rem, calc(100vw - 2rem));
        padding: 0.75rem 1rem;
        transform: translateX(-50%);
        border: 1px solid color-mix(in srgb, var(--dominantColor) 60%, transparent);
        border-radius: 1rem;
        box-shadow: 0 1rem 3rem rgb(0 0 0 / 35%);
        color: var(--player-text);
        background: color-mix(in oklab, var(--dominantColor) 40%, var(--bg-color) 60%);
    }
    .player-error {
        margin: 0;
        color: #ffb4a9;
        font-size: 0.8rem;
    }
    .player-error[hidden] {
        display: none;
    }
    .data {
        display: flex;
        min-width: 0;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }
    .info {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 0.75rem;
        img {
            width: 3rem;
            height: 3rem;
            flex: 0 0 auto;
            object-fit: cover;
            border-radius: 0.65rem;
            background: rgb(0 0 0 / 20%);
        }
        img:not([src]) {
            visibility: hidden;
        }
    }
    .metadata {
        min-width: 0;
    }
    .eyebrow,
    .title,
    .progress p {
        margin: 0;
    }
    .eyebrow {
        margin-bottom: 0.15rem;
        color: color-mix(in oklab, var(--player-text) 65%, transparent);
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    .title {
        overflow: hidden;
        color: var(--player-text);
        font-weight: 600;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .controls {
        display: flex;
        flex: 0 0 auto;
        align-items: center;
        gap: 0.65rem;
    }
    .quality-control {
        display: grid;
        gap: 0.2rem;
        color: color-mix(in oklab, var(--player-text) 68%, transparent);
        font-size: 0.58rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        line-height: 1;
        text-transform: uppercase;
    }
    .quality-control select {
        min-width: 5.75rem;
        border: 1px solid color-mix(in srgb, var(--player-text) 20%, transparent);
        border-radius: 0.6rem;
        padding: 0.42rem 0.55rem;
        color: var(--player-text);
        background: color-mix(in srgb, var(--player-text) 8%, transparent);
        cursor: pointer;
        font: inherit;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0;
        text-transform: none;
    }
    .quality-control select:hover,
    .quality-control select:focus-visible {
        border-color: color-mix(in srgb, var(--player-text) 65%, transparent);
        outline: none;
    }
    .quality-control select:disabled {
        cursor: wait;
        opacity: 0.65;
    }
    .controls button {
        display: grid;
        width: 2.75rem;
        height: 2.75rem;
        padding: 0;
        place-items: center;
        border: 0;
        border-radius: 999px;
        color: var(--bg-color);
        background: var(--player-text);
        cursor: pointer;
        font-size: 0.9rem;
        transition: transform 150ms ease, background-color 150ms ease;
    }
    .controls button:hover {
        transform: scale(1.06);
    }
    .controls button:focus-visible {
        outline: 3px solid color-mix(in srgb, var(--player-text) 80%, transparent);
        outline-offset: 3px;
    }
    .controls button svg {
        width: 1.5rem;
        height: 1.5rem;
        fill: currentColor;
    }
    .controls button .play-icon {
        transform: translateX(0.1rem);
    }
    .controls button .pause-icon,
    .controls button[data-playing="true"] .play-icon {
        display: none;
    }
    .controls button[data-playing="true"] .pause-icon {
        display: block;
    }
    .progress {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        color: color-mix(in oklab, var(--player-text) 75%, transparent);
        font-size: 0.75rem;
    }
    #progressBar {
        min-width: 0;
        width: 100%;
        height: 0.35rem;
        accent-color: var(--player-text);
        cursor: pointer;
    }
    @media (max-width: 32rem) {
        .player {
            bottom: 0;
            width: 100%;
            border-right: 0;
            border-bottom: 0;
            border-left: 0;
            border-radius: 1rem 1rem 0 0;
        }
        .progress {
            font-size: 0.7rem;
        }
    }
</style>
