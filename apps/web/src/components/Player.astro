---
/**
 * The site-wide audio player bar. Rendered once by the layout and persisted across ClientRouter navigations
 * (`transition:persist`), so playback continues from page to page. Behaviour lives in `src/scripts/player/`; song
 * lists talk to it only through the `data-play-*` attributes and the `yt:player-state` event (SPEC §6.2).
 */
import { ERA_PAGE_SIZE } from '../config';
import { themeStyle } from '../utils/color';
import CoverImage from './CoverImage.astro';
import CloseIcon from './icons/CloseIcon.astro';
import MuteIcon from './icons/MuteIcon.astro';
import NextIcon from './icons/NextIcon.astro';
import PauseIcon from './icons/PauseIcon.astro';
import PlayIcon from './icons/PlayIcon.astro';
import PreviousIcon from './icons/PreviousIcon.astro';
import VolumeIcon from './icons/VolumeIcon.astro';

interface Props {
  /** Browser-facing API base URL (runtime value). */
  apiBaseUrl: string;
}

const { apiBaseUrl } = Astro.props;
const qualities = [
  { value: '', label: 'Original' },
  { value: '64', label: '64 kbps' },
  { value: '128', label: '128 kbps' },
  { value: '192', label: '192 kbps' },
  { value: '256', label: '256 kbps' },
  { value: '320', label: '320 kbps' },
];
---

<section
  class="player"
  aria-label="Audio player"
  data-player-root
  data-api-base-url={apiBaseUrl}
  data-era-page-size={ERA_PAGE_SIZE}
  hidden
  style={themeStyle(null, '--player')}
  transition:name="audio-player"
  transition:persist
  transition:animate="none"
>
  <audio preload="metadata" data-player-audio></audio>
  <div class="player__info">
    <CoverImage eraId={0} eraName="" hasCover={false} size={96} class="player__cover" data-player-cover />
    <div class="player__meta">
      <p class="player__state" data-player-state>Paused</p>
      <p class="player__title" data-player-title></p>
      <a class="player__era" data-player-era hidden></a>
    </div>
  </div>
  <div class="player__controls" role="group" aria-label="Playback controls" data-player-controls>
    <button
      type="button"
      class="player__button"
      data-player-previous
      aria-label="Previous track"
      title="Previous track"
      aria-disabled="true"
    >
      <PreviousIcon />
    </button>
    <button type="button" class="player__button player__toggle" data-player-toggle aria-label="Play" title="Play">
      <PlayIcon class="player__play-icon" />
      <PauseIcon class="player__pause-icon" />
    </button>
    <button
      type="button"
      class="player__button"
      data-player-next
      aria-label="Next track"
      title="Next track"
      aria-disabled="true"
    >
      <NextIcon />
    </button>
    <div class="player__volume" data-player-volume-group>
      <button type="button" class="player__button" data-player-mute aria-label="Mute" aria-pressed="false" title="Mute">
        <VolumeIcon class="player__volume-icon" />
        <MuteIcon class="player__muted-icon" />
      </button>
      <input
        type="range"
        class="player__volume-slider"
        data-player-volume
        min="0"
        max="100"
        step="5"
        value="100"
        aria-label="Volume"
        aria-valuetext="100%"
      />
    </div>
    <label class="player__quality" data-player-quality-control>
      <span class="player__quality-label">Quality</span>
      <select data-player-quality>
        {qualities.map(({ value, label }) => <option value={value}>{label}</option>)}
      </select>
    </label>
  </div>
  <button type="button" class="player__button player__close" data-player-close aria-label="Close player" title="Close player">
    <CloseIcon />
  </button>
  <div class="player__progress">
    <span class="player__time" data-player-elapsed aria-hidden="true">0:00</span>
    <input
      type="range"
      class="player__seek"
      data-player-seek
      min="0"
      max="0"
      step="1"
      value="0"
      aria-label="Position"
      aria-valuetext="0:00"
    />
    <span class="player__time" data-player-duration aria-hidden="true">—</span>
  </div>
  <div class="player__error" data-player-error hidden>
    <p data-player-error-text></p>
    <button type="button" class="player__retry" data-player-retry>Retry</button>
  </div>
  <p class="player__notice" data-player-notice hidden></p>
  <div class="player__sr" aria-live="polite" data-player-announcer></div>
  <div class="player__sr" role="alert" data-player-alert></div>
</section>

<script>
  import '../scripts/player/index.ts';
</script>

<style>
  .player[hidden] {
    display: none;
  }

  .player {
    /* Minimum hit area of the smaller controls: 24px (WCAG 2.5.8), 44px on touch screens. */
    --player-target: 2.25rem;
    --player-toggle: 2.75rem;
    position: fixed;
    z-index: 10;
    left: 50%;
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    box-sizing: border-box;
    display: grid;
    grid-template-areas:
      'info controls close'
      'progress progress progress'
      'error error error';
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.35rem 1rem;
    width: min(64rem, calc(100vw - 2rem));
    padding: 0.75rem 0.75rem 0.6rem 1rem;
    transform: translateX(-50%);
    border: 1px solid var(--player-accent);
    border-radius: 1rem;
    box-shadow: 0 1rem 3rem rgb(0 0 0 / 45%);
    color: var(--player-text);
    background: var(--player-surface);
  }

  @media (pointer: coarse) {
    .player {
      --player-target: 2.75rem;
    }
  }

  .player :focus-visible {
    outline: 2px solid var(--player-focus-ring);
    outline-offset: 2px;
  }

  /* Track info */
  .player__info {
    grid-area: info;
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.75rem;
  }

  .player__cover {
    flex: 0 0 auto;
    width: 3rem;
    border-radius: 0.6rem;
  }

  .player__meta {
    min-width: 0;
  }

  .player__state,
  .player__title {
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    /* One line each, so a state change never resizes the bar. */
    white-space: nowrap;
  }

  .player__state {
    color: var(--player-muted-text);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .player__title {
    font-weight: 600;
  }

  .player__era {
    display: inline-block;
    max-width: 100%;
    overflow: hidden;
    vertical-align: top;
    color: var(--player-accent-text);
    font-size: 0.8rem;
    line-height: 1.5rem;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .player__era[hidden] {
    display: none;
  }

  .player__era:hover,
  .player__era:focus-visible {
    text-decoration: underline;
  }

  /* Controls */
  .player__controls {
    grid-area: controls;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .player__button {
    display: inline-grid;
    flex: 0 0 auto;
    box-sizing: border-box;
    width: var(--player-target);
    height: var(--player-target);
    padding: 0;
    place-items: center;
    border: 0;
    border-radius: 999px;
    color: var(--player-text);
    background: transparent;
    cursor: pointer;
    font-size: 1.2rem;
    transition: background-color 150ms ease;
  }

  .player__button:hover {
    background: color-mix(in srgb, var(--player-text) 14%, transparent);
  }

  .player__button[aria-disabled='true'] {
    cursor: default;
    opacity: 0.4;
  }

  .player__button[aria-disabled='true']:hover {
    background: transparent;
  }

  .player__toggle {
    width: var(--player-toggle);
    height: var(--player-toggle);
    color: var(--player-on-accent);
    background: var(--player-accent);
    font-size: 1.35rem;
  }

  .player__toggle:hover {
    background: color-mix(in srgb, var(--player-accent) 82%, var(--player-text));
  }

  .player__toggle .player__play-icon {
    /* The triangle's visual centre sits right of its box centre. */
    translate: 0.08em 0;
  }

  .player__toggle .player__pause-icon,
  .player__toggle[data-playing='true'] .player__play-icon,
  .player__button .player__muted-icon,
  .player__button[data-muted='true'] .player__volume-icon {
    display: none;
  }

  .player__toggle[data-playing='true'] .player__pause-icon,
  .player__button[data-muted='true'] .player__muted-icon {
    display: block;
  }

  .player__volume {
    display: flex;
    align-items: center;
    gap: 0.15rem;
  }

  .player__volume-slider,
  .player__seek {
    min-width: 0;
    height: 1.5rem;
    margin: 0;
    accent-color: var(--player-accent);
    cursor: pointer;
  }

  .player__volume-slider {
    width: 5.5rem;
  }

  .player__volume-slider[hidden] {
    display: none;
  }

  .player__quality {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-inline-start: 0.35rem;
    color: var(--player-muted-text);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .player__quality[hidden] {
    display: none;
  }

  .player__quality select {
    box-sizing: border-box;
    min-height: var(--player-target);
    padding: 0 0.45rem;
    border: 1px solid var(--player-muted-text);
    border-radius: 0.6rem;
    color: var(--player-text);
    background: var(--player-background);
    cursor: pointer;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
  }

  .player__close {
    grid-area: close;
    font-size: 1.1rem;
  }

  /* Position */
  .player__progress {
    grid-area: progress;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--player-muted-text);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .player__seek {
    flex: 1;
  }

  @media (pointer: coarse) {
    .player__seek,
    .player__volume-slider {
      height: 2.75rem;
    }

    /* The taller touch target overlaps the row gaps instead of growing the bar. */
    .player__seek {
      margin-block: -0.5rem;
    }
  }

  /* Messages */
  .player__error {
    grid-area: error;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
    padding: 0.4rem 0.4rem 0.4rem 0.75rem;
    border-left: 3px solid #ff8a80;
    border-radius: 0.5rem;
    background: var(--player-background);
    font-size: 0.85rem;
  }

  .player__error[hidden] {
    display: none;
  }

  .player__error p {
    flex: 1;
    margin: 0;
  }

  .player__retry {
    flex: 0 0 auto;
    box-sizing: border-box;
    min-height: var(--player-target);
    padding: 0 1rem;
    border: 1px solid var(--player-text);
    border-radius: 999px;
    color: var(--player-text);
    background: transparent;
    cursor: pointer;
    font: inherit;
    font-weight: 700;
  }

  .player__retry:hover {
    background: color-mix(in srgb, var(--player-text) 14%, transparent);
  }

  /* Brief notices float above the bar, so they never resize it. */
  .player__notice {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    box-sizing: border-box;
    width: max-content;
    max-width: min(36rem, calc(100vw - 2rem));
    margin: 0;
    padding: 0.5rem 0.9rem;
    transform: translateX(-50%);
    border: 1px solid var(--player-accent);
    border-radius: 0.75rem;
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 40%);
    color: var(--player-text);
    background: var(--player-surface);
    font-size: 0.85rem;
    pointer-events: none;
  }

  .player__notice[hidden] {
    display: none;
  }

  .player__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    border: 0;
    white-space: nowrap;
  }

  /* Phones, tablets and narrow windows: title row on top, controls below, full width at the bottom edge. */
  @media (max-width: 59.99rem) {
    .player {
      bottom: 0;
      left: 0;
      grid-template-areas:
        'info close'
        'controls controls'
        'progress progress'
        'error error';
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.4rem 0.5rem;
      width: 100%;
      padding: 0.6rem max(0.75rem, env(safe-area-inset-right)) calc(0.5rem + env(safe-area-inset-bottom))
        max(0.75rem, env(safe-area-inset-left));
      transform: none;
      border-width: 1px 0 0;
      border-radius: 1rem 1rem 0 0;
    }

    .player__close {
      align-self: start;
    }

    .player__volume {
      margin-inline-start: auto;
    }
  }

  /* Phones: volume via the hardware buttons (the mute button stays), compact quality menu. */
  @media (max-width: 29.99rem) {
    .player__volume-slider {
      display: none;
    }

    .player__quality {
      margin-inline-start: 0;
    }

    .player__quality-label {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
