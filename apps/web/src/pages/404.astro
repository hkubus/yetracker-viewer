---
import Layout from '../layouts/Layout.astro';
---

<Layout title="That page does not exist | Ye Tracker">
  <div class="error-page">
    <p class="error-page__code">404</p>
    <h1>That page does not exist</h1>
    <p class="error-page__body">The era may have been renamed, or the link is out of date.</p>
    <p class="error-page__actions">
      <a class="error-page__action" href="/">Back to all eras</a>
    </p>
  </div>
</Layout>

<style>
  .error-page {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.5rem;
    min-height: 70vh;
    padding: 2rem 1.25rem;
    text-align: center;
  }
  .error-page__code {
    margin: 0;
    color: #6f6f6f;
    font-size: clamp(3rem, 10vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .error-page h1 {
    margin: 0;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
  }
  .error-page__body {
    max-width: 34rem;
    margin: 0;
    color: #b4b4b4;
  }
  .error-page__actions {
    margin: 1rem 0 0;
  }
  .error-page__action {
    display: inline-block;
    padding: 0.65rem 1.1rem;
    border: 2px solid #6f6f6f;
    border-radius: 0.6rem;
    color: #f3f3f3;
    font-weight: 600;
    text-decoration: none;
  }
  .error-page__action:hover,
  .error-page__action:focus-visible {
    border-color: #fff;
    background: #2a2a2a;
  }
  .error-page__action:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }
</style>
