---
import type { Era } from '@yetracker/types';
import EraComponent from '../components/Era.astro';
import GlobalSongSearch from '../components/GlobalSongSearch.astro';
import { ERA_PAGE_SIZE, fetchApi, publicApiBaseUrl } from '../config';
import Layout from '../layouts/Layout.astro';

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === 'object' && value !== null;
}

async function loadList<T>(path: string, isItem: (item: unknown) => boolean): Promise<T[]> {
  let response: Response;
  try {
    response = await fetchApi(path);
  } catch (error) {
    console.error(`[index] ${path} request failed, falling back to empty list:`, error);
    return [];
  }
  let data: unknown;
  try {
    data = await response.json();
  } catch (error) {
    console.error(`[index] ${path} returned invalid JSON, falling back to empty list:`, error);
    return [];
  }
  if (!Array.isArray(data)) {
    console.error(`[index] ${path} returned unexpected shape, falling back to empty list.`);
    return [];
  }
  return data.filter(isItem) as T[];
}

const [eras] = await Promise.all([
  loadList<Era>('/eras', (item): item is Era => isRecord(item) && typeof item.id === 'number'),
]);
const songsCount = eras.reduce((total, era) => total + (era.songsCount ?? 0), 0);
---

<Layout title="Ye Tracker">
    <GlobalSongSearch
        songsCount={songsCount}
        eras={eras}
        apiBaseUrl={publicApiBaseUrl}
        eraPageSize={ERA_PAGE_SIZE}
    />
    <div class="era-grid">
        {
            eras.map((e, index) => (
                <EraComponent
                    era={e}
                    apiBaseUrl={publicApiBaseUrl}
                    priority={index < 3}
                />
            ))
        }
    </div>
</Layout>

<style>
    .era-grid {
        display: grid;
        grid-template-columns: repeat(
            auto-fit,
            minmax(min(100%, 240px), 1fr)
        );
        align-items: stretch;
        gap: clamp(0.75rem, 1vw, 1rem);
        padding: clamp(0.75rem, 1.5vw, 1.5rem);
    }
</style>
