---
import EraCard from '../components/Era.astro';
import GlobalSongSearch from '../components/GlobalSongSearch.astro';
import AlertIcon from '../components/icons/AlertIcon.astro';
import SearchIcon from '../components/icons/SearchIcon.astro';
import RecentLeaks from '../components/RecentLeaks.astro';
import {
  ApiNotFoundError,
  ApiServerError,
  ApiUnreachableError,
  ERA_PAGE_SIZE,
  noStore,
  OUTAGE_RETRY_AFTER_SECONDS,
  publicApiBaseUrl,
} from '../config';
import Layout from '../layouts/Layout.astro';
import type { Cached } from '../utils/cache';
import { formatCatalogDate, formatRelativeTime } from '../utils/dates';
import { loadEras, loadRecentLeaks, loadStatus, RECENT_LEAKS_LIMIT } from '../utils/shared-api';
import type { EraDisplayInfo, SearchSongPayload } from '../utils/songDisplay';
import { countLabel } from '../utils/songRow';

/** Era covers loaded eagerly with high priority: about the first row of the grid on a wide screen. */
const PRIORITY_COVERS = 6;

type Failure = 'timeout' | 'unreachable' | 'server' | 'invalid' | 'missing';
type Loaded<T> = { ok: true; data: T } | { ok: false; failure: Failure; status?: number; retryAfter?: number };

interface HomeEra {
  id: number;
  name: string;
  subtitle: string | null;
  dominantColor: string;
  /** `null` when the API doesn't say (older versions): the cover is tried and falls back to a placeholder. */
  hasCover: boolean | null;
  coverVersion: string | null;
  songsCount: number | null;
}

interface HomeStatus {
  lastImportAt: number | null;
  lastImportOk: boolean | null;
  playableSongs: number | null;
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === 'object' && value !== null;
}

function failureOf(error: unknown): { failure: Failure; status?: number; retryAfter?: number } {
  if (error instanceof ApiUnreachableError) return { failure: error.timedOut ? 'timeout' : 'unreachable' };
  if (error instanceof ApiNotFoundError) return { failure: 'missing', status: error.status };
  if (error instanceof ApiServerError) return { failure: 'server', status: error.status, retryAfter: error.retryAfter };
  return { failure: 'server' };
}

/**
 * One API response (cached for every page view, see `utils/shared-api.ts`): parsed data, or why it failed (logged).
 * Never throws, so one failure can't take the page down. An older copy served because the API failed keeps the page
 * out of shared caches.
 */
async function load<T>(
  path: string,
  fetchShared: () => Promise<Cached<unknown>>,
  parse: (body: unknown) => T | null,
): Promise<Loaded<T>> {
  try {
    const { data, stale } = await fetchShared();
    if (stale) noStore(Astro.response);
    const parsed = parse(data);
    if (parsed !== null) return { ok: true, data: parsed };
    console.error(`[home] ${path} returned an unexpected shape`);
    return { ok: false, failure: 'invalid' };
  } catch (error) {
    const outcome = failureOf(error);
    // One line per failure (an outage would otherwise log three stack traces per page view). `/status` is missing
    // on older API versions; that isn't worth a log line on every request.
    if (!(outcome.failure === 'missing' && path === '/status')) {
      console.error(`[home] ${path} failed: ${error instanceof Error ? error.message : String(error)}`);
    }
    return { ok: false, ...outcome };
  }
}

function parseEras(body: unknown): HomeEra[] | null {
  if (!Array.isArray(body)) return null;
  return body.flatMap((item): HomeEra[] => {
    if (!isRecord(item) || typeof item.id !== 'number' || typeof item.name !== 'string') return [];
    return [
      {
        id: item.id,
        name: item.name,
        subtitle: typeof item.subtitle === 'string' && item.subtitle.trim() ? item.subtitle.trim() : null,
        dominantColor: typeof item.dominantColor === 'string' ? item.dominantColor : '666666',
        hasCover: typeof item.hasCover === 'boolean' ? item.hasCover : null,
        coverVersion: typeof item.coverVersion === 'string' && item.coverVersion ? item.coverVersion : null,
        songsCount: typeof item.songsCount === 'number' && item.songsCount >= 0 ? item.songsCount : null,
      },
    ];
  });
}

function parseSongs(body: unknown): SearchSongPayload[] | null {
  if (!isRecord(body) || !Array.isArray(body.songs)) return null;
  return body.songs.filter(isRecord) as SearchSongPayload[];
}

function numberOrNull(value: unknown): number | null {
  return typeof value === 'number' && Number.isFinite(value) ? value : null;
}

function parseStatus(body: unknown): HomeStatus | null {
  if (!isRecord(body)) return null;
  return {
    lastImportAt: numberOrNull(body.lastImportAt),
    lastImportOk: typeof body.lastImportOk === 'boolean' ? body.lastImportOk : null,
    playableSongs: numberOrNull(body.playableSongs),
  };
}

const [erasResult, recentResult, statusResult] = await Promise.all([
  load('/eras', loadEras, parseEras),
  load(`/songs?playable=true&sort=leak-newest&limit=${RECENT_LEAKS_LIMIT}`, loadRecentLeaks, parseSongs),
  load('/status', loadStatus, parseStatus),
]);

// A page rendered without some of its data must not be cached. A missing `/status` (older API) is not a failure.
const statusUnsupported = !statusResult.ok && statusResult.failure === 'missing';
if (!erasResult.ok || !recentResult.ok || (!statusResult.ok && !statusUnsupported)) noStore(Astro.response);
// Without the era list the page is only an apology: tell crawlers and monitors to come back instead of indexing it.
if (!erasResult.ok) {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', String(erasResult.retryAfter ?? OUTAGE_RETRY_AFTER_SECONDS));
}

const eras = erasResult.ok ? erasResult.data : [];
const recentSongs = recentResult.ok ? recentResult.data : [];
const status = statusResult.ok ? statusResult.data : null;
const knownCounts = eras.length > 0 && eras.every((era) => era.songsCount !== null);
const songsCount = knownCounts ? eras.reduce((total, era) => total + (era.songsCount ?? 0), 0) : null;
const eraInfo = new Map<number, EraDisplayInfo>(eras.map((era) => [era.id, era]));

const stats = erasResult.ok
  ? [
      countLabel(eras.length, 'era'),
      songsCount === null ? null : countLabel(songsCount, 'track'),
      status?.playableSongs == null ? null : `${status.playableSongs.toLocaleString('en-US')} playable`,
    ]
      .filter(Boolean)
      .join(' · ')
  : '';

// `lastImportAt` is the last successful import; `lastImportOk` describes the latest attempt.
const lastImportAt = status?.lastImportAt ?? null;
const updated =
  lastImportAt === null
    ? null
    : {
        latestFailed: status?.lastImportOk === false,
        unix: lastImportAt,
        iso: new Date(lastImportAt * 1000).toISOString(),
        relative: formatRelativeTime(lastImportAt),
        date: formatCatalogDate(lastImportAt, 'day', 'long'),
      };

const outageCopy: Record<Failure, { title: string; body: string }> = {
  timeout: {
    title: 'The catalog is taking too long to answer.',
    body: 'Eras and recent leaks can’t be shown right now. Try again in a moment.',
  },
  unreachable: {
    title: 'We couldn’t reach the catalog.',
    body: 'Eras and recent leaks can’t be shown right now, and search may not work either. Try again in a moment.',
  },
  server: {
    title: 'The catalog ran into a problem.',
    body: 'Eras and recent leaks can’t be shown right now. Try again in a moment.',
  },
  invalid: {
    title: 'The catalog sent a response this page couldn’t read.',
    body: 'Eras and recent leaks can’t be shown right now. Try again in a moment.',
  },
  missing: {
    title: 'The catalog couldn’t be found.',
    body: 'Eras and recent leaks can’t be shown right now. Try again in a moment.',
  },
};
const outage = erasResult.ok ? null : outageCopy[erasResult.failure];
const description =
  erasResult.ok && songsCount !== null
    ? `Browse ${countLabel(songsCount, 'unreleased Kanye West track')} across ${countLabel(eras.length, 'era')}, with search and playback.`
    : undefined;
---

<Layout title="Ye Tracker" description={description}>
  <div class="home" data-home>
    <header class="home-header">
      <div class="home-header__brand">
        <svg class="home-header__mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
          <path d="M7 16h8l4 7.5 4-7.5h8l-8.5 16v16h-7V32zM35 16h22v7h-7.5v25h-7V23H35z"></path>
        </svg>
        <h1>Ye Tracker</h1>
        <p class="home-header__tagline">Unreleased Kanye West music, organized by era.</p>
      </div>
      <p class="home-header__meta">
        {stats ? <span>{stats}</span> : null}
        {
          updated ? (
            <span>
              Updated{' '}
              <time datetime={updated.iso} title={updated.date} data-relative-time={updated.unix}>
                {updated.relative}
              </time>
              {updated.latestFailed ? ' (the latest refresh failed)' : null}
            </span>
          ) : null
        }
        <span>
          Data from <a href="https://yetracker.net">yetracker.net</a>
        </span>
      </p>
    </header>

    {
      outage ? (
        <div class="notice" role="alert">
          <AlertIcon class="notice__icon" />
          <p>
            <strong>{outage.title}</strong> {outage.body}
          </p>
          <a href={`${Astro.url.pathname}${Astro.url.search}`} data-astro-reload>
            Try again
          </a>
        </div>
      ) : null
    }

    <GlobalSongSearch eras={eras} apiBaseUrl={publicApiBaseUrl} eraPageSize={ERA_PAGE_SIZE} />

    <RecentLeaks
      songs={recentSongs}
      failed={!recentResult.ok && erasResult.ok}
      eras={eraInfo}
      eraPageSize={ERA_PAGE_SIZE}
      apiBaseUrl={publicApiBaseUrl}
    />

    <section class="eras home-section" aria-labelledby="eras-heading">
      <div class="home-section__head eras__head">
        <h2 class="home-section__title" id="eras-heading">Eras</h2>
        {eras.length > 3 ? <p class="home-section__meta" data-era-filter-count /> : null}
        {
          eras.length > 3 ? (
            <div class="eras__filter">
              <label class="sr-only" for="era-filter">
                Filter eras by name
              </label>
              <SearchIcon />
              <input
                id="era-filter"
                type="search"
                placeholder="Filter eras…"
                autocomplete="off"
                spellcheck="false"
                enterkeyhint="search"
                data-era-filter
              />
            </div>
          ) : null
        }
      </div>
      {eras.length > 3 ? <p class="sr-only" role="status" data-era-filter-status /> : null}
      {
        eras.length > 0 ? (
          <ul class="era-grid" role="list" data-era-grid>
            {eras.map((era, index) => (
              <li data-era-filter-text={era.subtitle ? `${era.name} ${era.subtitle}` : era.name}>
                <EraCard era={era} apiBaseUrl={publicApiBaseUrl} priority={index < PRIORITY_COVERS} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="eras__empty">
            {erasResult.ok ? 'There are no eras in the catalog yet.' : 'Eras will be back as soon as the catalog is.'}
          </p>
        )
      }
      {
        eras.length > 3 ? (
          <div class="eras__no-match" data-era-filter-empty hidden>
            <span class="eras__no-match-icon" aria-hidden="true">
              <SearchIcon />
            </span>
            <p class="eras__no-match-text">
              No eras match “<span data-era-filter-query />”.
            </p>
            <button type="button" class="eras__no-match-clear" data-era-filter-clear>
              Clear the filter
            </button>
          </div>
        ) : null
      }
    </section>
  </div>
</Layout>

<script>
  import '../scripts/home';
</script>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--space-5), 3.5vw, var(--space-7));
    padding: var(--space-4) var(--page-gutter) 0;
  }
  /* A search from the URL: the sections under it wait, hidden, until its results are in (GlobalSongSearch drops
     the attribute), so they move while hidden instead of jumping under the reader's eyes (no layout shift). After
     3 s they show anyway, in case the script never runs. */
  @media (scripting: enabled) {
    .home:has(> :global(.global-search[data-search-pending])) > :global(:is(.recent, .eras)) {
      visibility: hidden;
      animation: home-reveal-sections 0s 3s forwards;
    }
  }
  @keyframes home-reveal-sections {
    to {
      visibility: visible;
    }
  }

  /* Section headers shared by the search, "Recently leaked" and the eras: title and meta on one line. */
  .home :global(.home-section__head) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin-bottom: var(--space-3);
  }
  .home :global(.home-section__title) {
    margin: 0;
    color: var(--color-text);
    font-size: var(--font-size-lg);
    font-weight: 700;
    line-height: var(--line-height-tight);
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .home :global(.home-section__meta) {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-variant-numeric: tabular-nums;
  }
  .home :global(.home-section__meta:empty) {
    display: none;
  }

  /* Site header: compact on phones (brand, one-line tagline, one wrapped meta line). */
  .home-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
  }
  /* The mark sits next to the title and tagline; on phones only next to the title, so the tagline gets the full
     width and stays on one line. */
  .home-header__brand {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.125rem var(--space-3);
    min-width: 0;
  }
  .home-header__mark {
    grid-row: span 2;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.3rem;
    box-sizing: border-box;
    border-radius: var(--radius-md);
    fill: var(--color-on-accent);
    background: var(--color-accent);
  }
  .home-header h1 {
    margin: 0;
    color: var(--color-text);
    font-size: var(--font-size-2xl);
    font-weight: 700;
    line-height: var(--line-height-tight);
    letter-spacing: -0.03em;
  }
  .home-header__tagline {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-snug);
    text-wrap: pretty;
  }
  .home-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-snug);
    font-variant-numeric: tabular-nums;
  }
  .home-header__meta a {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-decoration-color: var(--color-border-control);
    text-underline-offset: 0.2em;
  }
  @media (hover: hover) {
    .home-header__meta a:hover {
      color: var(--color-text);
      text-decoration-color: currentColor;
    }
  }
  @media (pointer: coarse) {
    /* A taller hit area for the small inline link, without changing the line. */
    .home-header__meta a {
      display: inline-block;
      margin-block: -0.875rem;
      padding-block: 0.875rem;
    }
  }

  .notice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px solid color-mix(in srgb, var(--color-danger-text) 45%, transparent);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-danger-text) 8%, var(--color-bg));
    font-size: var(--font-size-sm);
  }
  .notice :global(.notice__icon) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-danger-text);
  }
  .notice p {
    flex: 1 1 16rem;
    margin: 0;
    text-wrap: pretty;
  }
  .notice a {
    display: inline-flex;
    flex: none;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border-control);
    border-radius: var(--radius-pill);
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }
  @media (hover: hover) {
    .notice a:hover {
      background: var(--color-surface-hover);
    }
  }
  @media (pointer: coarse) {
    .notice a {
      min-height: var(--tap-size);
    }
  }

  .eras__head {
    align-items: center;
  }
  .eras__filter {
    position: relative;
    display: flex;
    align-items: center;
    margin-left: auto;
  }
  .eras__filter :global(svg) {
    position: absolute;
    left: var(--space-3);
    width: 1rem;
    height: 1rem;
    color: var(--color-text-muted);
    pointer-events: none;
  }
  .eras__filter input {
    box-sizing: border-box;
    width: 16rem;
    min-height: 2.5rem;
    padding: var(--space-2) var(--space-3) var(--space-2) 2.25rem;
    border: 1px solid var(--color-border-control);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    background: var(--color-surface);
    font: inherit;
    font-size: var(--font-size-md);
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }
  @media (hover: hover) {
    .eras__filter input:hover {
      border-color: var(--color-text-muted);
    }
  }
  .eras__filter input:focus-visible {
    border-color: var(--color-text-secondary);
    background: var(--color-surface-raised);
  }
  .eras__filter input::placeholder {
    color: var(--color-text-muted);
    opacity: 1;
  }
  @media (pointer: coarse) {
    .eras__filter input {
      min-height: var(--tap-size);
    }
  }
  .eras__empty {
    margin: var(--space-4) 0;
    color: var(--color-text-secondary);
    text-align: center;
  }

  /* auto-fill keeps empty columns, so a filtered grid keeps its card width instead of stretching the survivors. */
  .era-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .era-grid > [hidden] {
    display: none;
  }

  .eras__no-match {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-4);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .eras__no-match[hidden] {
    display: none;
  }
  .eras__no-match-icon {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    background: var(--color-surface-raised);
  }
  .eras__no-match-icon :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .eras__no-match-text {
    max-width: 100%;
    margin: 0;
    color: var(--color-text);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .eras__no-match-clear {
    min-height: 2.5rem;
    padding: 0 var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    background: var(--color-surface-raised);
    font: inherit;
    font-size: var(--font-size-sm);
    font-weight: 600;
    cursor: pointer;
  }
  @media (hover: hover) {
    .eras__no-match-clear:hover {
      border-color: var(--color-border-control);
      background: var(--color-surface-hover);
    }
  }
  .eras__no-match-clear:active {
    background: var(--color-surface);
  }
  @media (pointer: coarse) {
    .eras__no-match-clear {
      min-height: var(--tap-size);
    }
  }

  @media (max-width: 39.99rem) {
    .home-header__brand {
      row-gap: var(--space-1);
    }
    .home-header__mark {
      grid-row: auto;
      width: 2rem;
      height: 2rem;
      padding: 0.2rem;
      border-radius: var(--radius-sm);
    }
    .home-header__tagline {
      grid-column: 1 / -1;
    }
    .eras__filter {
      flex: 1 1 100%;
      margin-left: 0;
    }
    .eras__filter input {
      width: 100%;
    }
    .era-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }
  }
  @media (forced-colors: active) {
    .home-header__mark {
      forced-color-adjust: none;
      fill: Canvas;
      background: CanvasText;
    }
  }
</style>
