---
import type { Era } from '@yetracker/types';
import EraComponent from '../components/Era.astro';
import GlobalSongSearch from '../components/GlobalSongSearch.astro';
import RecentLeaks from '../components/RecentLeaks.astro';
import { ERA_PAGE_SIZE, fetchApi, noStore, publicApiBaseUrl } from '../config';
import Layout from '../layouts/Layout.astro';

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === 'object' && value !== null;
}

/** Loads a list endpoint, reporting failure instead of silently faking an empty catalog. */
async function loadList<T>(path: string, isItem: (item: unknown) => boolean): Promise<{ items: T[]; failed: boolean }> {
  let response: Response;
  try {
    response = await fetchApi(path);
  } catch (error) {
    console.error(`[index] ${path} request failed:`, error);
    return { items: [], failed: true };
  }
  let data: unknown;
  try {
    data = await response.json();
  } catch (error) {
    console.error(`[index] ${path} returned invalid JSON:`, error);
    return { items: [], failed: true };
  }
  if (!Array.isArray(data)) {
    console.error(`[index] ${path} returned unexpected shape.`);
    return { items: [], failed: true };
  }
  return { items: data.filter(isItem) as T[], failed: false };
}

const { items: eras, failed: erasFailed } = await loadList<Era>(
  '/eras',
  (item): item is Era => isRecord(item) && typeof item.id === 'number',
);
if (erasFailed) noStore(Astro.response);
const songsCount = eras.reduce((total, era) => total + (era.songsCount ?? 0), 0);
---

<Layout title="Ye Tracker">
    <header class="site-header">
        <h1>Ye Tracker</h1>
        <p class="site-header__meta">
            {eras.length.toLocaleString()} eras · {songsCount.toLocaleString()} tracks
        </p>
    </header>

    {
        erasFailed && (
            <div class="notice" role="alert">
                <p>
                    <strong>The catalog could not be loaded.</strong> The API did not answer in time — this page is
                    served without its data and is not cached.
                </p>
                <a href="/">Try again</a>
            </div>
        )
    }

    <GlobalSongSearch
        songsCount={songsCount}
        eras={eras}
        apiBaseUrl={publicApiBaseUrl}
        eraPageSize={ERA_PAGE_SIZE}
    />

    <RecentLeaks eraPageSize={ERA_PAGE_SIZE} />

    <section class="eras" aria-labelledby="eras-heading">
        <div class="eras__head">
            <h2 id="eras-heading">Eras</h2>
            {
                eras.length > 3 && (
                    <div class="eras__filter">
                        <label class="sr-only" for="era-filter">Filter eras by name</label>
                        <input
                            id="era-filter"
                            type="search"
                            placeholder="Filter eras…"
                            autocomplete="off"
                            data-era-filter
                        />
                        <p class="eras__filter-count" aria-live="polite" data-era-filter-count>
                            {eras.length} eras
                        </p>
                    </div>
                )
            }
        </div>
        <div class="era-grid" data-era-grid>
            {
                eras.map((e, index) => (
                    <EraComponent
                        era={e}
                        apiBaseUrl={publicApiBaseUrl}
                        priority={index < 3}
                    />
                ))
            }
        </div>
        <p class="eras__empty" data-era-filter-empty hidden>No eras match that filter.</p>
    </section>
</Layout>

<script is:inline data-astro-rerun>
    (() => {
        const grid = document.querySelector("[data-era-grid]");
        const input = document.querySelector("[data-era-filter]");
        const count = document.querySelector("[data-era-filter-count]");
        const empty = document.querySelector("[data-era-filter-empty]");
        if (!grid || !(input instanceof HTMLInputElement)) return;

        const cards = [...grid.children].filter((node) => node instanceof HTMLElement);
        const names = cards.map((card) => (card.dataset.eraName ?? card.textContent ?? "").toLocaleLowerCase());
        const total = cards.length;

        const apply = () => {
            const query = input.value.trim().replace(/\s+/g, " ").toLocaleLowerCase();
            let visible = 0;
            cards.forEach((card, index) => {
                const matches = !query || names[index].includes(query);
                card.hidden = !matches;
                if (matches) visible += 1;
            });
            if (count) {
                count.textContent = query ? `${visible} of ${total} eras` : `${total} eras`;
            }
            if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
        };

        input.addEventListener("input", apply);
        input.addEventListener("search", apply);
    })();
</script>

<style>
    .site-header {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        flex-wrap: wrap;
        padding: clamp(0.75rem, 1.5vw, 1.5rem) clamp(0.75rem, 1.5vw, 1.5rem) 0;
    }
    .site-header h1 {
        margin: 0;
        font-size: clamp(1.5rem, 2.4vw, 2rem);
        letter-spacing: -0.03em;
    }
    .site-header__meta {
        margin: 0;
        color: #9a9a9a;
        font-size: 0.85rem;
    }
    .notice {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin: clamp(0.75rem, 1.5vw, 1.5rem);
        margin-bottom: 0;
        padding: 0.85rem 1rem;
        border: 1px solid #7c4a3a;
        border-radius: 0.75rem;
        background: #2a1d19;
        color: #ffded4;
        font-size: 0.9rem;
    }
    .notice p {
        margin: 0;
    }
    .notice a {
        flex: none;
        padding: 0.45rem 0.8rem;
        border: 1px solid #ffded4;
        border-radius: 0.5rem;
        color: inherit;
        font-weight: 700;
        text-decoration: none;
    }
    .notice a:focus-visible {
        outline: 3px solid #fff;
        outline-offset: 2px;
    }
    .eras {
        margin-top: clamp(1rem, 2vw, 1.75rem);
    }
    .eras__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        padding: 0 clamp(0.75rem, 1.5vw, 1.5rem);
    }
    .eras__head h2 {
        margin: 0;
        font-size: 1.1rem;
        letter-spacing: -0.02em;
    }
    .eras__filter {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }
    .eras__filter input {
        box-sizing: border-box;
        width: min(18rem, 60vw);
        padding: 0.5rem 0.7rem;
        border: 1px solid #4a4a4a;
        border-radius: 0.6rem;
        outline: none;
        background: #1d1d1d;
        color: #f3f3f3;
        font: inherit;
        font-size: 0.85rem;
    }
    .eras__filter input:focus-visible {
        border-color: #d7d7d7;
        box-shadow: 0 0 0 3px rgb(255 255 255 / 10%);
    }
    .eras__filter-count {
        min-width: 5.5rem;
        margin: 0;
        color: #9a9a9a;
        font-size: 0.8rem;
        text-align: right;
    }
    .eras__empty {
        margin: 1rem;
        color: #9a9a9a;
        text-align: center;
    }
    .eras__empty[hidden] {
        display: none;
    }
    .era-grid {
        display: grid;
        grid-template-columns: repeat(
            auto-fit,
            minmax(min(100%, 240px), 1fr)
        );
        align-items: stretch;
        gap: clamp(0.75rem, 1vw, 1rem);
        padding: clamp(0.75rem, 1.5vw, 1.5rem);
    }
    .era-grid > :global([hidden]) {
        display: none;
    }
    @media (max-width: 640px) {
        .eras__filter {
            width: 100%;
        }
        .eras__filter input {
            width: 100%;
        }
        .eras__filter-count {
            min-width: 0;
        }
    }
</style>
