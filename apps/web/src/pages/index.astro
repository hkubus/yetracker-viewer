---
import type { AlbumCopyGroup, Category, Era } from '@yetracker/types';
import AlbumCopies from '../components/AlbumCopies.astro';
import CategoryComponent from '../components/Category.astro';
import EraComponent from '../components/Era.astro';
import GlobalSongSearch from '../components/GlobalSongSearch.astro';
import { ERA_PAGE_SIZE, fetchApi, publicApiBaseUrl } from '../config';
import Layout from '../layouts/Layout.astro';

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === 'object' && value !== null;
}

async function loadList<T>(path: string, isItem: (item: unknown) => boolean): Promise<T[]> {
  let response: Response;
  try {
    response = await fetchApi(path);
  } catch (error) {
    console.error(`[index] ${path} request failed, falling back to empty list:`, error);
    return [];
  }
  let data: unknown;
  try {
    data = await response.json();
  } catch (error) {
    console.error(`[index] ${path} returned invalid JSON, falling back to empty list:`, error);
    return [];
  }
  if (!Array.isArray(data)) {
    console.error(`[index] ${path} returned unexpected shape, falling back to empty list.`);
    return [];
  }
  return data.filter(isItem) as T[];
}

const [eras, categories, albumCopies] = await Promise.all([
  loadList<Era>('/eras', (item): item is Era => isRecord(item) && typeof item.id === 'number'),
  loadList<Category>('/categories', (item): item is Category => isRecord(item) && typeof item.id === 'string'),
  loadList<AlbumCopyGroup>(
    '/album-copies',
    (item): item is AlbumCopyGroup => isRecord(item) && Array.isArray(item.copies),
  ),
]);
const songsCount = eras.reduce((total, era) => total + (era.songsCount ?? 0), 0);
---

<Layout title="Ye Tracker">
    <GlobalSongSearch
        songsCount={songsCount}
        eras={eras}
        apiBaseUrl={publicApiBaseUrl}
        eraPageSize={ERA_PAGE_SIZE}
    />
    <div class="era-grid">
        {
            eras.map((e, index) => (
                <EraComponent
                    era={e}
                    apiBaseUrl={publicApiBaseUrl}
                    priority={index < 3}
                />
            ))
        }
    </div>
    <AlbumCopies
        groups={albumCopies}
        apiBaseUrl={publicApiBaseUrl}
        sourceUrl="https://yetracker.net/#gid=1297512832"
    />
    <section class="categories" aria-labelledby="categories-heading">
        <div class="categories__header">
            <p class="eyebrow">More from Ye Tracker</p>
            <h2 id="categories-heading">Other categories</h2>
            <p>Browse the additional Yetracker sheets alongside the main eras.</p>
        </div>
        <div class="category-grid">
            {
                categories.map((category) => <CategoryComponent category={category} />)
            }
        </div>
    </section>
</Layout>

<style>
    .era-grid {
        display: grid;
        grid-template-columns: repeat(
            auto-fit,
            minmax(min(100%, 240px), 1fr)
        );
        align-items: stretch;
        gap: clamp(0.75rem, 1vw, 1rem);
        padding: clamp(0.75rem, 1.5vw, 1.5rem);
    }

    .categories {
        padding: 0 clamp(0.75rem, 1.5vw, 1.5rem) 2rem;
    }

    .categories__header {
        max-width: 42rem;
        margin: 1rem 0 1rem;
    }

    .eyebrow {
        margin: 0 0 0.35rem;
        color: #999;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    h2 {
        margin: 0;
        color: #f3f3f3;
        font-size: clamp(1.6rem, 3vw, 2.2rem);
    }

    .categories__header p:last-child {
        margin: 0.55rem 0 0;
        color: #aaa;
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
        gap: clamp(0.75rem, 1vw, 1rem);
    }
</style>
