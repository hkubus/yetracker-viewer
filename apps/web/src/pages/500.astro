---
import ErrorPage from '../components/ErrorPage.astro';
import { ApiServerError, ERROR_STATUS_HEADER, isApiOutage, OUTAGE_RETRY_AFTER_SECONDS } from '../config';

interface Props {
  /** The error that stopped the page (passed by Astro). */
  error?: unknown;
}

const { error } = Astro.props;
// A page that failed because the API is down or answered with a server error gets the 503 variant, so clients and
// caches know to come back shortly instead of treating it as a bug of this page.
const outage = isApiOutage(error);
if (outage) {
  const retryAfter = (error instanceof ApiServerError ? error.retryAfter : undefined) ?? OUTAGE_RETRY_AFTER_SECONDS;
  // Astro sends this route with status 500; the middleware turns it into the 503 requested here.
  Astro.response.headers.set(ERROR_STATUS_HEADER, '503');
  Astro.response.headers.set('Retry-After', String(retryAfter));
}
---

<ErrorPage status={outage ? 503 : 500} />
