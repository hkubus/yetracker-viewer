---
import type { Era, Song } from '@yetracker/types';
import BackButton from '../../components/BackButton.astro';
import Pagination from '../../components/Pagination.astro';
import SongList from '../../components/SongList.astro';
import { apiUrl, ERA_PAGE_SIZE, fetchApi, publicApiBaseUrl } from '../../config';
import Layout from '../../layouts/Layout.astro';
import { songCategoryIds } from '../../songCategories';
import { DEFAULT_SONG_SORT, normalizeSongSort } from '../../songSorts';
import { colorValue } from '../../utils/color';

const { id } = Astro.params;
const pageValue = Astro.url.searchParams.get('page') ?? '1';
const parsedPage = Number(pageValue);
const currentPage = /^\d+$/.test(pageValue) && Number.isSafeInteger(parsedPage) && parsedPage > 0 ? parsedPage : 1;
const rawQuery = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 200);
const rawCategory = (Astro.url.searchParams.get('category') ?? '').trim();
const category = songCategoryIds().includes(rawCategory) ? rawCategory : '';
const sort = normalizeSongSort(Astro.url.searchParams.get('sort'));
const sortParam = sort === DEFAULT_SONG_SORT ? '' : sort;
const offset = (currentPage - 1) * ERA_PAGE_SIZE;
const songsParams = new URLSearchParams({
  limit: String(ERA_PAGE_SIZE),
  offset: String(offset),
});
if (rawQuery) songsParams.set('q', rawQuery);
if (category) songsParams.set('category', category);
if (sortParam) songsParams.set('sort', sortParam);
const songsPath = `/eras/${encodeURIComponent(id ?? '')}/songs?${songsParams.toString()}`;

/** Era neighbours are nice-to-have: a failure here must not break the page. */
async function loadEraList(): Promise<Era[]> {
  try {
    const response = await fetchApi('/eras');
    const body: unknown = await response.json();
    return Array.isArray(body) ? (body as Era[]) : [];
  } catch (error) {
    console.error('[era] /eras request failed; era navigation disabled:', error);
    return [];
  }
}

let data!: Era;
let songData!: (Song & { url: string; downloaded: number })[];
let headerTotalRaw: string | null = null;
let eraList: Era[] = [];
try {
  const [req, songsReq, eras] = await Promise.all([fetchApi(`/eras/${id}`), fetchApi(songsPath), loadEraList()]);
  eraList = eras;
  [data, songData] = await Promise.all([req.json(), songsReq.json()]);
  headerTotalRaw = songsReq.headers.get('x-total-count');
} catch (error) {
  const status = (error as { status?: number }).status;
  if (status === 404) {
    // Render the branded 404 in place, with a real 404 status.
    Astro.response.status = 404;
    return Astro.rewrite('/404');
  }
  throw error;
}
const headerTotal = Number(headerTotalRaw);
const totalSongs = Number.isFinite(headerTotal) ? Math.max(0, Math.trunc(headerTotal)) : songData.length;
const pageCount = Math.max(1, Math.ceil(totalSongs / ERA_PAGE_SIZE));
const eraIndex = eraList.findIndex((era) => era.id === data.id);
const previousEra = eraIndex > 0 ? eraList[eraIndex - 1] : null;
const nextEra = eraIndex >= 0 && eraIndex < eraList.length - 1 ? eraList[eraIndex + 1] : null;
const queryParams = new URLSearchParams();
if (rawQuery) queryParams.set('q', rawQuery);
if (category) queryParams.set('category', category);
if (sortParam) queryParams.set('sort', sortParam);
const queryString = queryParams.toString();
const querySuffix = queryString ? `?${queryString}` : '';
if (currentPage > pageCount) {
  const target = `/eras/${id}${pageCount > 1 ? `?page=${pageCount}${queryString ? `&${queryString}` : ''}` : querySuffix}`;
  return Astro.redirect(target);
}
const dominantColor = colorValue(data.dominantColor);
const coverVersion = data.coverVersion ?? dominantColor.slice(1);
const coverUrl = `${apiUrl(publicApiBaseUrl, `/eras/${id}/cover`)}?v=${encodeURIComponent(coverVersion)}`;
const paginationBase = `/eras/${id}${querySuffix}`;
---

<Layout title={`${data.name} | Ye Tracker`}>
  <div class="main" style={`--dominantColor: ${dominantColor}`}>
    <BackButton />
    <div class="data">
      <img src={coverUrl} alt="" width="512" height="512" fetchpriority="high" decoding="async" />
      <div class="text">
        <h1>{data.name}</h1>
        {data.description ? <p>{data.description}</p> : null}
      </div>
      {data.notes ? <div class="divider"></div> : null}
      {data.notes ? <p class="notes">{data.notes}</p> : null}
    </div>
    {
      previousEra || nextEra ? (
        <nav class="era-nav" aria-label="Era navigation">
          {previousEra ? (
            <a href={`/eras/${previousEra.id}`} rel="prev">
              <span aria-hidden="true">←</span> {previousEra.name}
            </a>
          ) : (
            <span class="era-nav__empty" />
          )}
          {nextEra ? (
            <a class="era-nav__next" href={`/eras/${nextEra.id}`} rel="next">
              {nextEra.name} <span aria-hidden="true">→</span>
            </a>
          ) : (
            <span class="era-nav__empty" />
          )}
        </nav>
      ) : null
    }
    <div class="list">
      <Pagination
        currentPage={currentPage}
        pageCount={pageCount}
        totalItems={totalSongs}
        pageSize={ERA_PAGE_SIZE}
        basePath={paginationBase}
        paginationId="song-pagination-top"
      />
      <SongList
        eraId={id}
        eraName={data.name}
        songs={songData}
        apiBaseUrl={publicApiBaseUrl}
        coverVersion={coverVersion}
        initialQuery={rawQuery}
        initialCategory={category}
        sort={sort}
      />
      <Pagination
        currentPage={currentPage}
        pageCount={pageCount}
        totalItems={totalSongs}
        pageSize={ERA_PAGE_SIZE}
        basePath={paginationBase}
      />
    </div>
  </div>
</Layout>

<style>
  img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 25vh;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 16px;
    flex-shrink: 0;
  }
  h1 {
    font-size: 2.5em;
    margin-bottom: 0;
  }
  p {
    font-size: 1.1em;
  }
  .main {
    padding: 1vh;
    color: color-mix(in oklab, var(--dominantColor) 10%, white);
  }
  .notes {
    min-width: 15%;
    max-width: 25%;
    font-size: 1em;
    white-space: pre-line;
    overflow-wrap: anywhere;
    max-height: 30vh;
    overflow-y: auto;
  }
  .divider {
    border: 1px solid color-mix(in srgb, var(--dominantColor) 30%, transparent);
    align-self: stretch;
    height: auto;
    margin-right: 0.75vw;
    margin-top: -1vh;
    margin-bottom: -1vh;
  }

  .data {
    display: flex;
    color: color-mix(in oklab, var(--dominantColor) 20%, white);
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 4rem;
    padding: 1vh;
    border: 4px solid color-mix(in srgb, var(--dominantColor) 70%, transparent);
    background-color: color-mix(in srgb, var(--dominantColor) 25%, transparent);
    border-radius: 16px;
  }
  .era-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 1rem 0.25rem 0;
    font-size: 0.9rem;
  }
  .era-nav a {
    min-width: 0;
    max-width: 46%;
    overflow: hidden;
    padding: 0.55rem 0.8rem;
    border: 2px solid color-mix(in srgb, var(--dominantColor) 45%, transparent);
    border-radius: 0.65rem;
    color: color-mix(in oklab, var(--dominantColor) 15%, white);
    background: color-mix(in srgb, var(--dominantColor) 15%, transparent);
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .era-nav a:hover,
  .era-nav a:focus-visible {
    border-color: color-mix(in srgb, var(--dominantColor) 80%, white);
    background: color-mix(in srgb, var(--dominantColor) 28%, transparent);
  }
  .era-nav a:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }
  .era-nav__empty {
    flex: none;
  }
  .list {
    border: 4px solid color-mix(in srgb, var(--dominantColor) 70%, transparent);
    border-radius: 16px;
    padding: 1vh;
    background-color: color-mix(in srgb, var(--dominantColor) 20%, transparent);
    margin-top: 2vh;
  }
  .text {
    flex: 1 1 16rem;
    min-width: 0;
    padding: 1vw;
    padding-right: 0.25vw;
  }

  .text p {
    overflow-wrap: anywhere;
  }

  @media (max-width: 700px) {
    .data {
      align-items: stretch;
      flex-direction: column;
      margin-top: 0;
      padding: 0.75rem;
    }

    .data img {
      width: min(100%, 20rem);
      height: auto;
      max-height: none;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      align-self: center;
    }

    .text {
      padding: 0.5rem 0;
    }

    h1 {
      margin-top: 0.5rem;
      font-size: 2rem;
    }

    .divider {
      display: none;
    }

    .notes {
      min-width: 0;
      max-width: none;
      margin-bottom: 0;
    }
  }
</style>
