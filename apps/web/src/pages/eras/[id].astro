---
import type { Era, Song } from '@yetracker/types';
import BackButton from '../../components/BackButton.astro';
import CoverImage from '../../components/CoverImage.astro';
import ErrorPage from '../../components/ErrorPage.astro';
import ChevronDownIcon from '../../components/icons/ChevronDownIcon.astro';
import ChevronIcon from '../../components/icons/ChevronIcon.astro';
import Pagination from '../../components/Pagination.astro';
import SongList from '../../components/SongList.astro';
import {
  ApiBadRequestError,
  ApiNotFoundError,
  ApiServerError,
  ApiUnreachableError,
  absolutePublicApiBaseUrl,
  ERA_PAGE_SIZE,
  fetchApi,
  fetchJson,
  noStore,
  OUTAGE_RETRY_AFTER_SECONDS,
  originDependentCacheControl,
  PAGE_CACHE_CONTROL,
  publicApiBaseUrl,
  publicApiOrigin,
} from '../../config';
import Layout from '../../layouts/Layout.astro';
import { normalizeSongCategory, SONG_CATEGORIES } from '../../songCategories';
import { DEFAULT_SONG_SORT, normalizeSongSort } from '../../songSorts';
import { colorValue, themeFor, themeStyle } from '../../utils/color';
import { coverUrl } from '../../utils/cover';
import {
  type EraListParams,
  eraPageHref,
  eraPageTitle,
  eraSongsApiPath,
  maxReachablePage,
  pageCountFor,
  parseId,
  parsePageParam,
  parseTimeline,
  parseTotalCount,
  summarize,
  timelineYears,
} from '../../utils/era-page';
import { clampQuery } from '../../utils/search';
import { type EraSummary, loadEraSummaries } from '../../utils/shared-api';

interface Failure {
  status: 400 | 404 | 503;
  heading?: string;
  message?: string;
  detail?: string;
  retryAfter?: number;
  secondaryAction?: { href: string; label: string };
}

const eraId = parseId(Astro.params.id);
const search = Astro.url.searchParams;
const requestedPage = parsePageParam(search.get('page'));
const query = clampQuery(search.get('q') ?? '');
const category = normalizeSongCategory(search.get('category'));
const sort = normalizeSongSort(search.get('sort'));
// The default order is never sent explicitly (older APIs only know its `id` alias).
const listParams: EraListParams = { q: query, category, sort: sort === DEFAULT_SONG_SORT ? '' : sort };
const maxPage = maxReachablePage(ERA_PAGE_SIZE);

const ERA_NOT_FOUND: Failure = {
  status: 404,
  heading: 'Era not found',
  message: 'There is no era at this address. The link may be mistyped, or the era is no longer in the catalog.',
};

function outageFailure(error: ApiServerError | ApiUnreachableError): Failure {
  const detail =
    error instanceof ApiUnreachableError
      ? error.timedOut
        ? 'The catalog service did not answer in time.'
        : 'The catalog service could not be reached.'
      : 'The catalog service reported an error.';
  const retryAfter = (error instanceof ApiServerError ? error.retryAfter : undefined) ?? OUTAGE_RETRY_AFTER_SECONDS;
  return { status: 503, detail, retryAfter };
}

/** Maps an API error to the page to show; anything unexpected is re-thrown (500 page). */
function toFailure(error: unknown, { badRequestIsNotFound }: { badRequestIsNotFound: boolean }): Failure {
  if (error instanceof ApiNotFoundError) return ERA_NOT_FOUND;
  if (error instanceof ApiBadRequestError) {
    if (badRequestIsNotFound) return ERA_NOT_FOUND;
    return {
      status: 400,
      detail: error.message,
      secondaryAction: eraId === null ? undefined : { href: eraPageHref(eraId), label: 'Show all songs of this era' },
    };
  }
  if (error instanceof ApiServerError || error instanceof ApiUnreachableError) return outageFailure(error);
  throw error;
}

function isEra(value: unknown): value is Era {
  return (
    typeof value === 'object' &&
    value !== null &&
    typeof (value as Era).id === 'number' &&
    typeof (value as Era).name === 'string'
  );
}

/** The real number of matching songs, asked with the smallest possible page (for out-of-range page numbers). */
async function countSongs(id: number): Promise<number> {
  const response = await fetchApi(eraSongsApiPath(id, listParams, 0, 1));
  void response.body?.cancel().catch(() => {});
  return parseTotalCount(response.headers.get('x-total-count')) ?? 0;
}

let failure: Failure | null = null;
let era: Era | null = null;
let songs: Song[] = [];
let totalSongs = 0;
let eraList: EraSummary[] = [];

if (eraId === null) {
  failure = ERA_NOT_FOUND;
} else if (requestedPage === null) {
  failure = {
    status: 400,
    detail: 'The page number in the link must be a positive whole number.',
    secondaryAction: { href: eraPageHref(eraId, listParams), label: 'Go to the first page' },
  };
} else {
  const pageInRange = requestedPage <= maxPage;
  const offset = (requestedPage - 1) * ERA_PAGE_SIZE;
  const [eraResult, songsResult, listResult] = await Promise.allSettled([
    fetchJson<unknown>(`/eras/${eraId}`),
    pageInRange ? fetchJson<unknown>(eraSongsApiPath(eraId, listParams, offset, ERA_PAGE_SIZE)) : Promise.resolve(null),
    loadEraSummaries(),
  ]);

  if (eraResult.status === 'rejected') {
    failure = toFailure(eraResult.reason, { badRequestIsNotFound: true });
  } else if (!isEra(eraResult.value.data)) {
    failure = outageFailure(new ApiServerError('API returned an invalid era', `/eras/${eraId}`));
  } else if (songsResult.status === 'rejected') {
    era = eraResult.value.data;
    failure = toFailure(songsResult.reason, { badRequestIsNotFound: false });
  } else {
    era = eraResult.value.data;
    const songsData = songsResult.value?.data;
    if (songsResult.value !== null && !Array.isArray(songsData)) {
      failure = outageFailure(new ApiServerError('API returned an invalid song list', `/eras/${eraId}/songs`));
    } else {
      songs = (songsData ?? []) as Song[];
      const headerTotal = songsResult.value
        ? parseTotalCount(songsResult.value.response.headers.get('x-total-count'))
        : null;
      totalSongs = headerTotal ?? offset + songs.length;
      if (!pageInRange || (songs.length === 0 && requestedPage > 1)) {
        // Past the end. Older API versions report a total of 0 there, so ask for the real total.
        try {
          const total = pageInRange && headerTotal ? headerTotal : await countSongs(eraId);
          const lastPage = Math.min(pageCountFor(total, ERA_PAGE_SIZE), maxPage);
          if (requestedPage > lastPage) return Astro.redirect(eraPageHref(eraId, listParams, lastPage), 302);
          totalSongs = total;
        } catch (error) {
          failure = toFailure(error, { badRequestIsNotFound: false });
        }
      }
    }
  }

  if (listResult.status === 'fulfilled') {
    eraList = listResult.value.eras;
  } else {
    // Only the previous/next links are missing: render, but keep the degraded page out of caches.
    console.error('[era] /eras request failed; era navigation disabled:', listResult.reason);
    noStore(Astro.response);
  }
}

if (failure) {
  Astro.response.status = failure.status;
  if (failure.retryAfter) Astro.response.headers.set('Retry-After', String(failure.retryAfter));
}

const currentPage = requestedPage ?? 1;
const pageCount = Math.min(pageCountFor(totalSongs, ERA_PAGE_SIZE), maxPage);
const currentEraId = era?.id;
const eraIndex = currentEraId === undefined ? -1 : eraList.findIndex((item) => item.id === currentEraId);
const previousEra = eraIndex > 0 ? eraList[eraIndex - 1] : undefined;
const nextEra = eraIndex >= 0 ? eraList[eraIndex + 1] : undefined;
const categoryLabel = SONG_CATEGORIES.find((item) => item.id === category)?.label;
const subtitle = era?.subtitle?.trim() || null;
const description = era?.description?.trim() ?? '';
const notes = era?.notes?.trim() ?? '';
// The catalog writes an era's timeline as "(date) (event)" pairs; anything else is shown as written.
const timeline = parseTimeline(notes);
const years = timelineYears(timeline);
const pageTitle = era ? eraPageTitle(era.name, { query, categoryLabel, page: currentPage }) : '';
const metaDescription = era
  ? summarize(description || notes || `Unreleased songs from the ${era.name} era, as catalogued by Ye Tracker.`)
  : '';
const ogImage =
  era?.hasCover === true && era.coverVersion
    ? coverUrl(absolutePublicApiBaseUrl(Astro.request), era.id, era.coverVersion, 'jpeg')
    : null;
// With a same-origin API the image URL is made absolute from the site's origin, which may come from the request.
if (!failure && ogImage && !publicApiOrigin && !Astro.response.headers.has('Cache-Control')) {
  Astro.response.headers.set('Cache-Control', originDependentCacheControl(PAGE_CACHE_CONTROL, 60));
}
const paginationBase = era ? eraPageHref(era.id, listParams) : '';
const pageStyle = era ? `${themeStyle(era.dominantColor)}; --dominantColor: ${colorValue(era.dominantColor)}` : '';
// Tints the browser chrome (mobile address bar, installed app title bar) with the era's background.
const themeColor = era ? themeFor(era.dominantColor).background : undefined;
---

{
  failure || !era ? (
    <ErrorPage
      status={failure?.status ?? 404}
      heading={failure?.heading}
      message={failure?.message}
      detail={failure?.detail}
      retryHref={`${Astro.url.pathname}${Astro.url.search}`}
      secondaryAction={failure?.secondaryAction}
    />
  ) : (
    <Layout
      title={pageTitle}
      description={metaDescription}
      canonicalPath={eraPageHref(era.id, listParams, currentPage)}
      ogImage={ogImage}
      ogImageAlt={ogImage ? `Cover art of ${era.name}` : undefined}
      themeColor={themeColor}
    >
      <div class="era-page" style={pageStyle}>
        <div class="era-topbar">
          <BackButton />
          {(previousEra || nextEra) && (
            <nav class="era-nav" aria-label="Other eras">
              {/* A missing neighbour keeps its place (dimmed, hidden from assistive technology): the other arrow
                  never moves. */}
              {previousEra ? (
                <a
                  class="era-nav__link era-nav__link--previous"
                  href={`/eras/${previousEra.id}`}
                  rel="prev"
                  title={previousEra.name}
                  data-astro-prefetch
                >
                  <ChevronIcon direction="left" class="era-nav__icon" />
                  <span class="sr-only">Previous era: </span>
                  <span class="era-nav__name">{previousEra.name}</span>
                </a>
              ) : (
                <span class="era-nav__link era-nav__link--previous is-disabled" aria-hidden="true">
                  <ChevronIcon direction="left" class="era-nav__icon" />
                </span>
              )}
              {nextEra ? (
                <a
                  class="era-nav__link era-nav__link--next"
                  href={`/eras/${nextEra.id}`}
                  rel="next"
                  title={nextEra.name}
                  data-astro-prefetch
                >
                  <span class="sr-only">Next era: </span>
                  <span class="era-nav__name">{nextEra.name}</span>
                  <ChevronIcon class="era-nav__icon" />
                </a>
              ) : (
                <span class="era-nav__link era-nav__link--next is-disabled" aria-hidden="true">
                  <ChevronIcon class="era-nav__icon" />
                </span>
              )}
            </nav>
          )}
        </div>

        <header class="era-hero">
          <CoverImage
            class="era-hero__cover"
            eraId={era.id}
            eraName={era.name}
            hasCover={era.hasCover}
            coverVersion={era.coverVersion}
            dominantColor={era.dominantColor}
            priority
          />
          <div class="era-hero__text">
            <h1>{era.name}</h1>
            {(subtitle || years) && (
              <p class="era-hero__meta">
                {subtitle && <span>{subtitle}</span>}
                {years && <span>{years}</span>}
              </p>
            )}
            {(description || notes) && (
              <details class="era-about">
                <summary class="era-about__toggle">
                  About this era
                  <ChevronDownIcon class="era-about__chevron" />
                </summary>
                <div class="era-about__content">
                  {description && <p class="era-about__description">{description}</p>}
                  {notes && (
                    <div class="era-about__timeline">
                      <h2 class="era-about__heading">Timeline</h2>
                      {timeline ? (
                        <ol class="era-timeline">
                          {timeline.map((entry) => (
                            <li class:list={['era-timeline__entry', { 'is-undated': !entry.date }]}>
                              {entry.date && (
                                <time class="era-timeline__date" datetime={entry.iso}>
                                  {entry.date}
                                </time>
                              )}
                              <span class="era-timeline__text">{entry.text}</span>
                            </li>
                          ))}
                        </ol>
                      ) : (
                        <p class="era-about__notes">{notes}</p>
                      )}
                    </div>
                  )}
                </div>
              </details>
            )}
          </div>
        </header>

        <div class="era-songs">
          <SongList
            eraId={era.id}
            eraName={era.name}
            eraSubtitle={subtitle}
            songs={songs}
            apiBaseUrl={publicApiBaseUrl}
            dominantColor={era.dominantColor}
            hasCover={era.hasCover}
            coverVersion={era.coverVersion ?? null}
            initialQuery={query}
            initialCategory={category}
            sort={sort}
            total={totalSongs}
            offset={(currentPage - 1) * ERA_PAGE_SIZE}
          >
            <Pagination
              slot="pager"
              variant="compact"
              currentPage={currentPage}
              pageCount={pageCount}
              totalItems={totalSongs}
              pageSize={ERA_PAGE_SIZE}
              basePath={paginationBase}
              paginationId="song-pagination-top"
              position="top"
            />
          </SongList>
          {pageCount > 1 && (
            <Pagination
              currentPage={currentPage}
              pageCount={pageCount}
              totalItems={totalSongs}
              pageSize={ERA_PAGE_SIZE}
              basePath={paginationBase}
              position="bottom"
            />
          )}
        </div>
      </div>
    </Layout>
  )
}

<style>
  .era-page {
    box-sizing: border-box;
    padding: var(--space-3) var(--page-gutter) 0;
    color: var(--theme-text);
  }

  /* ---- Top bar: back to all eras, previous / next era ---- */
  .era-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .era-topbar :global(.back-link) {
    min-width: 0;
  }
  .era-nav {
    display: flex;
    min-width: 0;
    justify-content: flex-end;
    gap: var(--space-2);
  }
  .era-nav__link {
    box-sizing: border-box;
    display: inline-flex;
    min-width: var(--tap-size);
    max-width: 16rem;
    min-height: var(--tap-size);
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--theme-text);
    font-size: var(--font-size-sm);
    font-weight: 600;
    line-height: var(--line-height-tight);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }
  .era-nav__link--previous {
    padding-left: var(--space-3);
  }
  .era-nav__link--next {
    padding-right: var(--space-3);
  }
  @media (hover: hover) {
    a.era-nav__link:hover {
      border-color: var(--color-border-strong);
      background: var(--color-surface);
    }
  }
  a.era-nav__link:active {
    background: var(--color-surface-raised);
  }
  a.era-nav__link:focus-visible {
    outline: 2px solid var(--theme-focus-ring);
    outline-offset: 2px;
  }
  /* Dimmed through the border only: the arrow keeps the muted text contrast. */
  .era-nav__link.is-disabled {
    border-style: dashed;
    color: var(--theme-muted-text);
  }
  .era-nav__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .era-nav :global(.era-nav__icon) {
    width: 1.125rem;
    height: 1.125rem;
    flex: none;
  }

  /* ---- Hero: cover, name, subtitle and years; the description and timeline behind "About this era" on phones ---- */
  /* The era color is a tint (from the theme's contrast-checked surfaces into the page background), not a frame. */
  .era-hero {
    --cover-size: 4.5rem;
    --hero-gap: var(--space-3);
    display: grid;
    grid-template-columns: var(--cover-size) minmax(0, 1fr);
    align-items: start;
    gap: var(--hero-gap);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--theme-surface), var(--theme-background) 55%, var(--color-bg));
  }
  .era-hero :global(.era-hero__cover) {
    width: 100%;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }
  .era-hero__text {
    min-width: 0;
  }
  h1 {
    margin: 0;
    font-size: var(--font-size-xl);
    font-weight: 700;
    line-height: var(--line-height-tight);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .era-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    margin: var(--space-1) 0 0;
    color: var(--theme-muted-text);
    font-size: var(--font-size-sm);
    font-variant-numeric: tabular-nums;
  }
  .era-hero__meta > * + *::before {
    margin-right: var(--space-2);
    content: '·';
    content: '·' / '';
  }

  .era-about {
    min-width: 0;
  }
  .era-about__toggle {
    display: inline-flex;
    min-height: var(--tap-size);
    align-items: center;
    gap: var(--space-1);
    /* The target reaches into the hero's padding instead of making the hero taller. */
    margin-bottom: calc(-1 * var(--space-2));
    color: var(--theme-accent-text);
    cursor: pointer;
    font-size: var(--font-size-sm);
    font-weight: 600;
    list-style: none;
    user-select: none;
  }
  .era-about__toggle::-webkit-details-marker {
    display: none;
  }
  .era-about__toggle:focus-visible {
    outline: 2px solid var(--theme-focus-ring);
    outline-offset: 2px;
  }
  .era-about :global(.era-about__chevron) {
    width: 1rem;
    height: 1rem;
    flex: none;
    transition: transform var(--duration-fast) var(--ease-standard);
  }
  .era-about[open] :global(.era-about__chevron) {
    transform: rotate(180deg);
  }
  /* Opens under the cover across the whole hero, while the toggle stays where it was tapped. */
  .era-about__content {
    display: grid;
    gap: var(--space-4);
    margin-left: calc(-1 * (var(--cover-size) + var(--hero-gap)));
    padding-top: var(--space-4);
    color: var(--theme-text);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
  }
  .era-about__description,
  .era-about__notes {
    max-width: 72ch;
    margin: 0;
    overflow-wrap: anywhere;
    text-wrap: pretty;
    white-space: pre-line;
  }
  .era-about__notes {
    color: var(--theme-muted-text);
  }
  .era-about__heading {
    margin: 0 0 var(--space-2);
    color: var(--theme-muted-text);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }
  .era-timeline {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .era-timeline__entry {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-3);
  }
  .era-timeline__date {
    color: var(--theme-accent-text);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    white-space: nowrap;
  }
  .era-timeline__entry.is-undated .era-timeline__text {
    grid-column: 1 / -1;
    color: var(--theme-muted-text);
  }

  .era-songs {
    margin-top: var(--space-4);
  }

  /* Phones: the neighbouring eras become arrows (their names stay in the accessible names and tooltips). */
  @media (max-width: 39.99rem) {
    .era-nav__link {
      padding: 0;
    }
    .era-nav__name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }

  /* Tablets and up: a larger cover. From 64rem the description and timeline are always shown (browsers without
     ::details-content keep the closed disclosure); a portrait tablet keeps it, so the songs start on the first screen. */
  @media (min-width: 48rem) {
    .era-page {
      padding-top: var(--space-4);
    }
    .era-topbar {
      margin-bottom: var(--space-4);
    }
    .era-hero {
      --cover-size: clamp(8rem, 14vw, 11rem);
      --hero-gap: var(--space-5);
      padding: var(--space-5);
    }
    h1 {
      font-size: var(--font-size-display);
    }
    .era-hero__meta {
      margin-top: var(--space-2);
      font-size: var(--font-size-md);
    }
    .era-about__toggle {
      margin-bottom: 0;
    }
    .era-about__content {
      margin-left: 0;
      padding-top: var(--space-3);
    }
    .era-songs {
      margin-top: var(--space-5);
    }
  }
  @media (min-width: 64rem) {
    @supports selector(::details-content) {
      .era-about__toggle {
        display: none;
      }
      .era-about::details-content {
        display: block;
        content-visibility: visible;
        block-size: auto;
      }
      .era-about__content {
        padding-top: var(--space-4);
      }
    }
    .era-about__content:has(.era-about__timeline) {
      grid-template-columns: minmax(0, 1.7fr) minmax(15rem, 1fr);
      gap: var(--space-6);
    }
  }
</style>
