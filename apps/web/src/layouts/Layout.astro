---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Player from '../components/Player.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { publicApiBaseUrl, publicApiOrigin, siteUrl } from '../config';
import { API_URL_META_NAME } from '../utils/api-base-url';
import '../styles/tokens.css';

interface Props {
  /** Full document title. */
  title?: string;
  /** Meta and Open Graph description. */
  description?: string;
  /**
   * Path (with the query string that identifies the page, if any) for the canonical and `og:url` URLs. They are
   * only emitted when `SITE_URL` is configured. Default: the request path without its query.
   */
  canonicalPath?: string;
  /** Absolute URL of the Open Graph / Twitter card image. */
  ogImage?: string | null;
  ogImageAlt?: string;
  /** Adds `<meta name="robots" content="noindex">` (error pages). */
  noindex?: boolean;
  /**
   * Color of the browser chrome (`theme-color`: Android's address bar, Safari's tab bar, the installed app's title
   * bar), e.g. an era's background. Default: the site background. Should stay dark, the site is dark only.
   */
  themeColor?: string;
}

const SITE_NAME = 'Ye Tracker';
const DEFAULT_THEME_COLOR = '#181818';
const {
  title = SITE_NAME,
  description = 'Browse Ye Tracker eras — unreleased Kanye West music organized by era.',
  canonicalPath = Astro.url.pathname,
  ogImage = null,
  ogImageAlt,
  noindex = false,
  themeColor = DEFAULT_THEME_COLOR,
} = Astro.props;

const canonicalUrl = siteUrl && !noindex ? new URL(canonicalPath, `${siteUrl}/`).href : null;
// Covers are the first API requests of a page: open the connection early. Same-origin APIs need no hint.
const preconnectOrigin = publicApiOrigin && publicApiOrigin !== Astro.url.origin ? publicApiOrigin : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="dark" />
    {/* iOS would turn digit runs in notes and dates ("5/22/2018", ids) into phone links. */}
    <meta name="format-detection" content="telephone=no" />
    {/* Installable: public/manifest.webmanifest (standalone: every page has its own way back). The apple-* tags are
        for iOS versions that predate manifest support. */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    {/* Read by client scripts through utils/api-base-url.ts: the API URL is decided at runtime, not at build time. */}
    <meta name={API_URL_META_NAME} content={publicApiBaseUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {preconnectOrigin && <link rel="preconnect" href={preconnectOrigin} />}
    {/* Preloaded: found only through the CSS, the faces would miss the first render (`display: optional`). Only the
        latin files: latin-ext characters are rare, and those three files only competed with the page for bandwidth. */}
    <Font cssVariable="--font-body" preload={[{ subset: 'latin' }]} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content" data-skip-link>Skip to main content</a>
    <main id="main-content" class="site-main" tabindex="-1"><slot /></main>
    <SiteFooter />
    <Player apiBaseUrl={publicApiBaseUrl} />
  </body>
</html>

<script>
  import '../scripts/skip-link';
</script>

<style>
  .site-main {
    flex: 1 0 auto;
    box-sizing: border-box;
    width: 100%;
    max-width: 90rem;
    margin-inline: auto;
    /* viewport-fit=cover lets the page extend under notches: keep content out of the side insets. */
    padding-inline: env(safe-area-inset-left, 0px) env(safe-area-inset-right, 0px);
  }
  /* Focusable only as the skip link's target (tabindex="-1", not in the tab order): outlining the whole page there
     would only get in the way, and the next Tab continues inside it. */
  .site-main:focus {
    outline: none;
  }
  /* Off screen until focused; then a pill over the top left corner (it covers the page instead of pushing it down). */
  .skip-link {
    position: absolute;
    z-index: var(--z-skip-link);
    top: -100%;
    left: max(var(--space-3), env(safe-area-inset-left));
    display: inline-flex;
    box-sizing: border-box;
    min-height: var(--tap-size);
    align-items: center;
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-pill);
    color: var(--color-on-accent);
    background: var(--color-accent);
    box-shadow: var(--shadow-md);
    font-size: var(--font-size-sm);
    font-weight: 700;
    text-decoration: none;
  }
  .skip-link:focus-visible {
    top: max(var(--space-3), env(safe-area-inset-top));
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
</style>

<style is:global>
  /* Shared by every page and component: kept global on purpose. */
  /* The fixed audio player publishes its height (bar + bottom gap, safe-area inset included) as --player-height on
     <html> while it is visible. */
  :root {
    /* Older names, kept as aliases of the tokens (styles/tokens.css). */
    --sidebar-color: var(--color-bg-sunken);
    --bg-color: var(--color-bg);
    /* Default focus ring: white on the site's dark surfaces (≥ 3:1 on every background the site uses). */
    --focus-ring-color: #ffffff;
    color-scheme: dark;
    /* Quiet scrollbars (inherited by every scroller; overlay scrollbars on phones and macOS ignore it). The thumb
       keeps the 3:1 of controls. */
    scrollbar-color: var(--color-border-control) transparent;
  }
  html {
    min-height: 100%;
    background-color: var(--bg-color);
    /* Anchored targets (#song-…) stay clear of the edges and of the fixed player. */
    scroll-padding-top: 1rem;
    scroll-padding-bottom: calc(var(--player-height, 0px) + 1rem);
    /* Classic scrollbars: the page doesn't jump sideways between pages that scroll and pages that don't. */
    scrollbar-gutter: stable;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    /* Pressed states are styled; the grey flash on tap would only cover them (focus rings are unaffected). */
    -webkit-tap-highlight-color: transparent;
  }
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
    margin: 0;
    color: var(--color-text);
    background-color: var(--bg-color);
    font-family: var(--font-body);
    /* Light text on dark surfaces: macOS's subpixel smoothing makes it look heavier than it is. */
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  /* Reserve room for the fixed player so it never covers the last rows or the footer (5rem until it has measured
     itself). */
  body:has(> .player:not([hidden])) {
    padding-bottom: calc(var(--player-height, 5rem) + 1rem);
  }

  /* Base element defaults. Zero specificity (:where), so any component rule wins. */
  :where(h1, h2, h3, h4, h5, h6) {
    text-wrap: balance;
  }
  :where(img) {
    max-width: 100%;
    height: auto;
  }
  /* No double-tap zoom on controls (a quick second tap on Next would zoom the page); pinch zoom still works. */
  :where(a, button, input, select, textarea, label, summary, [role='button']) {
    touch-action: manipulation;
  }
  /* `hidden` hides, whatever display a component gives the element. */
  [hidden]:not([hidden='until-found']) {
    display: none !important;
  }
  ::selection {
    color: var(--color-text);
    background: var(--selection-color, rgb(255 255 255 / 28%));
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    border: 0;
    white-space: nowrap;
  }

  /* Visible keyboard focus everywhere; components may replace it with an equally visible ring of their own. */
  :focus-visible {
    outline: 2px solid var(--focus-ring-color);
    outline-offset: 2px;
  }
  /* Forced colors (e.g. Windows High Contrast) drop box-shadows and custom colors: keep a system-colored outline. */
  @media (forced-colors: active) {
    :focus-visible {
      outline: 2px solid Highlight !important;
      outline-offset: 2px !important;
    }
  }

  /* Page navigations (ClientRouter): a shorter cross-fade than the browser's 250 ms; the page can't be clicked while
     it runs. */
  ::view-transition-group(root) {
    animation-duration: var(--duration-base);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>
